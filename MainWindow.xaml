<Window x:Class="XinSpect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XinSpect"
        Title="曦覽 XinSpect" Height="820" Width="1220"
        Icon="pack://application:,,,/Assets/app.ico"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource PagePlaneBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 標題列 ===== -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderGradientBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="30" CornerRadius="4" Background="{DynamicResource AccentGradientBrush}"
                            Margin="0,0,15,0">
                        <Border.Effect>
                            <DropShadowEffect x:Name="AccentGlow" BlurRadius="14" ShadowDepth="0" Opacity="0.7" Color="#3987e5"/>
                        </Border.Effect>
                    </Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="{Binding AppTitle}"/>
                        <TextBlock Style="{StaticResource Subtitle}" Text="{Binding AppSubtitle}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PaletteButton" Style="{StaticResource ToolButton}" Click="Palette_Click"
                            VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="命令面板（Ctrl+K）：搜尋任何頁面、工具與動作">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                <Path Fill="{DynamicResource PrimaryInkBrush}"
                                      Data="F1 M10,2 a8,8 0 1,0 4.9,14.3 l5.4,5.4 1.4,-1.4 -5.4,-5.4 A8,8 0 0 0 10,2 Z M10,4 a6,6 0 1,1 0,12 a6,6 0 0 1 0,-12 Z"/>
                            </Viewbox>
                            <TextBlock Text="搜尋" Foreground="{DynamicResource PrimaryInkBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Ctrl+K" Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center"
                                       FontSize="11" Margin="8,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MiniButton" Style="{StaticResource ToolButton}" Click="Mini_Click"
                            VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="切換迷你浮動監視器">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                <Path Fill="{DynamicResource PrimaryInkBrush}"
                                      Data="F1 M3,4 H21 A1,1 0 0 1 22,5 V17 A1,1 0 0 1 21,18 H3 A1,1 0 0 1 2,17 V5 A1,1 0 0 1 3,4 Z M4,6 H20 V16 H4 Z M13,11 H19 V15 H13 Z"/>
                            </Viewbox>
                            <TextBlock Text="迷你" Foreground="{DynamicResource PrimaryInkBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" Click="Export_Click"
                            VerticalAlignment="Center" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                <Path Fill="{DynamicResource PrimaryInkBrush}"
                                      Data="F1 M11,2 H5 A2,2 0 0 0 3,4 V20 A2,2 0 0 0 5,22 H19 A2,2 0 0 0 21,20 V9 L14,2 Z M13,3.5 L19.5,10 H13 Z M11.5,12 H12.5 V16 L14.2,14.3 L14.9,15 L12,17.9 L9.1,15 L9.8,14.3 L11.5,16 Z"/>
                            </Viewbox>
                            <TextBlock Text="匯出報告" Foreground="{DynamicResource PrimaryInkBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ComboBox Style="{StaticResource DarkCombo}" Width="184" VerticalAlignment="Center"
                              Margin="0,0,18,0" ToolTip="切換日期紀年方式"
                              ItemsSource="{Binding EraNames}" SelectedIndex="{Binding EraIndex, Mode=TwoWay}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Clock}"
                                   HorizontalAlignment="Right" FontSize="14"/>
                        <TextBlock Style="{StaticResource Subtitle}" Text="{Binding System.HostName}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ===== 主體：導覽 + 內容 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 側邊欄：ItemsSource 來自 PageRegistry（宣告式註冊表），依 Group 自動分組。
                 1.x 的 210 行手寫 ListBoxItem ↔ _views[] 索引平行對應已完全移除。 -->
            <Border Grid.Column="0" Background="{DynamicResource PagePlaneBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                <ListBox x:Name="Nav" Style="{StaticResource NavList}" Margin="0,6,0,12"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PageDef}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Hint}">
                                <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="{Binding Icon}"/>
                                </Viewbox>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NavGroupHeader}" Text="{Binding Name}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </Border>

            <ContentControl x:Name="Host" Grid.Column="1" Margin="24,20,20,8"/>

            <!-- 硬體警示橫幅：任一感測值超過使用者閾值時浮現於內容區頂端 -->
            <Border Grid.Column="1" VerticalAlignment="Top" Margin="24,20,20,0"
                    CornerRadius="8" Background="#B3202020" BorderBrush="#E0552E" BorderThickness="1"
                    Panel.ZIndex="50"
                    Visibility="{Binding Alerts.AnyActive, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.5" Color="#E0552E"/>
                </Border.Effect>
                <TextBlock Text="{Binding Alerts.BannerText}" Foreground="#FFE3D8" Margin="16,10"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- ===== 狀態列 ===== -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,8">
                <TextBlock Style="{StaticResource Subtitle}" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Subtitle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="曦覽 XinSpect ・ By Xinglanclever"/>
            </Grid>
        </Border>

        <!-- ===== 命令面板（Ctrl+K）：覆蓋全窗，未開啟時完全不佔用版面 ===== -->
        <local:CommandPalette x:Name="Palette" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100"
                              Visibility="Collapsed"/>
    </Grid>
</Window>
