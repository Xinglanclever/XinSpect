<Window x:Class="XinSpect.ShrineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拜神" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height"
        Width="600" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True">
    <Window.Resources>
        <!-- 「拜」主鈕：乖乖綠；「收起」次鈕沿用站的次要色 -->
        <Style x:Key="ShrinePrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#5C9424"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#6FAE2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShrineSecondary" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="28,24,28,22" Background="Transparent">
            <!-- ── 標題：可拖曳 ─────────────────────────────── -->
            <Grid MouseLeftButtonDown="Header_Drag">
                <StackPanel Orientation="Horizontal">
                    <Border Width="6" Height="26" CornerRadius="3" Background="#5C9424" Margin="0,0,12,0"/>
                    <TextBlock Text="拜神" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                    <Border Background="#22552222" CornerRadius="5" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="民俗信仰 ・ 工程師幽默 ・ 娛樂功能" FontSize="11"
                                   Foreground="{DynamicResource SecondaryInkBrush}"/>
                    </Border>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="收起">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource SecondaryInkBrush}"
                          StrokeThickness="1.6" Width="10" Height="10"/>
                </Button>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 左：一包綠色乖乖（原創向量，非任何品牌包裝）＋神桌＋香爐 ── -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Canvas Width="205" Height="268">
                        <!-- 香的煙：預設隱形，按「拜」才飄起 -->
                        <Ellipse x:Name="Smoke1" Canvas.Left="86" Canvas.Top="196" Width="9" Height="9"
                                 Fill="#C8C8C8" Opacity="0">
                            <Ellipse.RenderTransform><TranslateTransform X="0" Y="0"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Smoke2" Canvas.Left="99" Canvas.Top="188" Width="7" Height="7"
                                 Fill="#C8C8C8" Opacity="0">
                            <Ellipse.RenderTransform><TranslateTransform X="0" Y="0"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Smoke3" Canvas.Left="77" Canvas.Top="192" Width="6" Height="6"
                                 Fill="#C8C8C8" Opacity="0">
                            <Ellipse.RenderTransform><TranslateTransform X="0" Y="0"/></Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- 香爐與三炷香（在神桌上、乖乖前） -->
                        <Path Fill="#8B5A2B" Data="M86,222 L87,200 L88.5,200 L89.5,222 Z M95,222 L96,198 L97.5,198 L98.5,222 Z M104,222 L105,200 L106.5,200 L107.5,222 Z"/>
                        <Ellipse Canvas.Left="82" Canvas.Top="195" Width="6" Height="4" Fill="#E0552E"/>
                        <Ellipse Canvas.Left="94" Canvas.Top="193" Width="6" Height="4" Fill="#E0552E"/>
                        <Ellipse Canvas.Left="104" Canvas.Top="195" Width="6" Height="4" Fill="#E0552E"/>
                        <Path Fill="#3A3F45" Data="M72,222 h48 a3,3 0 0 1 3,3 v3 a27,10 0 0 1 -54,0 v-3 a3,3 0 0 1 3,-3 Z"/>

                        <!-- 乖乖本體：綠色包裝（原創畫法） -->
                        <Path Data="M30,34 h130 a10,10 0 0 1 10,10 v160 a10,10 0 0 1 -10,10 h-130 a10,10 0 0 1 -10,-10 v-160 a10,10 0 0 1 10,-10 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8CC63F" Offset="0"/>
                                    <GradientStop Color="#6AA32B" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <!-- 封口壓紋 -->
                        <Path Fill="#5C9424" Data="M20,38 L30,20 40,38 50,20 60,38 70,20 80,38 90,20 100,38 110,20 120,38 130,20 140,38 150,20 160,38 170,20 170,44 v2 H20 Z"/>
                        <!-- 反光 -->
                        <Rectangle Canvas.Left="36" Canvas.Top="52" Width="10" Height="150" RadiusX="5" RadiusY="5">
                            <Rectangle.Fill>#33FFFFFF</Rectangle.Fill>
                            <Rectangle.RenderTransform><RotateTransform Angle="8"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <!-- 白底字牌：兩個「乖」直排 -->
                        <Border Canvas.Left="66" Canvas.Top="70" Width="58" Height="118" CornerRadius="12" Background="#F4FBEC"
                                BorderBrush="#D8ECC4" BorderThickness="1.5">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="乖" FontSize="42" FontWeight="Bold" Foreground="#3E7A18" HorizontalAlignment="Center"/>
                                <TextBlock Text="乖" FontSize="42" FontWeight="Bold" Foreground="#3E7A18" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Canvas.Left="0" Canvas.Top="196" Width="170" TextAlignment="Center"
                                   Text="護機版 ・ 請勿食用" FontSize="10.5" Foreground="#EAF5DC"/>

                        <!-- 神桌 -->
                        <Rectangle Canvas.Left="8" Canvas.Top="238" Width="184" Height="12" RadiusX="4" RadiusY="4" Fill="#7A5230"/>
                        <Rectangle Canvas.Left="8" Canvas.Top="238" Width="184" Height="4" RadiusX="2" RadiusY="2" Fill="#8A5F38"/>
                        <Rectangle Canvas.Left="22" Canvas.Top="250" Width="12" Height="14" Fill="#6B4A2B"/>
                        <Rectangle Canvas.Left="166" Canvas.Top="250" Width="12" Height="14" Fill="#6B4A2B"/>
                    </Canvas>
                </StackPanel>

                <!-- ── 右：乖度（演算法是玩笑，數據是真的）＋誠實版守則 ── -->
                <StackPanel Grid.Column="1" Margin="22,0,0,0">
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2" Padding="16,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="乖度" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                                <Border Background="#335C9424" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="娛樂指標 ・ 數據是真的" FontSize="10.5" Foreground="#3E7A18"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <TextBlock x:Name="ScoreText" FontSize="42" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                                <TextBlock x:Name="VerdictText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                           Margin="10,0,0,7" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="DetailText" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,10,0,8"/>
                            <TextBlock Text="演算法是玩笑；藍屏筆數與開機時長是真的。讀不到的項目顯示「—」，不猜。"
                                       FontSize="11" TextWrapping="Wrap" LineHeight="17"
                                       Foreground="{DynamicResource MutedInkBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" CornerRadius="10"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2"
                            Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="誠實版使用守則" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource PrimaryInkBrush}"/>
                            <TextBlock Text="一、一定要綠色——黃色紅色是給人吃的，綠色才管機器。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="二、不可以拆來吃——開封即失效，這是鐵律。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="三、有效期限要檢查——民俗說法是過期會讓機器鬧脾氣（非本程式量測結論）。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="四、要立在機殼上——放抽屜裡的神明管不到主機板。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="五、拜神不提供保固——機器乖不乖，還是看左邊的感測與量測頁。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ── 祈福語：按「拜」後浮現 ─────────────────────── -->
            <Border x:Name="BlessingCard" Background="#225C9424" CornerRadius="9" Padding="14,9"
                    Margin="0,16,0,0" Opacity="0" Visibility="Collapsed">
                <TextBlock x:Name="BlessingText" TextAlignment="Center" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#3E7A18" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PrayButton" Grid.Column="0" Style="{StaticResource ShrinePrimary}" HorizontalContentAlignment="Center" Click="Pray_Click">
                    <TextBlock Text="拜" FontSize="14" FontWeight="Bold"/>
                </Button>
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource ShrineSecondary}" HorizontalContentAlignment="Center" Click="Close_Click">
                    <TextBlock Text="收起" FontSize="13"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>