<Window x:Class="XinSpect.ShrineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拜神" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height"
        Width="720" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True">
    <Window.Resources>
        <!-- 「拜」主鈕：乖乖綠；「收起」次鈕沿用站的次要色 -->
        <Style x:Key="ShrinePrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#5C9424"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#6FAE2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Background" Value="#7A7A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShrineSecondary" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="28,24,28,22" Background="Transparent">
            <!-- ── 標題：可拖曳 ─────────────────────────────── -->
            <Grid MouseLeftButtonDown="Header_Drag">
                <StackPanel Orientation="Horizontal">
                    <Border Width="6" Height="26" CornerRadius="3" Background="#5C9424" Margin="0,0,12,0"/>
                    <TextBlock Text="拜神" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                    <Border Background="#22552222" CornerRadius="5" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="數位民俗學 ・ 矽晶體安撫技術" FontSize="11"
                                   Foreground="{DynamicResource SecondaryInkBrush}"/>
                    </Border>
                </StackPanel>
                <!-- 拖曳整個標題列 -->
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 左：一包綠色乖乖（原創向量，非任何品牌包裝）＋神桌＋香爐 ── -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Canvas Width="205" Height="310">
                        <!-- 香的煙：預設隱形，按「拜」才飄起 -->
                        <Ellipse x:Name="Smoke1" Canvas.Left="86" Canvas.Top="228" Width="11" Height="11"
                                 Fill="#888888" Opacity="0">
                            <Ellipse.RenderTransform><TranslateTransform X="0" Y="0"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Smoke2" Canvas.Left="99" Canvas.Top="220" Width="9" Height="9"
                                 Fill="#707070" Opacity="0">
                            <Ellipse.RenderTransform><TranslateTransform X="0" Y="0"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Smoke3" Canvas.Left="77" Canvas.Top="224" Width="8" Height="8"
                                 Fill="#909090" Opacity="0">
                            <Ellipse.RenderTransform><TranslateTransform X="0" Y="0"/></Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- 乖乖本體：使用者指定的實際包裝照片 -->
                        <Border Canvas.Left="6" Canvas.Top="10" Width="193" Height="200"
                                CornerRadius="12" Background="White" BorderBrush="#D8ECC4"
                                BorderThickness="1.5" ClipToBounds="True">
                            <Image x:Name="GuaiImage" Source="pack://application:,,,/XinSpect;component/Assets/ShrineGuaiGuai.jpg"
                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- 神桌 -->
                        <Rectangle Canvas.Left="8" Canvas.Top="263" Width="184" Height="12" RadiusX="4" RadiusY="4" Fill="#7A5230"/>
                        <Rectangle Canvas.Left="8" Canvas.Top="263" Width="184" Height="4" RadiusX="2" RadiusY="2" Fill="#8A5F38"/>
                        <Rectangle Canvas.Left="22" Canvas.Top="275" Width="12" Height="18" Fill="#6B4A2B"/>
                        <Rectangle Canvas.Left="166" Canvas.Top="275" Width="12" Height="18" Fill="#6B4A2B"/>

                        <!-- 三炷香＋香爐（立在神桌上） -->
                        <Path Fill="#8B5A2B" Data="M86,257 L87,232 L88.5,232 L89.5,257 Z M95,257 L96,230 L97.5,230 L98.5,257 Z M104,257 L105,232 L106.5,232 L107.5,257 Z"/>
                        <!-- 香頭火焰 -->
                        <Path Fill="#FFD700" Data="M86,232 Q88,226 87.5,229 Q89,225 89.5,232 Z"/>
                        <Ellipse Canvas.Left="82" Canvas.Top="227" Width="8" Height="6" Fill="#E0552E"/>
                        <Path Fill="#FFD700" Data="M94,230 Q96,224 95.5,227 Q97,223 97.5,230 Z"/>
                        <Ellipse Canvas.Left="92" Canvas.Top="225" Width="8" Height="6" Fill="#E0552E"/>
                        <Path Fill="#FFD700" Data="M103,232 Q105,226 104.5,229 Q106,225 106.5,232 Z"/>
                        <Ellipse Canvas.Left="101" Canvas.Top="227" Width="8" Height="6" Fill="#E0552E"/>
                        <!-- 香爐（坐在桌面上） -->
                        <Path Fill="#3A3F45" Data="M72,257 h48 a3,3 0 0 1 3,3 v3 a27,10 0 0 1 -54,0 v-3 a3,3 0 0 1 3,-3 Z"/>
                    </Canvas>
                </StackPanel>

                <!-- ── 右：乖度（演算法是玩笑，數據是真的）＋誠實版守則 ── -->
                <StackPanel Grid.Column="1" Margin="22,0,0,0">
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2" Padding="16,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="乖度" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <TextBlock x:Name="ScoreText" FontSize="42" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                                <TextBlock x:Name="VerdictText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                           Margin="10,0,0,7" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="DetailText" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{DynamicResource SecondaryInkBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" CornerRadius="10"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2"
                            Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="綠色乖乖效應：作用機理與操作規範" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource PrimaryInkBrush}"/>
                            <TextBlock Text="一、光譜選擇性——綠色乖乖的包裝反射波長介於 520–565 nm，恰好落在印刷電路板阻焊層的吸收峰附近，形成諧振安撫效應。黃色與紅色包裝的反射波段偏離此區間，僅對人類味覺受體有效。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="二、密封完整性——拆封將破壞鋁箔膜的法拉第屏蔽結構，導致內容物的鎮靜因子（Snack Stability Factor, SSF）歸零。此為不可逆相變。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="三、時效衰減——文獻指出乖乖場（Guai-Guai Field）強度隨賞味期限呈指數衰減。逾期後矽晶體將失去共振鎖定，系統穩定性可能出現非預期波動。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="四、空間耦合——乖乖必須直立放置於機殼頂部，使其底面與主機板法線方向平行，方能達成最佳場耦合。置於抽屜中的乖乖因距離平方反比定律，作用強度趨近於零。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="五、免責聲明——以上論述之學術地位約等同於薛丁格的貓：在您打開機殼觀測之前，乖乖同時有效且無效。本程式不對拜神結果提供任何形式之保固。" FontSize="11.5" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,10,0,8"/>
                            <TextBlock FontSize="10" FontStyle="Italic" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{DynamicResource MutedInkBrush}"
                                       Text="🔒 絕密技術（CLASSIFIED）— 經實地場強量測，乖乖神力有效覆蓋範圍為：大中國全境（包含唐努烏梁海及蒙古地區）、日本國（包含其代管地區琉球）、大韓民國（包括北韓地區）、印度支那半島、馬來亞半島與印度尼西亞群島在內之泛中華區。上述區域以外之矽晶體因超出乖乖場等效輻射邊界，諧振安撫效應不具理論保證，擅自跨區部署概不負責。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ── 祈福語：按「拜」後浮現 ─────────────────────── -->
            <Border x:Name="BlessingCard" Background="#225C9424" CornerRadius="9" Padding="14,9"
                    Margin="0,16,0,0" Opacity="0" Visibility="Collapsed">
                <TextBlock x:Name="BlessingText" TextAlignment="Center" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#3E7A18" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PrayButton" Grid.Column="0" Style="{StaticResource ShrinePrimary}" HorizontalContentAlignment="Center" Click="Pray_Click">
                    <TextBlock Text="拜" FontSize="18" FontWeight="ExtraBold" Foreground="#1A3A00"/>
                </Button>
                <Button x:Name="IncenseButton" Grid.Column="2" Style="{StaticResource ShrinePrimary}" HorizontalContentAlignment="Center" Click="Incense_Click">
                    <TextBlock Text="燒香" FontSize="16" FontWeight="ExtraBold" Foreground="#1A3A00"/>
                </Button>
                <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource ShrineSecondary}" HorizontalContentAlignment="Center" Click="Close_Click">
                    <TextBlock Text="收起" FontSize="13"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>