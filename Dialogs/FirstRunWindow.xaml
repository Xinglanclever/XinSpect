<Window x:Class="XinSpect.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XinSpect"
        Title="歡迎使用曦覽"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height"
        Width="580" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True">
    <Window.Resources>
        <!-- 兩個版本各一顆大鈕：標題 + 一行說明，點下去就是選擇，不必再按確定 -->
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="28,26,28,22" Background="Transparent" MouseLeftButtonDown="Header_Drag">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="6" Height="26" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="要看到多少東西？" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryInkBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" LineHeight="23" FontSize="13.5" Margin="0,0,0,18"
                       Foreground="{DynamicResource SecondaryInkBrush}"
                       Text="曦覽一路長到四十幾頁，其中不少是給懂的人看的——直讀 MSR、編程效能計數器、解 PCI 設定空間。先選一個起點就好，這個選擇之後隨時能改，而且不論選哪一個，功能都不會被停用。"/>

            <Button x:Name="BtnSimple" Style="{StaticResource ChoiceCard}" Margin="0,0,0,10" Click="Simple_Click">
                <StackPanel>
                    <TextBlock Text="簡略" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,4,0,0" LineHeight="18"
                               Text="側邊欄只列一般會用到的頁面：總覽、處理器、記憶體、主機板、顯示卡、儲存、網路、感測器、健康、報告…（約 20 頁）。想知道「我這台是什麼配備、健不健康」選這個。"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnAdvanced" Style="{StaticResource ChoiceCard}" Click="Advanced_Click">
                <StackPanel>
                    <TextBlock Text="詳細進階" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,4,0,0" LineHeight="18"
                               Text="全部頁面都列出來，包含硬核唯讀量測（效能天花板、Top-down 管線歸因、頻率真相、平台可信度、記憶體真實面貌、核心到核心延遲、PCIe／USB 鏈路、NVMe 電源狀態、DPC 延遲）與超頻模組。"/>
                </StackPanel>
            </Button>

            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,18,0,12"/>

            <!-- 「之後去哪裡改」寫在下方：這是使用者選錯之後唯一會想找的資訊 -->
            <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="12"
                       Foreground="{DynamicResource MutedInkBrush}"
                       Text="之後想換版本：設定 › 外觀 › 簡易模式，勾起來就是「簡略」，取消就是「詳細進階」，即時生效不必重開程式。另外，被收起來的頁面只是不列在側邊欄——隨時按 Ctrl+K 開命令面板，打名字照樣搜得到、打得開。"/>
        </StackPanel>
    </Border>
</Window>
