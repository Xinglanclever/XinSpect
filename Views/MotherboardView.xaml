<UserControl x:Class="XinSpect.MotherboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <local:SectionHead Text="主機板" HelpKey="mainboard/主機板"/>

            <!-- 品牌徽章 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="0">
                <local:BrandBadge Kind="Board" EmblemSize="54"
                                  Brand="{Binding Mainboard.Brand}" Model="{Binding Mainboard.Model}"/>
            </Border>

            <Grid local:Anim.RevealDelay="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 主機板 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <local:SectionHead Text="主機板" HelpKey="mainboard/主機板#2"/>
                        <local:FieldRow Label="製造商" Value="{Binding Mainboard.Vendor}"/>
                        <local:FieldRow Label="型號" Value="{Binding Mainboard.Model}"/>
                        <local:FieldRow Label="匯流排規格" Value="{Binding Mainboard.BusSpec}"/>
                        <local:FieldRow Label="繪圖介面" Value="{Binding Mainboard.GraphicInterface}"/>
                        <local:FieldRow Label="PCIe 連結寬度" Value="{Binding Mainboard.PcieLinkWidth}"/>
                        <local:FieldRow Label="PCIe 連結速度" Value="{Binding Mainboard.PcieLinkSpeed}"/>
                    </StackPanel>
                </Border>

                <!-- BIOS / UEFI -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <local:SectionHead Text="BIOS / UEFI" HelpKey="mainboard/BIOS / UEFI"/>
                        <local:FieldRow Label="模式" Value="{Binding Mainboard.Uefi}"/>
                        <local:FieldRow Label="BIOS 品牌" Value="{Binding Mainboard.BiosVendor}"/>
                        <local:FieldRow Label="版本 (CPU-Z)" Value="{Binding Mainboard.BiosMsg}"/>
                        <local:FieldRow Label="BIOS 版本 (SMBIOS)" Value="{Binding System.BiosVersion}"/>
                        <local:FieldRow Label="日期" Value="{Binding Mainboard.BiosDate}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 系統資訊 (WMI) -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="100">
                <StackPanel>
                    <local:SectionHead Text="系統資訊" HelpKey="mainboard/系統資訊"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <local:FieldRow Label="系統製造商" Value="{Binding System.SystemManufacturer}"/>
                            <local:FieldRow Label="系統型號" Value="{Binding System.SystemModel}"/>
                            <local:FieldRow Label="系統類型" Value="{Binding System.SystemType}"/>
                            <local:FieldRow Label="產品序號 (SKU)" Value="{Binding System.SystemSku}"/>
                            <local:FieldRow Label="系統 UUID" Value="{Binding System.SystemUuid}"/>
                            <local:FieldRow Label="邏輯處理器數" Value="{Binding System.LogicalProcessors}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <local:FieldRow Label="主機板廠商" Value="{Binding System.BoardVendor}"/>
                            <local:FieldRow Label="主機板型號" Value="{Binding System.BoardModel}"/>
                            <local:FieldRow Label="主機板版本" Value="{Binding System.BoardVersion}"/>
                            <local:FieldRow Label="主機板序號" Value="{Binding System.BoardSerial}"/>
                            <local:FieldRow Label="BIOS 廠商" Value="{Binding System.BiosVendor}"/>
                            <local:FieldRow Label="BIOS 日期" Value="{Binding System.BiosDate}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0" local:Anim.RevealDelay="120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 晶片組 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <local:SectionHead Text="晶片組" HelpKey="mainboard/晶片組"/>
                        <local:FieldRow Label="晶片組型號" Value="{Binding Mainboard.ChipsetName}"/>
                        <local:FieldRow Label="北橋 / SoC" Value="{Binding Mainboard.Northbridge}"/>
                        <local:FieldRow Label="南橋 / PCH" Value="{Binding Mainboard.Southbridge}"/>
                        <local:FieldRow Label="記憶體類型" Value="{Binding Mainboard.MemoryType}"/>
                        <local:FieldRow Label="記憶體容量" Value="{Binding Mainboard.MemorySize}"/>
                        <local:FieldRow Label="通道" Value="{Binding Mainboard.Channels}"/>
                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,8"
                                Visibility="{Binding Mainboard.HasChipsetFeatures, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource Subtitle}" TextWrapping="Wrap"
                                   Text="{Binding Mainboard.ChipsetFeatures}"
                                   Visibility="{Binding Mainboard.HasChipsetFeatures, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- LPCIO / 感測晶片 -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <local:SectionHead Text="LPCIO（超級 I/O）" HelpKey="mainboard/LPCIO（超級 I/O）"/>
                        <local:FieldRow Label="製造商" Value="{Binding Mainboard.LpcioVendor}"/>
                        <local:FieldRow Label="型號" Value="{Binding Mainboard.LpcioModel}"/>
                        <TextBlock Style="{StaticResource Subtitle}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="LPCIO（Super I/O）晶片負責風扇轉速、電壓與溫度感測；其型號決定可讀取的感測通道。"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 音效裝置 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="160"
                    Visibility="{Binding HasSoundDevices, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="音效裝置" HelpKey="mainboard/音效裝置"/>
                    <ItemsControl ItemsSource="{Binding SoundDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" Margin="2,0,10,0"/>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,14,0,0" TextWrapping="Wrap"
                       Text="主機板深度規格由背景 CPU-Z 報告解析（約開機後 10 餘秒）；製造商與型號另以 WMI 補入。若部分欄位為「—」，表示該平台未提供或報告尚在讀取。"/>

            <!-- ===== SMBIOS 原始表 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <local:SectionHead Text="SMBIOS 原始表" HelpKey="mainboard/SMBIOS 原始表"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="直接解析韌體的 SMBIOS 表（位移核對 dmidecode 3.x）。沒填的欄位顯示「—」；不認得的列舉值顯示原始位元組，不硬掰。"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Smbios.VersionText, StringFormat=表版本：{0}}"/>
                    <ItemsControl ItemsSource="{Binding Smbios.Bios}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Smbios.System}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Smbios.Board}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Smbios.Processor}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4"
                               Text="{Binding Smbios.Slots.Count, Mode=OneWay, StringFormat=系統插槽（{0} 個）}"/>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="插槽"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="類型"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="寬度"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="狀態"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Smbios.Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Designation}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Type}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding Width}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding Usage}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- ===== 韌體與開機信任鏈 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="韌體與開機信任鏈" HelpKey="mainboard/韌體與開機信任鏈"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="讀取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="FirmwareRefresh_Click" IsEnabled="{Binding Firmware.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="UEFI 變數直讀 Secure Boot 四態與開機項目數、Hypervisor 簽章（VBS 開啟時 MSR／計時可信度會變，必須明說）、微碼修訂版。全部唯讀。"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Secure Boot"/>
                    <ItemsControl ItemsSource="{Binding Firmware.SecureBoot}" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Firmware.Boot}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="虛擬化（可信度聲明）"/>
                    <ItemsControl ItemsSource="{Binding Firmware.Virtualization}" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="微碼"/>
                    <ItemsControl ItemsSource="{Binding Firmware.Microcode}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Firmware.Status}"/>
                </StackPanel>
            </Border>
            <!-- ===== BIOS／Intel ME 韌體與微碼 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="BIOS／Intel ME 韌體與微碼" HelpKey="mainboard/BIOS／Intel ME 韌體與微碼"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="讀取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="BiosMeRefresh_Click" IsEnabled="{Binding BiosMe.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="BIOS 版本與日期、Intel ME 韌體版本（以 MEI 介面發 MKHI GET_FW_VERSION 直接問 ME 本身，不是報驅動版本）、微碼的「目前生效 vs Windows 自帶」對照。全部唯讀。"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="BIOS"/>
                    <ItemsControl ItemsSource="{Binding BiosMe.Bios}" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Key}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Intel ME／CSME"/>
                    <ItemsControl ItemsSource="{Binding BiosMe.Me}" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Key}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="微碼"/>
                    <ItemsControl ItemsSource="{Binding BiosMe.Microcode}" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Key}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding BiosMe.Status}"/>
                </StackPanel>
            </Border>

            <!-- ===== 危險區：修改 BIOS 設定／刷寫韌體 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="#B3462B" BorderThickness="1">
                <StackPanel>
                    <local:SectionHead Text="危險區：修改 BIOS 設定／刷寫韌體" HelpKey="mainboard/危險區：修改 BIOS 設定／刷寫韌體" Foreground="#E06C4B"/>
                    <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                               Foreground="#E06C4B" Text="{Binding BiosMe.DangerNotice}"/>
                    <CheckBox Margin="0,0,0,10" Foreground="{StaticResource PrimaryInkBrush}"
                              IsChecked="{Binding BiosMe.RiskAccepted, Mode=TwoWay}"
                              Content="我了解：寫壞 BIOS／ME 會讓主機板無法開機，且曦覽不會、也不能替我救回來。"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Content="重開機進入 UEFI 設定"
                                Click="RebootToFirmware_Click" IsEnabled="{Binding BiosMe.CanActDangerously}"/>
                        <Button Style="{StaticResource ToolButton}" Margin="0,0,8,8" Content="開啟主機板廠官方 BIOS 下載頁"
                                Click="OpenVendorBios_Click" IsEnabled="{Binding BiosMe.HasVendorUrl}"/>
                        <Button Style="{StaticResource ToolButton}" Margin="0,0,8,8" Content="Intel CSME 版本偵測工具（唯讀）"
                                Click="OpenMeTool_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Subtitle}" TextWrapping="Wrap" Text="{Binding BiosMe.ActionStatus}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
