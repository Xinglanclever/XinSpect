<UserControl x:Class="XinSpect.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 左側工具子導覽項目樣式 -->
        <Style x:Key="UtilNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryInkBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryInkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：工具子導覽 -->
        <Border Grid.Column="0" Width="200" Style="{StaticResource Card}" Padding="8" Margin="0,0,14,4"
                VerticalAlignment="Stretch">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="6,4,0,8" Text="實用工具"/>
                <ListBox x:Name="SubNav" Background="Transparent" BorderThickness="0"
                         SelectionChanged="SubNav_SelectionChanged"
                         ItemContainerStyle="{StaticResource UtilNavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M2,3 h12 a1,1 0 0 1 1,1 v3 h-14 v-3 a1,1 0 0 1 1,-1 z M1,9 h14 v3 a1,1 0 0 1 -1,1 h-12 a1,1 0 0 1 -1,-1 z M4,5.5 h1 v0.01 h-1 z M4,10.5 h1 v0.01 h-1 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="連接埠占用" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M2,2 h12 v3 h-12 z M2,6.5 h12 v3 h-12 z M2,11 h12 v3 h-12 z M4,3 h1 v0.01 h-1 z M4,7.5 h1 v0.01 h-1 z M4,12 h1 v0.01 h-1 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Hosts 編輯器" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M8,1 L15,14 H1 Z M7.2,6 h1.6 v4 h-1.6 z M7.2,11 h1.6 v1.6 h-1.6 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="藍屏分析" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M3,2 h10 l-1,3 h-8 z M4,6 h8 v7 a1,1 0 0 1 -1,1 h-6 a1,1 0 0 1 -1,-1 z M6.5,8 h1 v4 h-1 z M8.5,8 h1 v4 h-1 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="垃圾清理" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M1,4 h12 a1,1 0 0 1 1,1 v6 a1,1 0 0 1 -1,1 h-12 a1,1 0 0 1 -1,-1 v-6 a1,1 0 0 1 1,-1 z M15,6 h1 v4 h-1 z M2,5.5 h6 v5 h-6 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="電池分析" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M3,1.5 L3,13 L6,10 L8,14.5 L10,13.5 L8,9 L12.5,9 Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="右鍵選單" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M8,1 a7,7 0 1 0 0.01,0 z M8,3 a5,5 0 1 1 -0.01,0 z M8,5 a3,3 0 1 0 0.01,0 z M7.3,7.3 h1.4 v1.4 h-1.4 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="網速測試" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M2,3 h12 a1,1 0 0 1 1,1 v8 a1,1 0 0 1 -1,1 h-12 a1,1 0 0 1 -1,-1 v-8 a1,1 0 0 1 1,-1 z M4,5.5 h1.4 v5 h-1.4 z M6.6,5.5 h1.4 v5 h-1.4 z M9.2,5.5 h1.4 v5 h-1.4 z M11.8,5.5 h1.4 v5 h-1.4 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="記憶體整理" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M8,0.5 a1.6,1.6 0 0 1 1.6,1.6 v0.9 a5.5,5.5 0 0 1 1.5,0.9 l0.8,-0.45 a1.6,1.6 0 0 1 1.6,2.77 l-0.8,0.45 a5.5,5.5 0 0 1 0,1.76 l0.8,0.45 a1.6,1.6 0 0 1 -1.6,2.77 l-0.8,-0.45 a5.5,5.5 0 0 1 -1.5,0.9 v0.9 a1.6,1.6 0 0 1 -3.2,0 v-0.9 a5.5,5.5 0 0 1 -1.5,-0.9 l-0.8,0.45 a1.6,1.6 0 0 1 -1.6,-2.77 l0.8,-0.45 a5.5,5.5 0 0 1 0,-1.76 l-0.8,-0.45 a1.6,1.6 0 0 1 1.6,-2.77 l0.8,0.45 a5.5,5.5 0 0 1 1.5,-0.9 v-0.9 a1.6,1.6 0 0 1 1.6,-1.6 z M8,5 a3,3 0 1 0 0.01,0 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="開機啟動項" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M8,1 a7,7 0 1 0 0.01,0 z M8,2.4 c1.2,0 2.6,2 2.8,5.1 h-5.6 c0.2,-3.1 1.6,-5.1 2.8,-5.1 z M2.5,7.5 h2.9 c0.05,-1.7 0.4,-3.2 0.95,-4.3 a5.6,5.6 0 0 0 -3.85,4.3 z M10.6,3.2 c0.55,1.1 0.9,2.6 0.95,4.3 h2.9 a5.6,5.6 0 0 0 -3.85,-4.3 z M5.2,8.5 h5.6 c-0.2,3.1 -1.6,5.1 -2.8,5.1 c-1.2,0 -2.6,-2 -2.8,-5.1 z M2.5,8.5 a5.6,5.6 0 0 0 3.85,4.3 c-0.55,-1.1 -0.9,-2.6 -0.95,-4.3 h-2.9 z M10.65,8.5 c-0.05,1.7 -0.4,3.2 -0.95,4.3 a5.6,5.6 0 0 0 3.85,-4.3 h-2.9 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="DNS 切換" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M2,2 h7 l3,3 v9 a1,1 0 0 1 -1,1 h-9 a1,1 0 0 1 -1,-1 v-11 a1,1 0 0 1 1,-1 z M9,2 v3 h3 z M4.5,7.5 h5 v1.2 h-5 z M4.5,9.8 h5 v1.2 h-5 z M4.5,12.1 h3.2 v1.2 h-3.2 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="大檔掃描" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Data="M2,13 h3 v-6 h-3 z M6.5,13 h3 v-11 h-3 z M11,13 h3 v-4 h-3 z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="效能天梯" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 右：所選工具 -->
        <ContentControl x:Name="ToolHost" Grid.Column="1"/>
    </Grid>
</UserControl>
