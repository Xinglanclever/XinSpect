<UserControl x:Class="XinSpect.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 左側工具子導覽項目樣式 -->
        <Style x:Key="UtilNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryInkBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：工具子導覽（ItemsSource 來自 PageRegistry.Utilities） -->
        <Border Grid.Column="0" Width="200" Style="{StaticResource Card}" Padding="8" Margin="0,0,14,4"
                VerticalAlignment="Stretch">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="6,4,0,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="實用工具" VerticalAlignment="Center"/>
                    <local:HelpDot HelpKey="utilities/實用工具" Margin="5,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="SubNav" Background="Transparent" BorderThickness="0"
                         SelectionChanged="SubNav_SelectionChanged"
                         ItemContainerStyle="{StaticResource UtilNavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PageDef}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Hint}">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              Data="{Binding Icon}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 右：所選工具 -->
        <ContentControl x:Name="ToolHost" Grid.Column="1"/>
    </Grid>
</UserControl>
