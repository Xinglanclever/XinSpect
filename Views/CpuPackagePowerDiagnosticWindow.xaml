<Window x:Class="XinSpect.CpuPackagePowerDiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XinSpect"
        Title="CPU 封裝功耗被動診斷" Width="1040" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource PagePlaneBrush}" Foreground="{DynamicResource PrimaryInkBrush}"
        UseLayoutRounding="True" Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate x:Key="MnemonicButtonContent">
            <AccessText Text="{Binding}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="CPU 封裝功耗被動診斷" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{DynamicResource SecondaryInkBrush}"
                       Text="按下開始才取樣：僅 Intel family 6/model 0x55、裸機、Windows 單一實體封裝。須先開啟既有第一級進階診斷，並已有共用 MSR 通道。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryInkBrush}"
                       Text="只借用已開啟的讀取通道；不啟動負載、不載入／重裝驅動、不更改防護或開關。不支援或通道未開啟時如實停止。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryInkBrush}"
                       Text="8 組 0x606／0x611、約 3.5 秒；固定 group／LP，以 QPC 差分。估值一律未驗證，不更新任何功耗信任或分析輸入；原低瓦數原因仍待證據。"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="_開始被動取樣" ContentTemplate="{StaticResource MnemonicButtonContent}" Click="Start_Click" Style="{StaticResource PrimaryButton}" MinHeight="38"/>
                    <Button x:Name="CancelButton" Content="_取消" ContentTemplate="{StaticResource MnemonicButtonContent}" Click="Cancel_Click" Style="{StaticResource ToolButton}" IsEnabled="False" MinHeight="38" Margin="10,0,0,0"/>
                    <Button x:Name="ExportButton" Content="_匯出 JSON" ContentTemplate="{StaticResource MnemonicButtonContent}" Click="Export_Click" Style="{StaticResource ToolButton}" IsEnabled="False" MinHeight="38" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="尚未取樣；開啟此視窗不讀硬體。" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
        <TextBox Grid.Row="2" x:Name="EvidenceBox" IsReadOnly="True" local:LanguageService.IsUiText="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface2Brush}"
                 Foreground="{DynamicResource PrimaryInkBrush}" Padding="12" FontFamily="Consolas"
                 AutomationProperties.Name="CPU 封裝功耗原始證據"
                 Text="取樣後顯示原始計數、單位、QPC 前後時間、來源及限制。資料只在按匯出後寫入您選擇的本機 JSON 檔案。"/>
        <TextBlock Grid.Row="3" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryInkBrush}"
                   Text="關閉第一級進階診斷即停止後續讀取；取消會等目前同步 I/O 真正返回後釋放通道。計數解析度不是準確度；RAPL／LHM 可能共用來源。"/>
    </Grid>
</Window>
