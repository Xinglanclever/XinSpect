<UserControl x:Class="XinSpect.NetworkSpeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 節點選擇：分段選擇器；ItemsPanel 為 WrapPanel，寬度不足時自動換行（低 DPI／窄窗不截斷） -->
        <Style x:Key="NodeItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="8" Padding="14,8"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
            <StackPanel Margin="2,0,0,10">
                <local:SectionHead Text="網速測試" HelpKey="netspeed/網速測試"/>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="量測對外網路的延遲、下載與上傳速度。需連外，測試期間會消耗流量。NTU 台大（台灣學術網路）與 SGIX（新加坡交換中心）可原生量測；HKBN 香港寬頻與測速網（中國大陸）未提供公開量測端點，將跳轉至內建瀏覽器開啟其官方測速頁，測完可由瀏覽器工具列的「回到測速頁面」返回。"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="測速節點" Margin="0,0,0,8"/>
                    <ListBox x:Name="NodePicker" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NodeItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                                    <TextBlock Text="{Binding Note}" FontSize="11.5" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryInkBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="開始測速"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="Start_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="延遲" HorizontalAlignment="Center" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock x:Name="PingText" Text="—" HorizontalAlignment="Center"
                                       FontSize="34" FontWeight="Bold" Foreground="{DynamicResource PrimaryInkBrush}"/>
                            <TextBlock Text="ms" HorizontalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedInkBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="下載" HorizontalAlignment="Center" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock x:Name="DownText" Text="—" HorizontalAlignment="Center"
                                       FontSize="34" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Mbps" HorizontalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedInkBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="上傳" HorizontalAlignment="Center" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock x:Name="UpText" Text="—" HorizontalAlignment="Center"
                                       FontSize="34" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Mbps" HorizontalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedInkBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,14"/>
                    <TextBlock x:Name="LiveText" HorizontalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource SecondaryInkBrush}" Text="尚未開始"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" FontSize="12" Margin="2,0,0,4" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedInkBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
