<UserControl x:Class="XinSpect.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 介面卡選擇：直式卡片選擇器 -->
        <Style x:Key="AdapterItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="8" Padding="12,9"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 自訂位址輸入框 -->
        <Style x:Key="IpBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
            <StackPanel Margin="2,0,0,10">
                <TextBlock Style="{StaticResource SectionHeader}" Text="DNS 快速切換"/>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="為選定的網路介面卡設定 DNS 伺服器。透過 Windows 內建 netsh 真實寫入，套用後自動清除解析快取。可隨時一鍵還原為自動取得（DHCP）。變更 DNS 需系統管理員權限。"/>
            </StackPanel>

            <!-- 介面卡 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="網路介面卡" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ToolButton}" Content="重新整理" Click="Refresh_Click"
                                HorizontalAlignment="Right" Padding="12,6"/>
                    </Grid>
                    <ListBox x:Name="AdapterPicker" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource AdapterItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryInkBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource SecondaryInkBrush}">
                                        <Run Text="目前 DNS：" Foreground="{StaticResource MutedInkBrush}"/><Run Text="{Binding DnsText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 預設 DNS -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="選擇 DNS（套用至上方選定的介面卡）" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="PresetList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ToolButton}" Click="Preset_Click"
                                        Margin="0,0,8,8" Padding="14,9" MinWidth="120" HorizontalContentAlignment="Left">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryInkBrush}"/>
                                        <TextBlock Text="{Binding Note}" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{StaticResource SecondaryInkBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 自訂 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="自訂 DNS（IPv4 或 IPv6）" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PrimaryBox" Grid.Column="0" Style="{StaticResource IpBox}" Margin="0,0,8,0"
                                 ToolTip="主要 DNS，如 1.1.1.1"/>
                        <TextBox x:Name="SecondaryBox" Grid.Column="1" Style="{StaticResource IpBox}" Margin="0,0,8,0"
                                 ToolTip="次要 DNS（選填）"/>
                        <Button x:Name="ApplyCustomBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                Content="套用自訂" Click="ApplyCustom_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0"
                               Text="留空次要即只設主要；輸入含冒號的位址會套用為 IPv6。"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource ToolButton}" Content="清除 DNS 快取" Click="Flush_Click" Padding="14,8"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" Margin="2,0,0,4" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedInkBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
