<UserControl x:Class="XinSpect.FirmwareSecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <UserControl.Resources>
        <!-- 依分類分組：晶片組安全／SPI 快閃／Platform／ACPI 各成一節，一眼看清證據來源 -->
        <CollectionViewSource x:Key="FirmwareRowsSource" Source="{Binding EvidenceLab.FirmwareSecurityRows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="韌體安全" FontSize="20" FontWeight="SemiBold"/>
                <local:HelpDot HelpKey="firmware-security/韌體安全" Margin="8,6,0,0"/>
                <Button x:Name="RefreshEvidenceButton" AutomationProperties.AutomationId="RefreshEvidenceButton"
                        Style="{StaticResource ToolButton}" Content="重新擷取" Click="RefreshEvidence_Click"
                        Margin="12,2,0,0" ToolTip="以目前可用的讀取後端重新擷取驅動相依事實；啟用深層存取後不必重啟即可翻成真值。"/>
                <Button x:Name="CompareFlashButton" AutomationProperties.AutomationId="CompareFlashButton"
                        Style="{StaticResource ToolButton}" Content="與參考映像比對" Click="CompareFlash_Click"
                        Margin="8,2,0,0" ToolTip="選一份原廠（或信任來源）的 BIOS 區映像，與快閃可讀面逐 4KB 塊比對；大小不符會誠實拒比。"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"
                       Text="晶片組安全暫存器與 ACPI 錯誤表。讀得到給裁決；缺 ring0／不支援／權限不足一律誠實標示，不以舊值或 0 填補。"/>

            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="深層核心存取" FontWeight="SemiBold"/>
                        <local:HelpDot HelpKey="firmware-security/深層核心存取" Margin="8,2,0,0"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11"
                               Text="開＝產生本專案自簽 CA 並裝入信任庫、載入 XsRegProbe 白名單唯讀驅動（僅允許清單內的 MSR/MMIO 讀取，退出即卸載）；關＝移除信任並卸載。只信自己這張憑證、不開全機 test-signing；需要管理員權限，未提權時不會做任何變更。MMIO 事實已由 WinRing0 主力後端讀取，本驅動是允許清單內的備援路徑。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="DeepAccessEnableButton" AutomationProperties.AutomationId="DeepAccessEnableButton"
                                Style="{StaticResource PrimaryButton}" Content="開啟" Click="DeepAccessEnable_Click"/>
                        <Button x:Name="DeepAccessDisableButton" AutomationProperties.AutomationId="DeepAccessDisableButton"
                                Style="{StaticResource ToolButton}" Content="關閉" Click="DeepAccessDisable_Click" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding EvidenceLab.DeepAccess.StatusText}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="700" Opacity="0.85"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{DynamicResource CriticalBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="PMU 編程驗證（多輪測試・不保證可用）" HelpKey="firmware-security/PMU 編程驗證"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource CriticalBrush}" Margin="0,2,0,4"
                               Text="{Binding EvidenceLab.PmuProgrammingNotice}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="PmuConsentCheckBox" VerticalAlignment="Center"
                                  Content="我已了解風險（寫入固定計數器使能位、絕不碰 PMI 位元、每輪還原原值），明確同意執行"/>
                        <Button x:Name="PmuVerifyButton" AutomationProperties.AutomationId="PmuVerifyButton"
                                Style="{StaticResource ToolButton}" Content="執行編程驗證（3 輪）" Click="PmuVerify_Click"
                                Margin="12,0,0,0" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="PmuResultText" Style="{StaticResource Subtitle}" Margin="0,6,0,0"
                               TextWrapping="Wrap" Text="未執行。逐輪驗證：啟用讀回一致→計數器活動→還原後讀回原值。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{DynamicResource CriticalBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="記憶體壓力探測（危險・未經校驗）" HelpKey="firmware-security/記憶體壓力探測"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource CriticalBrush}" Margin="0,2,0,4"
                               Text="{Binding EvidenceLab.RowhammerDangerText}"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11"
                               Text="【未經過校驗】本探測的結果沒有對照過任何參考實作（usermode 無 clflush），非保證觸發 Rowhammer；輸出僅代表壓力下自擁有頁面的翻轉觀察，不作為記憶體可靠性的結論。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="RowhammerConsentCheckBox" VerticalAlignment="Center"
                                  Content="我已了解風險（可能損壞資料、建議專用測試機），明確同意執行"/>
                        <Button x:Name="RowhammerRunButton" AutomationProperties.AutomationId="RowhammerRunButton"
                                Style="{StaticResource ToolButton}" Content="執行壓力探測（256 MiB）" Click="RowhammerRun_Click"
                                Margin="12,0,0,0" IsEnabled="False"/>
                        <Button x:Name="RowhammerMultiButton" AutomationProperties.AutomationId="RowhammerMultiButton"
                                Style="{StaticResource ToolButton}" Content="多輪模式（10 輪・不保證可用）" Click="RowhammerMulti_Click"
                                Margin="8,0,0,0" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="RowhammerResultText" Style="{StaticResource Subtitle}" Margin="0,6,0,0"
                               TextWrapping="Wrap" Text="未執行。勾選同意前按鈕不可用；結果必定帶「未經過校驗」標註。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="交叉對帳判決" HelpKey="firmware-security/交叉對帳"/>
                        <TextBlock Text="{Binding EvidenceLab.ReconcileSummary}" HorizontalAlignment="Right"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="26 條規則對同一批事實做語義與管線一致性交叉——矛盾整列紅字：兩個來源對同一件事說了不同的話。"/>
                    <ItemsControl ItemsSource="{Binding EvidenceLab.ReconcileVerdicts}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RelationText}" FontWeight="SemiBold"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding RuleName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{Binding Reason}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Reason}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="分類" Opacity="0.5" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="項目" Opacity="0.5" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="判讀" Opacity="0.5" FontSize="11"/>
                <TextBlock Grid.Column="3" Text="來源" Opacity="0.5" FontSize="11"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Source={StaticResource FirmwareRowsSource}}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,4"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Category}" Opacity="0.6"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                            <TextBlock Grid.Column="2" FontFamily="Consolas" Text="{Binding ValueText}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="{Binding Source}" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
