<UserControl x:Class="XinSpect.FactAtlasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <StackPanel Margin="2,0,0,10">
                <local:SectionHead Text="事實總表" HelpKey="atlas/事實總表"/>
                <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="這一版實作的每一把事實鍵都在這裡，連同它這一輪的狀態（讀到／平台不支援／權限不足／讀取失敗／本機不適用／未確認）。有些能力沒有專屬頁面、只在匯出檔裡看得到——那些在這裡照樣找得到，不必先知道它在哪一頁。鍵的清單是建置時固定的目錄，不是這次掃到什麼才列什麼。"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="這一版有多少" HelpKey="atlas/這一版有多少"/>
                        <Button Style="{StaticResource ToolButton}" Content="重新載入本輪事實" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="Reload_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding FactAtlas.Summary}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="「本次未收集」說的是這一輪沒有跑到那條路徑（需要驅動、需要提權、或要使用者按下量測），不是那把鍵不存在。這張表刻意不猜是哪一種。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <local:SectionHead Text="逐域摘要" HelpKey="atlas/逐域摘要"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="域＝鍵的第一段（ac.dmar.summary 的域是 ac）。「本輪量到」只算真的讀到值的那幾把。"/>
                    <ItemsControl ItemsSource="{Binding FactAtlas.Domains}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/><ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="56"/><ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Prefix}" Style="{StaticResource FieldValue}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CatalogKeys}" Style="{StaticResource FieldLabel}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Collected}" Style="{StaticResource FieldLabel}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Present}" Style="{StaticResource FieldValue}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Unavailable}" Style="{StaticResource FieldLabel}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Example}" Style="{StaticResource FieldLabel}"
                                               TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/><ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="56"/><ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="域"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="目錄" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="收到" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="量到" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="讀不到" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <local:SectionHead Text="逐鍵明細" HelpKey="atlas/逐鍵明細"/>
                    <Grid Margin="0,8,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SetTextBox}" AutomationProperties.AutomationId="AtlasSearchBox"
                                 Text="{Binding FactAtlas.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="比對鍵、名稱、值與來源，不分大小寫"/>
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource DarkCombo}"
                                  AutomationProperties.AutomationId="AtlasDomainCombo"
                                  ItemsSource="{Binding FactAtlas.DomainOptions}"
                                  SelectedItem="{Binding FactAtlas.DomainFilter, Mode=TwoWay}"/>
                        <!-- 就地排序（U10-UI-0003／ui.table.controls）：排序只重排列序，狀態併進下方篩選聲明 -->
                        <ComboBox Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource DarkCombo}"
                                  AutomationProperties.AutomationId="AtlasSortCombo"
                                  ItemsSource="{Binding FactAtlas.SortOptions}"
                                  SelectedItem="{Binding FactAtlas.SortMode, Mode=TwoWay}"
                                  ToolTip="排序只重排目前已篩選的列，不改變任何一列的內容"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Text="{Binding FactAtlas.FilterNote}"/>
                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/><ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="鍵"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="狀態"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="值"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ColHead}" Text="走勢"/>
                            <local:HelpDot HelpKey="atlas/走勢欄" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="來源"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding FactAtlas.Keys}" MaxHeight="520" Margin="0,6,0,0"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.AutomationId="AtlasKeyList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/><ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource FieldValue}"
                                               FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource FieldValue}"
                                               TextWrapping="Wrap" MaxHeight="52" Margin="6,0,6,0"/>
                                    <local:Sparkline Grid.Column="3" Height="18" VerticalAlignment="Center"
                                                     Values="{Binding SparkSeries}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Source}" Style="{StaticResource FieldLabel}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="讀不到的那幾列，原因寫在名稱欄後面（例如「平台不支援 …」）；那是這一輪的判定，不是推測。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <local:SectionHead Text="動態家族" HelpKey="atlas/動態家族"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="這一群鍵的成員由機器決定（匯流排上有幾張卡、探到哪個埠），編譯期列不完，所以只登記「有哪些家族」與「成員由什麼決定」。它們不計入上面的目錄總數。"/>
                    <ItemsControl ItemsSource="{Binding FactAtlas.Families}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Prefix}" Style="{StaticResource FieldValue}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Reason}" Style="{StaticResource FieldLabel}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
