<Window x:Class="XinSpect.SpeakerTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="喇叭檢測" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Topmost="True" Background="#0E0F13" Focusable="True"
        KeyDown="Window_KeyDown" Closed="Window_Closed">
    <Grid>
        <!-- 頂部標題 -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,26,0,0" IsHitTestVisible="False">
            <TextBlock Text="喇叭檢測" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Foreground="#9AA0AA" FontSize="12.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                       Text="1：左聲道　2：右聲道　3：雙聲道　4：左右交替　5：掃頻（20 Hz → 20 kHz）　S：停止　Esc：離開"/>
        </StackPanel>

        <!-- 中央：左右箱體，正在輸出的一側亮起（亮的是「送出去的訊號」，不是「量到的聲音」）-->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="LeftBox" Width="230" Height="290" CornerRadius="16" Margin="0,0,44,0"
                    Background="#14171E" BorderBrush="#3A4150" BorderThickness="2">
                <StackPanel VerticalAlignment="Center">
                    <Ellipse x:Name="LeftCone" Width="128" Height="128" HorizontalAlignment="Center"
                             Fill="#1C2029" Stroke="#3A4150" StrokeThickness="2"/>
                    <TextBlock Text="左聲道 L" Foreground="#E6E9EF" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="RightBox" Width="230" Height="290" CornerRadius="16"
                    Background="#14171E" BorderBrush="#3A4150" BorderThickness="2">
                <StackPanel VerticalAlignment="Center">
                    <Ellipse x:Name="RightCone" Width="128" Height="128" HorizontalAlignment="Center"
                             Fill="#1C2029" Stroke="#3A4150" StrokeThickness="2"/>
                    <TextBlock Text="右聲道 R" Foreground="#E6E9EF" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 底部：目前輸出內容與判讀說明 -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,54" IsHitTestVisible="False"
                Background="#C0161821" CornerRadius="12" Padding="22,16" MaxWidth="820">
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="14.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Text="尚未播放　按 1～5 選擇測試音"/>
                <TextBlock Foreground="#9AA0AA" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="測試音由本程式即時合成後送往系統預設輸出裝置（44.1 kHz／16 位元／立體聲）。左右分離用於確認接線與聲道對調；掃頻用於聽出破音、雜音與明顯的頻段缺口。"/>
                <TextBlock Foreground="#6B7280" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="本工具只負責產生並輸出訊號，是否真的聽見由你判斷——程式無法代替耳朵，也不會回報未曾量到的音量。環繞聲道（5.1／7.1）需要獨占輸出裝置，本工具不涉入。"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
