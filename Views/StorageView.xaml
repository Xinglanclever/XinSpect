<UserControl x:Class="XinSpect.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="儲存"/>

            <!-- 磁碟空間甜甜圈（各邏輯磁碟已用比例）── 置於最頂 -->
            <Border Style="{StaticResource Card}" local:Anim.RevealDelay="0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="磁碟空間" Margin="2,0,0,0"/>
                        <TextBlock Style="{StaticResource FieldLabel}" HorizontalAlignment="Right"
                                   Text="{Binding Volumes.SummaryText}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Volumes.Volumes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:DonutChart Margin="6,8"
                                                  Fraction="{Binding UsedFraction}"
                                                  Caption="{Binding CaptionText}"
                                                  Caption2="{Binding FreeText}"
                                                  SubText="{Binding SizeText}"
                                                  RingBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 儲存裝置（即時 S.M.A.R.T. 與 WMI 深度靜態資訊整合為單一區塊，消除重複顯示） -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="70"
                    Visibility="{Binding Live.HasDrives, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="儲存裝置"/>
                    <ItemsControl ItemsSource="{Binding Live.Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- 標題列：品牌徽章＋型號，右側即時溫度/已用 -->
                                        <Grid Margin="0,0,0,10">
                                            <local:BrandBadge Kind="Disk" EmblemSize="34" HorizontalAlignment="Left"
                                                              Brand="{Binding Brand}" Model="{Binding DisplayModel}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource FieldValue}" FontSize="12.5"/>
                                                </Border>
                                                <TextBlock Style="{StaticResource FieldValue}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                           Text="{Binding TempText}"
                                                           Foreground="{Binding TempSeverity, Converter={StaticResource SeverityToBrush}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <local:FieldRow Label="磁碟編號" Value="{Binding CountText}"/>
                                                <local:FieldRow Label="容量" Value="{Binding CapacityText}"/>
                                                <local:FieldRow Label="介面" Value="{Binding InterfaceType}"/>
                                                <local:FieldRow Label="匯流排" Value="{Binding BusText}"/>
                                                <local:FieldRow Label="媒體類型" Value="{Binding MediaType}"/>
                                                <local:FieldRow Label="剩餘壽命" Value="{Binding LifeText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <local:FieldRow Label="序號" Value="{Binding SerialNumber}"/>
                                                <local:FieldRow Label="韌體" Value="{Binding Firmware}"/>
                                                <local:FieldRow Label="分割數" Value="{Binding PartitionsText}"/>
                                                <local:FieldRow Label="磁區大小" Value="{Binding SectorText}"/>
                                                <local:FieldRow Label="已用空間" Value="{Binding UsedText}"/>
                                                <local:FieldRow Label="健康狀態" Value="{Binding HealthText}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 磁碟活動走勢（可切換：全部顯示 / 單獨顯示） -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="140"
                    Visibility="{Binding Live.HasDrives, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="磁碟活動時間（近 90 秒）" Margin="2,0,0,0"/>
                        <ComboBox Style="{StaticResource DarkCombo}" Width="220" HorizontalAlignment="Right"
                                  ItemsSource="{Binding DiskViewChoices}" SelectedIndex="{Binding DiskViewIndex, Mode=TwoWay}"
                                  ToolTip="選擇顯示全部硬碟或單一硬碟"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DiskActivityView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <local:BrandBadge Kind="Disk" Compact="True" EmblemSize="22" ShowModel="False"
                                                          Brand="{Binding Brand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="　・ 使用中 " VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding ActivityText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <local:HistoryGraph Height="80" History="{Binding ActivityHist}"
                                                        Stroke="{StaticResource AccentBrush}" Caption="活動時間 (%)" ShowValue="False"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,10,0,0"
                       Text="剩餘壽命與溫度來自 S.M.A.R.T.，部分裝置或未提供。"/>

            <!-- ===== S.M.A.R.T. 原始資料 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="S.M.A.R.T. 原始資料"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="讀取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="SmartRead_Click" IsEnabled="{Binding DiskSmart.CanRead}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="NVMe 直讀健康紀錄（log page 0x02）；SATA 走 SMART_RCV_DRIVE_DATA（磁碟類別驅動代理）。屬性的原始值照韌體回報原樣列出（十六進位＋小端整數），不套任何廠商換算公式——換算就是猜。刻意不用會卡死 IRP 的原始 ATA_PASS-THROUGH；匯流排預檢不通過（USB 橋接等）時如實顯示不支援。"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource DarkCombo}" x:Name="SmartDrives"
                                  ItemsSource="{Binding DiskSmart.Drives}" DisplayMemberPath="Label" SelectedIndex="0"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding DiskSmart.KindText, StringFormat=來源：{0}}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding DiskSmart.Status}"/>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/><ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="屬性"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="現值"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="最差"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="原始值"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DiskSmart.Rows}" MaxHeight="420">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ValueText}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding WorstText}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding RawText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== SLC 快取耗盡曲線 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="SLC 快取耗盡曲線"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="SlcStop_Click" IsEnabled="{Binding SlcCache.IsRunning}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="開始測試"
                                    Click="SlcStart_Click" IsEnabled="{Binding SlcCache.CanStart}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="持續寫入選定磁碟區（每秒強制 FlushToDisk，量到的是真的落到裝置的速度），畫出速度曲線並偵測 SLC 快取耗盡後的斷崖——廠商規格表絕不會寫的數字。斷崖點由曲線推導，會受溫度與背景活動影響。測試檔結束後自動刪除。"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource DarkCombo}" x:Name="SlcVolume"
                                  ItemsSource="{Binding Volumes.Volumes}" DisplayMemberPath="CaptionText" SelectedIndex="0"
                                  SelectionChanged="SlcVolume_SelectionChanged"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Margin="8,0,0,0" x:Name="SlcTarget"
                                  ItemsSource="{Binding SlcCache.TargetTexts}" SelectedIndex="{Binding SlcCache.TargetIndex, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding SlcCache.PeakText, StringFormat=尖峰：{0}}"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource LoadBar}" Value="{Binding SlcCache.ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SlcCache.Status}"/>
                    <local:SlcCurveChart Height="220" Margin="0,10,0,0"
                                         Times="{Binding SlcCache.Times}" Speeds="{Binding SlcCache.Speeds}"
                                         CliffMarks="{Binding SlcCache.CliffMarks}"/>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SlcCache.CliffText}"/>
                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Text="{Binding SlcCache.PostText}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
