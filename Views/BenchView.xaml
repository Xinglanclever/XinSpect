<UserControl x:Class="XinSpect.BenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <local:SectionHead Text="效能測試" HelpKey="bench/效能測試"/>

            <!-- ===== 棋類跑分（原生 perft，無執行緒上限；分數同時是運算正確性的檢核碼） ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="0">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="棋類跑分（原生節點吞吐・自我驗證）" HelpKey="bench/棋類跑分（原生節點吞吐・自我驗證）"/>
                        <TextBlock Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Chess.LogicalCores, StringFormat=本機 {0} 邏輯核心}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="以 perft（合法走法產生 + 走子/還原）為確定性整數負載，量測節點速率（kN/s）。每執行緒各持獨立引擎、無鎖競爭，可超額訂閱實體核心。固定局面固定深度的節點數是數學常數，因此每一輪都順便核對：算出別的數字代表這台機器算錯了，而不是它比較慢。"/>

                    <!-- 棋種選擇：兩種引擎的分支型態與記憶體足跡不同，是兩種負載，不是換皮 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="棋種" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="EngXiangqi" Style="{StaticResource ToolButton}" Content="中國象棋" Margin="0,0,6,0" Click="EngXiangqi_Click"/>
                        <Button x:Name="EngChess" Style="{StaticResource ToolButton}" Content="西洋棋" Margin="0,0,12,0" Click="EngChess_Click"/>
                        <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding Chess.EngineNote}"/>
                    </StackPanel>

                    <!-- 執行緒選擇 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="執行緒" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="ChessT1" Style="{StaticResource ToolButton}" Content="單執行緒" Margin="0,0,6,0" Click="ChessT1_Click"/>
                        <Button x:Name="ChessTAll" Style="{StaticResource ToolButton}" Margin="0,0,6,0" Click="ChessTAll_Click"
                                Content="全部核心"/>
                        <Button x:Name="ChessT64" Style="{StaticResource ToolButton}" Content="64" Margin="0,0,6,0" Click="ChessT64_Click"/>
                        <Button x:Name="ChessT128" Style="{StaticResource ToolButton}" Content="128" Margin="0,0,6,0" Click="ChessT128_Click"/>
                        <Button x:Name="ChessT256" Style="{StaticResource ToolButton}" Content="256" Margin="0,0,12,0" Click="ChessT256_Click"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="自訂" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ChessCustom" Width="72" VerticalContentAlignment="Center"
                                 Text="{Binding Chess.ThreadCount, UpdateSourceTrigger=LostFocus}"
                                 Background="{StaticResource Surface2Brush}" Foreground="{StaticResource PrimaryInkBrush}"
                                 BorderBrush="{StaticResource HairlineBrush}" Padding="6,4"/>
                    </StackPanel>

                    <!-- 測試時間 + 起停 -->
                    <DockPanel Margin="0,12,0,0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="測試時間" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="ChessD5" Style="{StaticResource ToolButton}" Content="5 秒" Margin="0,0,6,0" Click="ChessD5_Click"/>
                            <Button x:Name="ChessD10" Style="{StaticResource ToolButton}" Content="10 秒" Margin="0,0,6,0" Click="ChessD10_Click"/>
                            <Button x:Name="ChessD30" Style="{StaticResource ToolButton}" Content="30 秒" Click="ChessD30_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ChessStop" Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="ChessStop_Click" IsEnabled="{Binding Chess.IsRunning}"/>
                            <Button x:Name="ChessStart" Style="{StaticResource PrimaryButton}" Content="開始跑分"
                                    Click="ChessStart_Click" IsEnabled="{Binding Chess.CanStart}"/>
                        </StackPanel>
                    </DockPanel>

                    <ProgressBar Style="{StaticResource LoadBar}" Margin="0,14,0,0"
                                 Value="{Binding Chess.ProgressPercent, Mode=OneWay}"/>
                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldValue}" Text="{Binding Chess.Phase}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Chess.ThreadText}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding Chess.StatusLine}"/>

                    <!-- 結果數值：小字一律是本機歷次成績的對照，沒有任何外部參考分數 -->
                    <UniformGrid Rows="1" Columns="3" Margin="0,14,0,0">
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="單執行緒" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Chess.SingleText}" FontSize="24" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                                <TextBlock Text="{Binding Chess.SingleDeltaText}" Style="{StaticResource FieldLabel}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="多執行緒" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Chess.MultiText}" FontSize="24" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                                <TextBlock Text="{Binding Chess.MultiDeltaText}" Style="{StaticResource FieldLabel}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="加速比" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Chess.SpeedupText}" FontSize="24" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                                <TextBlock Text="{Binding Chess.EfficiencyText}" Style="{StaticResource FieldLabel}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 本機重複性與量測條件：一個分數不附帶溫度／頻率，就無從判斷它是在冷機還是溫度牆下量到的 -->
                    <TextBlock Style="{StaticResource Subtitle}" Margin="2,10,0,0" TextWrapping="Wrap"
                               Text="{Binding Chess.RepeatText}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="2,4,0,0" TextWrapping="Wrap"
                               Text="{Binding Chess.ConditionText}"/>

                    <!-- 運算正確性：取代舊的「原版對照」。外部程式只能給另一個分數，
                         數學常數能給出對或錯——一個算錯的高分沒有意義，所以它跟速度並列。 -->
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="運算正確性" Style="{StaticResource FieldValue}" Margin="0,0,10,0"/>
                                <TextBlock Text="⚠ 偵測到運算錯誤" Style="{StaticResource FieldValue}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource CriticalBrush}"
                                           Visibility="{Binding Chess.HasFault, Converter={StaticResource BoolToVis}}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Chess.VerifyText}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Chess.IntegrityText}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="固定局面、固定深度的 perft 節點數與 CPU 型號、時脈、執行緒數都無關，是一個唯一的整數。本測試每輪都拿它核對一次，因此除了速度，也會回報這台機器算得對不對——不穩的超頻常常先表現為極少數的靜默計算錯誤，而分支密集的整數負載出錯的方式與 Prime95 的 FFT 不同，兩者互補。"/>
                        </StackPanel>
                    </Border>

                    <!-- 曾經此處有一張「參考對照（示意，非實測）」表與一顆「啟動原版對照」按鈕：
                         內建的 Pentium III 1 GHz 基準與各機型倍率都不是量出來的，只是把猜測寫得像量測；
                         而那顆按鈕靠內嵌一份他家的評測執行檔才能運作，既非本專案授權範圍，
                         給出的分數也只能跟它自己比。兩者都已移除，改以數學常數作為對照基準。 -->
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="2,14,0,0" TextWrapping="Wrap"
                               Text="不提供各機型的參考倍率：那類對照表無法誠實——同型號的機器換一支散熱膏、換一種電源計劃就差一成，標成「約略」也只是把猜測寫得像量測。要跟別台電腦比，請在兩台機器上各選同一個棋種與同樣的執行緒數／時間跑一次：兩邊算的是同一個數學常數，工作量嚴格相等，這個比較才成立。"/>
                </StackPanel>
            </Border>

            <!-- ===== 烤機（穩定度壓力測試） ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="40">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="烤機（穩定度壓力測試）" HelpKey="bench/烤機（穩定度壓力測試）"/>
                        <TextBlock Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Stress.Threads, StringFormat=全部 {0} 執行緒滿載}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="以全部邏輯執行緒持續高強度運算，將 CPU 推至滿載，觀察長時間高負載下的溫度、頻率與是否降頻。請搭配下方「即時走勢」的溫度 / 頻率曲線一同判讀。"/>

                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="烤機時間" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="StressD60" Style="{StaticResource ToolButton}" Content="1 分鐘" Margin="0,0,6,0" Click="StressD60_Click"/>
                            <Button x:Name="StressD300" Style="{StaticResource ToolButton}" Content="5 分鐘" Margin="0,0,6,0" Click="StressD300_Click"/>
                            <Button x:Name="StressD600" Style="{StaticResource ToolButton}" Content="10 分鐘" Margin="0,0,6,0" Click="StressD600_Click"/>
                            <Button x:Name="StressDInf" Style="{StaticResource ToolButton}" Content="持續" Click="StressDInf_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="StressStop" Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="StressStop_Click" IsEnabled="{Binding Stress.IsRunning}"/>
                            <Button x:Name="StressStart" Style="{StaticResource PrimaryButton}" Content="開始烤機"
                                    Click="StressStart_Click" IsEnabled="{Binding Stress.CanStart}"/>
                        </StackPanel>
                    </DockPanel>

                    <ProgressBar Style="{StaticResource LoadBar}" Margin="0,14,0,0"
                                 Value="{Binding Stress.ProgressPercent, Mode=OneWay}"/>
                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldValue}" Text="{Binding Stress.Phase}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Stress.ElapsedText}"/>
                    </DockPanel>

                    <!-- 極值與穩定度 -->
                    <UniformGrid Rows="1" Columns="4" Margin="0,14,0,0">
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="最高溫度" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Stress.MaxTempText}" FontSize="22" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="最高頻率" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Stress.MaxClockText}" FontSize="22" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="最低頻率（滿載）" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Stress.MinClockText}" FontSize="22" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="穩定度" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Stress.StabilityText}" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{Binding Stress.StabilitySeverity, Converter={StaticResource SeverityToBrush}}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{Binding Stress.StatusLine}"/>
                </StackPanel>
            </Border>

            <!-- ===== GPU 燒機（FurMark 施加負載 + XinSpect 原生即時監測；置於 CPU 烤機下方） ===== -->
            <local:GpuStressView local:Anim.RevealDelay="50"/>

            <!-- ===== 綜合效能測試（單/多執行緒運算 + 記憶體頻寬） ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="60">
                <StackPanel>
                    <local:SectionHead Text="綜合效能測試" HelpKey="bench/綜合效能測試"/>
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="測試時間" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="Dur10" Style="{StaticResource ToolButton}" Content="10 秒" Margin="0,0,6,0" Click="Dur10_Click"/>
                            <Button x:Name="Dur30" Style="{StaticResource ToolButton}" Content="30 秒" Margin="0,0,6,0" Click="Dur30_Click"/>
                            <Button x:Name="Dur60" Style="{StaticResource ToolButton}" Content="60 秒" Click="Dur60_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="StopBtn" Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="Stop_Click" IsEnabled="{Binding Bench.IsRunning}"/>
                            <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="開始測試"
                                    Click="Start_Click" IsEnabled="{Binding Bench.CanStart}"/>
                        </StackPanel>
                    </DockPanel>

                    <ProgressBar Style="{StaticResource LoadBar}" Margin="0,16,0,0"
                                 Value="{Binding Bench.ProgressPercent, Mode=OneWay}"/>
                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldValue}" Text="{Binding Bench.Phase}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                   Text="{Binding Bench.ProgressPercent, StringFormat={}{0:0} %}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding Bench.StatusLine}"/>
                </StackPanel>
            </Border>

            <!-- 測試期間即時走勢 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="120">
                <StackPanel>
                    <local:SectionHead Text="測試期間即時走勢（近 90 秒）" HelpKey="bench/測試期間即時走勢（近 90 秒）"/>
                    <UniformGrid Rows="1" Columns="3">
                        <local:HistoryGraph Height="120" Margin="0,0,6,0" Caption="CPU 使用率"
                                            History="{Binding CpuLoadHist}" Stroke="{StaticResource AccentBrush}"/>
                        <local:HistoryGraph Height="120" Margin="3,0,3,0" Caption="CPU 溫度"
                                            History="{Binding CpuTempHist}" Stroke="{StaticResource SeriousBrush}"/>
                        <local:HistoryGraph Height="120" Margin="6,0,0,0" Caption="CPU 頻率"
                                            History="{Binding CpuClockHist}" Stroke="{StaticResource WarningBrush}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 綜合測試結果 -->
            <Border Style="{StaticResource Card}" local:Anim.RevealDelay="180">
                <StackPanel>
                    <local:SectionHead Text="綜合測試結果" HelpKey="bench/綜合測試結果"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 綜合分數 -->
                        <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="12"
                                Padding="28,20" Margin="0,4,20,4" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Bench.CompositeText}" FontSize="46" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="綜合分數" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Bench.DeltaText}" Style="{StaticResource Subtitle}" MaxWidth="180"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 分項結果 -->
                        <UniformGrid Grid.Column="1" Rows="1" Columns="3" VerticalAlignment="Center">
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="0,4,5,4">
                                <StackPanel>
                                    <TextBlock Text="單執行緒" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Bench.SingleText}" FontSize="28" Margin="0,2,0,0"
                                               Foreground="{StaticResource PrimaryInkBrush}"/>
                                    <TextBlock Text="MOPS ・ 每秒百萬次運算" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="5,4,5,4">
                                <StackPanel>
                                    <TextBlock Text="多執行緒" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Bench.MultiText}" FontSize="28" Margin="0,2,0,0"
                                               Foreground="{StaticResource PrimaryInkBrush}"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,2,0,0"
                                               Text="{Binding Bench.Threads, StringFormat=MOPS ・ {0} 執行緒}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="5,4,0,4">
                                <StackPanel>
                                    <TextBlock Text="記憶體頻寬" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Bench.MemText}" FontSize="28" Margin="0,2,0,0"
                                               Foreground="{StaticResource PrimaryInkBrush}"/>
                                    <TextBlock Text="GB/s ・ 大區塊複製" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <!-- 本機重複性與量測條件（同上：唯一的基準是這台機器自己的紀錄） -->
                    <TextBlock Style="{StaticResource Subtitle}" Margin="2,12,0,0" TextWrapping="Wrap"
                               Text="{Binding Bench.RepeatText}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="2,4,0,0" TextWrapping="Wrap"
                               Text="{Binding Bench.ConditionText}"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,10,0,14" TextWrapping="Wrap"
                       Text="綜合分數 = 單執行緒 × 2 + 多執行緒 + 記憶體頻寬 × 20。這組權重是本程式自訂的，沒有跨機器的意義，只能用於同一台機器的前後比較；測試期間請避免其他高負載程式。"/>

            <!-- ===== 本機跑分紀錄（實測對照） =====
                 曦覽不內建任何別台機器的參考分數。可信的比較對象只有這台機器自己量到的數字，
                 因此每次跑完都記下設定與當時的溫度／頻率，讓「這次比上次低」能分清是硬體變了還是當時比較熱。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="190"
                    Visibility="{Binding Benchmarks.Recent.Count, Converter={StaticResource CountToVis}}">
                <StackPanel>
                    <local:SectionHead Text="本機跑分紀錄（實測對照）" HelpKey="bench/本機跑分紀錄（實測對照）"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="本機歷次成績，新的在上。同項目、同設定才可直接相比；「量測條件」是跑分當時實際讀到的溫度與頻率，沒有感測器時留空而不以 0 充數。紀錄存於 %APPDATA%\XinSpect\bench-history.json，可在設定頁一併清除。"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" Text="時間"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="項目"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="設定"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="成績" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="量測條件" Margin="12,0,0,0"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Benchmarks.Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{Binding TimeText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Title}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{Binding Config}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding ScoreText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="{Binding Conditions}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Top-down 管線歸因（PMU 實測） ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="195">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="管線歸因 Top-down（PMU 實測）" HelpKey="bench/管線歸因 Top-down（PMU 實測）"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="TdStop" Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="TdStop_Click" IsEnabled="{Binding TopDown.IsRunning}"/>
                            <Button x:Name="TdStart" Style="{StaticResource PrimaryButton}" Content="開始取樣"
                                    Click="TdStart_Click" IsEnabled="{Binding TopDown.CanStart}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,4" TextWrapping="Wrap"
                               Text="直接編程 Intel PMU 的四個通用計數器，量測「目前系統正在跑的負載」把每周期的發射插槽花在哪裡：退休／錯誤推測／前端受限／後端受限。這不是跑分——它量的是此刻的真實負載，不會自己製造負載。"/>
                    <!-- 分母（插槽總數＝配發寬度 × 未停頓周期）必須攤在畫面上：寬度逐代不同（Skylake 4、
                         Sunny Cove 5、Golden Cove 6、Lion Cove 8），寫錯的話四桶會整組偏掉，而且偏得像真的。 -->
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Text="{Binding TopDown.MicroarchText, StringFormat=分母來源：{0}}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="誠實界線：① 錯誤推測一桶不含 INT_MISC.RECOVERY_CYCLES 項（硬體只有 4 個通用計數器，五個事件放不下），故該桶略微低估、後端受限略微高估。② 逐實體核心序列取樣，各核心的取樣時間點不同，非同一瞬間的快照。③ 以 AnyThread 量整顆實體核心（SMT 兩執行緒合計），因為前端事件本質是核心層事件。④ 取樣前後完整存讀並還原 PERFEVTSEL0–3 與 GLOBAL_CTRL，不變動作業系統正在使用的固定計數器；若同時有 VTune／PCM 在用計數器，兩者會互相覆蓋。"/>

                    <ItemsControl ItemsSource="{Binding TopDown.Buckets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PercentText}" FontSize="18" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource PrimaryInkBrush}"/>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource LoadBar}" Maximum="1" Margin="0,6,0,0"
                                                     Value="{Binding BarFraction, Mode=OneWay}"/>
                                        <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Note}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <UniformGrid Rows="1" Columns="2" Margin="0,4,0,0">
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="每周期退休插槽" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding TopDown.SlotsRetiredText}" FontSize="20" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="解讀" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding TopDown.VerdictText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <ProgressBar Style="{StaticResource LoadBar}" Margin="0,12,0,0" Value="{Binding TopDown.ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding TopDown.StatusLine}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding TopDown.SupportText}"/>

                    <!-- 逐實體核心明細 -->
                    <Grid Margin="0,10,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="66"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="實體核心"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="退休占比"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="退休" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="錯誤推測" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="前端" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Style="{StaticResource FieldLabel}" Text="後端" TextAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding TopDown.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="66"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding CoreText}"/>
                                        <TextBlock Style="{StaticResource Subtitle}" FontSize="10" Text="{Binding LpText}"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource LoadBar}" Maximum="1" VerticalAlignment="Center"
                                                 Margin="0,0,10,0" Value="{Binding BarFraction, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding RetiringText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding BadSpecText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding FrontendText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Style="{StaticResource FieldValue}" Text="{Binding BackendText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 快取 / 記憶體延遲 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="200">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="快取 / 記憶體延遲" HelpKey="bench/快取 / 記憶體延遲"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="CacheStop" Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="CacheStop_Click" IsEnabled="{Binding Cache.IsRunning}"/>
                            <Button x:Name="CacheStart" Style="{StaticResource PrimaryButton}" Content="開始測試"
                                    Click="CacheStart_Click" IsEnabled="{Binding Cache.CanStart}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="以指標追逐法量測不同工作集大小的隨機存取延遲，藉延遲跳升推估各級快取與主記憶體的存取延遲（數值越低越快）。"/>

                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,4">
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="L1 快取" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Cache.L1Text}" FontSize="20" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="L2 快取" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Cache.L2Text}" FontSize="20" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="L3 快取" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Cache.L3Text}" FontSize="20" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="主記憶體" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Cache.RamText}" FontSize="20" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <ProgressBar Style="{StaticResource LoadBar}" Margin="0,12,0,0" Value="{Binding Cache.ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Cache.StatusLine}"/>

                    <!-- 各工作集延遲曲線（長條） -->
                    <ItemsControl ItemsSource="{Binding Cache.Rows}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource LoadBar}" Maximum="1" VerticalAlignment="Center"
                                                 Margin="0,0,10,0" Value="{Binding BarFraction, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding LatencyText}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 記憶體延遲曲線（實測 vs 宣稱）===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="210">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="記憶體延遲曲線" HelpKey="bench/記憶體延遲曲線"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="LatCurveStop_Click" IsEnabled="{Binding LatencyCurve.IsRunning}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="開始量測"
                                    Click="LatCurveStart_Click" IsEnabled="{Binding LatencyCurve.CanStart}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="以指標追逐法掃描 1 KB → 1 GB（半倍頻步進）的平均存取延遲；快取邊界由曲線階梯推導（量到的），與 CPUID leaf 0x04 宣稱的容量並列對照。工作集上限受可用記憶體約束（保留 1 GB）。"/>
                    <ProgressBar Style="{StaticResource LoadBar}" Value="{Binding LatencyCurve.ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding LatencyCurve.StatusLine}"/>
                    <local:LatencyCurveChart Height="230" Margin="0,10,0,0"
                                             Xs="{Binding LatencyCurve.Sizes}" Ys="{Binding LatencyCurve.Latencies}"
                                             BoundaryMarks="{Binding LatencyCurve.Boundaries}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,2" TextWrapping="Wrap"
                               Text="{Binding LatencyCurve.ClaimedNote, StringFormat={}{0}}"/>
                    <ItemsControl ItemsSource="{Binding LatencyCurve.BoundaryRows}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}" Text="{Binding Derived}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Claimed}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 記憶體頻寬與負載延遲（STREAM 式 ＋ MLC 式）===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="225">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="記憶體頻寬與負載延遲" HelpKey="bench/記憶體頻寬與負載延遲"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="MemBwStop_Click" IsEnabled="{Binding MemBandwidth.IsRunning}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="開始量測"
                                    Click="MemBwStart_Click" IsEnabled="{Binding MemBandwidth.CanStart}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="延遲曲線回答「一次存取多久」，這裡回答「同時能搬多少」與「被搶的時候會慢多少」。讀取／複製／相加／三元運算四種型態逐級加執行緒量到飽和，再一邊用其他核心把記憶體塞滿、一邊量單一存取的延遲。通道插錯與「一跑編譯整台機器就鈍」只有這裡看得出來。"/>
                    <ProgressBar Style="{StaticResource LoadBar}" Value="{Binding MemBandwidth.ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding MemBandwidth.StatusLine}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding MemBandwidth.PeakNote}"/>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,6,0,8" TextWrapping="Wrap" Text="{Binding MemBandwidth.Verdict}"/>

                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="存取型態"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="執行緒"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="相對"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="頻寬"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="達成率"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding MemBandwidth.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Kernel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ThreadsText}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="2" Style="{StaticResource LoadBar}" Maximum="1" VerticalAlignment="Center"
                                                 Margin="0,0,10,0" Value="{Binding BarFraction, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding GbpsText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding Note}" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <local:SectionHead Text="負載延遲（重壓下的等待）" HelpKey="bench/負載延遲（重壓下的等待）" Margin="0,14,0,2"/>
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="施壓等級"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="相對延遲"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="同時達成頻寬"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="延遲"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding MemBandwidth.LoadedRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding LoadText}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource LoadBar}" Maximum="1" VerticalAlignment="Center"
                                                 Margin="0,0,10,0" Value="{Binding BarFraction, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding GbpsText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding LatencyText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding MemBandwidth.LoadedVerdict}"/>
                </StackPanel>
            </Border>

            <!-- ===== SuperPI 圓周率運算 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="240">
                <StackPanel>
                    <local:SectionHead Text="SuperPI 圓周率運算" HelpKey="bench/SuperPI 圓周率運算"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="以 Chudnovsky 級數搭配二分裂解計算圓周率至指定位數，為單執行緒純運算負載；「完成所需時間」即為分數（越短越好），常用於比較單核運算效能。計時僅涵蓋實際運算，不含將上億位結果轉為十進位字串的輸出步驟。5000 萬／1 億位極耗時（數分鐘至數小時）且佔用大量記憶體，請斟酌選用。"/>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <Button x:Name="PiStop" Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="PiStop_Click" IsEnabled="{Binding SuperPi.IsRunning}"/>
                            <Button x:Name="PiStart" Style="{StaticResource PrimaryButton}" Content="開始計算"
                                    Click="PiStart_Click" IsEnabled="{Binding SuperPi.CanStart}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="位數"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="PiD1" Style="{StaticResource ToolButton}" Content="10 萬位" Margin="0,0,6,6" Click="PiD1_Click"/>
                                <Button x:Name="PiD2" Style="{StaticResource ToolButton}" Content="50 萬位" Margin="0,0,6,6" Click="PiD2_Click"/>
                                <Button x:Name="PiD3" Style="{StaticResource ToolButton}" Content="100 萬位" Margin="0,0,6,6" Click="PiD3_Click"/>
                                <Button x:Name="PiD4" Style="{StaticResource ToolButton}" Content="1000 萬位" Margin="0,0,6,6" Click="PiD4_Click"/>
                                <Button x:Name="PiD5" Style="{StaticResource ToolButton}" Content="5000 萬位" Margin="0,0,6,6" Click="PiD5_Click"/>
                                <Button x:Name="PiD6" Style="{StaticResource ToolButton}" Content="1 億位" Margin="0,0,0,6" Click="PiD6_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="12"
                                Padding="28,18" Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SuperPi.ElapsedText}" FontSize="34" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="完成時間（越短越好）" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ProgressBar Style="{StaticResource LoadBar}" Value="{Binding SuperPi.ProgressPercent, Mode=OneWay}"/>
                            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldValue}" Text="{Binding SuperPi.Phase}"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding SuperPi.DigitsText}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,0" Text="計算結果（前 40 位）"/>
                            <TextBlock Style="{StaticResource FieldValue}" Margin="0,2,0,0" Text="{Binding SuperPi.Preview}" TextWrapping="Wrap"
                                       FontFamily="Consolas"/>
                            <TextBlock Style="{StaticResource Subtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{Binding SuperPi.DeltaText}"/>
                            <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="{Binding SuperPi.RepeatText}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="{Binding SuperPi.ConditionText}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding SuperPi.StatusLine}"/>
                </StackPanel>
            </Border>

            <!-- ===== 磁碟效能測試 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="280">
                <StackPanel>
                    <local:SectionHead Text="磁碟效能測試" HelpKey="bench/磁碟效能測試"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="於所選磁碟建立約 512 MB 暫存檔，量測循序讀寫（MB/s）與隨機 4K 讀寫（IOPS），完成後自動刪除暫存檔。全程採未緩衝直接 I/O（繞過作業系統讀寫快取，避免讀到快取殘留而失真），隨機 4K 為佇列深度 1（QD1）。"/>

                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="目標磁碟" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox Style="{StaticResource DarkCombo}" Width="240"
                                      ItemsSource="{Binding DiskBench.Drives}"
                                      SelectedIndex="{Binding DiskBench.SelectedDriveIndex, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DiskBenchStop" Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="DiskBenchStop_Click" IsEnabled="{Binding DiskBench.IsRunning}"/>
                            <Button x:Name="DiskBenchStart" Style="{StaticResource PrimaryButton}" Content="開始測試"
                                    Click="DiskBenchStart_Click" IsEnabled="{Binding DiskBench.CanStart}"/>
                        </StackPanel>
                    </DockPanel>

                    <ProgressBar Style="{StaticResource LoadBar}" Margin="0,14,0,0" Value="{Binding DiskBench.ProgressPercent, Mode=OneWay}"/>
                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldValue}" Text="{Binding DiskBench.Phase}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                   Text="{Binding DiskBench.ProgressPercent, Mode=OneWay, StringFormat={}{0:0}%}"/>
                    </DockPanel>

                    <UniformGrid Rows="1" Columns="4" Margin="0,14,0,0">
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="循序讀取" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding DiskBench.SeqReadText}" FontSize="20" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="循序寫入" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding DiskBench.SeqWriteText}" FontSize="20" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="隨機 4K 讀取" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding DiskBench.RandReadText}" FontSize="20" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="隨機 4K 寫入" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding DiskBench.RandWriteText}" FontSize="20" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding DiskBench.StatusLine}"/>
                </StackPanel>
            </Border>

            <!-- ===== Windows 體驗指數（WinSAT） ===== -->
            <Border Style="{StaticResource Card}" local:Anim.RevealDelay="240">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="Windows 體驗指數（WinSAT）" HelpKey="bench/Windows 體驗指數（WinSAT）"/>
                        <Button x:Name="WinsatBtn" Style="{StaticResource ToolButton}" Content="重新評分"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="Winsat_Click" IsEnabled="{Binding Winsat.CanRun}"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 基礎分（WinSPR） -->
                        <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="12"
                                Padding="30,20" Margin="0,4,20,4" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Winsat.BaseScoreText}" FontSize="46" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="基礎分數 WinSPR" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Winsat.StateText}" Style="{StaticResource Subtitle}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="200" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 子分數 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <UniformGrid Rows="1" Columns="5">
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10,12" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Winsat.CpuText}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryInkBrush}"/>
                                        <TextBlock Text="處理器" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10,12" Margin="4,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Winsat.MemoryText}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryInkBrush}"/>
                                        <TextBlock Text="記憶體" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10,12" Margin="4,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Winsat.GraphicsText}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryInkBrush}"/>
                                        <TextBlock Text="圖形" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10,12" Margin="4,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Winsat.D3DText}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryInkBrush}"/>
                                        <TextBlock Text="遊戲繪圖" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10,12" Margin="4,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Winsat.DiskText}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryInkBrush}"/>
                                        <TextBlock Text="主硬碟" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:FieldRow Grid.Column="0" Label="評分日期" Value="{Binding Winsat.AssessedText}"/>
                                <local:FieldRow Grid.Column="1" Label="記憶體頻寬" Value="{Binding Winsat.MemBandwidthText}"/>
                                <local:FieldRow Grid.Column="2" Label="磁碟吞吐" Value="{Binding Winsat.DiskThroughputText}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{Binding Winsat.StatusLine}"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,10,0,4" TextWrapping="Wrap"
                       Text="WinSAT 為 Windows 內建評分（1.0–9.9），基礎分取各子項最低值。重新評分需數分鐘；遠端桌面或無圖形環境下 D3D／遊戲項可能略過，屬正常。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
