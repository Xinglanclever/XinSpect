<UserControl x:Class="XinSpect.ChipsetAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel MaxWidth="1100">
            <!-- 標題列 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="晶片組分析" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                <Button Grid.Column="1" Style="{StaticResource ToolButton}" Content="重新分析"
                        Click="Refresh_Click"/>
            </Grid>

            <!-- 載入中 / 錯誤 -->
            <TextBlock Text="正在分析…" FontSize="14"
                       Foreground="{DynamicResource SecondaryInkBrush}"
                       Visibility="{Binding ChipsetAnalysis.IsLoading, Converter={StaticResource BoolToVis}}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{Binding ChipsetAnalysis.ErrorMessage}" FontSize="14"
                       Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap"
                       Visibility="{Binding ChipsetAnalysis.ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                       Margin="0,0,0,8"/>

            <!-- 總覽 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding ChipsetAnalysis.Summary}" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                </StackPanel>
            </Border>

            <!-- ==== 晶片組基本資訊 ==== -->
            <TextBlock Text="晶片組識別" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="晶片組" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ChipsetAnalysis.ChipsetName}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>

                    <TextBlock Grid.Row="1" Text="廠商" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChipsetAnalysis.ChipsetVendor}" FontSize="13"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>

                    <TextBlock Grid.Row="2" Text="Host Bridge" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChipsetAnalysis.HostBridgeName}" FontSize="13"
                               TextWrapping="Wrap" Foreground="{DynamicResource PrimaryInkBrush}"/>
                </Grid>
            </Border>

            <!-- ==== 北橋 (已整合至 CPU) ==== -->
            <TextBlock Text="北橋 / CPU 整合" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <TextBlock Text="{Binding ChipsetAnalysis.NorthbridgeInfo}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryInkBrush}" LineHeight="22"/>
            </Border>

            <!-- ==== 南橋 (PCH) ==== -->
            <TextBlock Text="南橋 / PCH" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <TextBlock Text="{Binding ChipsetAnalysis.SouthbridgeInfo}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryInkBrush}" LineHeight="22"/>
            </Border>

            <!-- ==== 功能詳細 ==== -->
            <TextBlock Text="晶片組功能一覽" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
                <DataGrid ItemsSource="{Binding ChipsetAnalysis.Features}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                          BorderThickness="0" Background="Transparent"
                          RowBackground="Transparent" AlternatingRowBackground="{DynamicResource SurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="類別" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="規格" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
