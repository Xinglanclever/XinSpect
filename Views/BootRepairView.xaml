<UserControl x:Class="XinSpect.BootRepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="0,0,6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,10">
            <local:SectionHead Text="系統引導修復" HelpKey="bootrepair/系統引導修復"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="執行 Windows 內建的系統修復命令（SFC、DISM、CHKDSK、BootRec、BCDEdit），將即時輸出記錄於下方。多數命令需要以系統管理員身分執行。"/>
        </StackPanel>

        <!-- 權限警告 -->
        <Border x:Name="AdminWarning" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10"
                Visibility="Collapsed">
            <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="13" TextWrapping="Wrap"
                       Text="目前未以系統管理員身分執行。多數修復命令需要提升權限才能成功。"/>
        </Border>

        <!-- 操作按鈕 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
            <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="SFC 掃描" Click="Sfc_Click" Margin="0,0,8,6"/>
                <Button Style="{StaticResource ToolButton}" Content="DISM 修復" Click="Dism_Click" Margin="0,0,8,6"/>
                <Button Style="{StaticResource ToolButton}" Content="CHKDSK 掃描" Click="Chkdsk_Click" Margin="0,0,8,6"/>
                <Button Style="{StaticResource ToolButton}" Content="BootRec 重建" Click="BootRec_Click" Margin="0,0,8,6"/>
                <Button Style="{StaticResource ToolButton}" Content="BCDEdit 檢視" Click="Bcd_Click" Margin="0,0,8,6"/>
                <Button Style="{StaticResource ToolButton}" Content="一鍵全修（SFC→DISM→CHKDSK）" Click="All_Click" Margin="0,0,8,6"/>
                <Button Style="{StaticResource ToolButton}" Content="清除紀錄" Click="Clear_Click" Margin="0,0,8,6"/>
            </WrapPanel>
        </Border>

        <!-- 輸出紀錄 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas, Courier New" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Foreground 必須寫在這裡：ListBox 上的設定會被隱含 TextBlock 樣式
                             蓋掉（樣式 setter 的優先序高於屬性繼承），文字會變次要色。 -->
                        <TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                   Foreground="{DynamicResource PrimaryInkBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
