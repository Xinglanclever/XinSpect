<Window x:Class="XinSpect.SensorAlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自訂感測器警示" Width="1060" Height="790" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" FontSize="13"
        Background="{DynamicResource PagePlaneBrush}" Foreground="{DynamicResource PrimaryInkBrush}">
    <Window.Resources>
        <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="14,5"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="RowHeight" Value="34"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="自訂感測器警示" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"
                       Text="依感測器穩定 ID 與原始單位判定上下限。沿用設定頁的「啟用警示」總開關；通知僅在本機，不自動要求 AI。"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="只採用 Present 且非 Unknown／Speculative 的有限讀值。缺讀、超過 30 秒或單位改變皆為未知；不推定恢復。來源自述不等於校準。" TextWrapping="Wrap" Foreground="{DynamicResource MutedInkBrush}" FontSize="12"/>
            <TextBlock Text="{Binding Service.FilePath}" ToolTip="本機獨立規則檔；最多 256 條。歷程僅保留本次執行最新 200 筆。" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Foreground="{DynamicResource MutedInkBrush}" FontSize="11"/>
            <TextBlock Text="{Binding Service.DisplayConfigurationProblem, Mode=OneWay}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource PrimaryInkBrush}"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="規則與狀態">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                    <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Service.Statuses}" SelectionChanged="RuleSelected" MinHeight="150"
                              AutomationProperties.Name="感測器警示規則與狀態">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="規則" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="狀態" Binding="{Binding PhaseText, Mode=OneWay, Converter={StaticResource Lang}}" Width="185"/>
                            <DataGridTextColumn Header="目前值" Binding="{Binding ValueText, Mode=OneWay, Converter={StaticResource Lang}}" Width="100"/>
                            <DataGridTextColumn Header="條件" Binding="{Binding ConditionText, Mode=OneWay, Converter={StaticResource Lang}}" Width="220"/>
                            <DataGridTextColumn Header="原因／來源" Binding="{Binding DisplayDetailText, Mode=OneWay}" Width="*" MinWidth="150"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip"><Setter.Value><TextBlock><Run Text="{Binding SensorId, Mode=OneWay}"/><LineBreak/><Run Text="{Binding Source, Mode=OneWay}"/><LineBreak/><Run Text="{Binding ObservedAtUtc, Mode=OneWay}"/></TextBlock></Setter.Value></Setter></Style></DataGrid.RowStyle>
                    </DataGrid>
                    <GroupBox Grid.Row="1" Header="新增或編輯規則" Margin="0,14,0,0" Foreground="{DynamicResource PrimaryInkBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="名稱 (_N)" Target="{Binding ElementName=NameBox}"/>
                            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,12,8" Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="100"/>
                            <CheckBox Grid.Column="2" Grid.ColumnSpan="2" Content="啟用此規則 (_E)" IsChecked="{Binding RuleEnabled}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryInkBrush}"/>
                            <Label Grid.Row="1" Content="感測器 (_S)" Target="{Binding ElementName=SensorBox}"/>
                            <ComboBox x:Name="SensorBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" MinHeight="32"
                                      ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor, ValidatesOnNotifyDataErrors=True}" DisplayMemberPath="Display"
                                      ToolTip="列出所有已公布感測器；未知項目可設定，取得可採信的新讀值前不判定。"/>
                            <Label Grid.Row="2" Content="判定方向 (_D)" Target="{Binding ElementName=DirectionBox}"/>
                            <ComboBox x:Name="DirectionBox" Grid.Row="2" Grid.Column="1" Margin="0,0,12,8" MinHeight="30" SelectedIndex="{Binding DirectionIndex}">
                                <ComboBoxItem Content="上限（大於或等於）"/><ComboBoxItem Content="下限（小於或等於）"/>
                            </ComboBox>
                            <Label Grid.Row="2" Grid.Column="2" Content="觸發閾值 (_T)" Target="{Binding ElementName=ThresholdBox}"/>
                            <TextBox x:Name="ThresholdBox" Grid.Row="2" Grid.Column="3" Margin="0,0,0,8" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <Label Grid.Row="3" Content="恢復閾值 (_R)" Target="{Binding ElementName=RecoveryBox}"/>
                            <TextBox x:Name="RecoveryBox" Grid.Row="3" Grid.Column="1" Margin="0,0,12,8" Text="{Binding Recovery, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <Label Grid.Row="3" Grid.Column="2" Content="持續秒數 (_U)" Target="{Binding ElementName=DurationBox}"/>
                            <TextBox x:Name="DurationBox" Grid.Row="3" Grid.Column="3" Margin="0,0,0,8" ToolTip="0–86400 秒；連續有效採樣才累積，缺讀後重新計時。" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <Label Grid.Row="4" Content="冷卻秒數 (_C)" Target="{Binding ElementName=CooldownBox}"/>
                            <TextBox x:Name="CooldownBox" Grid.Row="4" Grid.Column="1" Margin="0,0,12,8" ToolTip="0–604800 秒；恢復後再次超限才觸發新事件，冷卻只抑制通知。" Text="{Binding Cooldown, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding SensorDetail, Mode=OneWay, Converter={StaticResource Lang}}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedInkBrush}"/>
                            <StackPanel Grid.Row="5" Grid.ColumnSpan="4">
                                <TextBlock x:Name="ErrorSummary" Text="{Binding DisplayErrorSummary, Mode=OneWay}" TextWrapping="Wrap" Focusable="True" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="新增規則 (_A)" Click="NewRule"/>
                                    <Button Content="儲存規則 (_V)" Click="SaveRule" IsDefault="True"/>
                                    <Button Content="啟用／停用 (_G)" Click="ToggleRule"/>
                                    <Button Content="刪除規則 (_X)" Click="DeleteRule"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="本次執行歷程">
                <DataGrid ItemsSource="{Binding Service.History}" Margin="10" RowHeight="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="本機時間" Binding="{Binding TimeText}" Width="125"/>
                        <DataGridTextColumn Header="規則" Binding="{Binding Name}" Width="145"/>
                        <DataGridTextColumn Header="事件" Binding="{Binding DisplayMessage, Mode=OneWay}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4,7"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
