<Window x:Class="XinSpect.MotionTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="動態與幀時間檢測" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Topmost="True" Background="#808080" Focusable="True"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <!-- 條紋寬 46 px：黑白硬邊界是拖影最容易現形的地方 -->
        <Style x:Key="Stripe" TargetType="Rectangle">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="112"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Text" Value="—"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AA"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="#808080">
        <!-- 頂部說明（不隨背景色改變，永遠壓在半透明底板上才讀得到）-->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"
                Background="#C0161821" CornerRadius="10" Padding="18,12" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="動態與幀時間檢測" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Foreground="#9AA0AA" FontSize="12.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                           Text="← →：移動速度　↑ ↓：背景色　空白鍵：暫停移動　R：重設統計　Esc：離開"/>
            </StackPanel>
        </Border>

        <!-- 三條不同速度的移動條 + 一條靜止參考 -->
        <StackPanel VerticalAlignment="Center">
            <Canvas x:Name="Row0" Height="112" Margin="0,0,0,22" ClipToBounds="True">
                <StackPanel x:Name="Bar0" Orientation="Horizontal">
                    <Rectangle Style="{StaticResource Stripe}" Fill="White"/>
                    <Rectangle Style="{StaticResource Stripe}" Fill="Black"/>
                    <Rectangle Style="{StaticResource Stripe}" Fill="White"/>
                </StackPanel>
            </Canvas>
            <Canvas x:Name="Row1" Height="112" Margin="0,0,0,22" ClipToBounds="True">
                <StackPanel x:Name="Bar1" Orientation="Horizontal">
                    <Rectangle Style="{StaticResource Stripe}" Fill="White"/>
                    <Rectangle Style="{StaticResource Stripe}" Fill="Black"/>
                    <Rectangle Style="{StaticResource Stripe}" Fill="White"/>
                </StackPanel>
            </Canvas>
            <Canvas x:Name="Row2" Height="112" Margin="0,0,0,26" ClipToBounds="True">
                <StackPanel x:Name="Bar2" Orientation="Horizontal">
                    <Rectangle Style="{StaticResource Stripe}" Fill="White"/>
                    <Rectangle Style="{StaticResource Stripe}" Fill="Black"/>
                    <Rectangle Style="{StaticResource Stripe}" Fill="White"/>
                </StackPanel>
            </Canvas>

            <!-- 靜止參考：同一組條紋不動，用來對照移動時邊界糊了多少 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Opacity="0.95">
                <Rectangle Style="{StaticResource Stripe}" Height="56" Fill="White"/>
                <Rectangle Style="{StaticResource Stripe}" Height="56" Fill="Black"/>
                <Rectangle Style="{StaticResource Stripe}" Height="56" Fill="White"/>
            </StackPanel>
            <TextBlock Text="靜止參考" Foreground="#C0FFFFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
        <!-- 底部：實測幀時間。這裡的數字是量到的，不是查表來的顯示器規格 -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30" IsHitTestVisible="False"
                Background="#D0161821" CornerRadius="12" Padding="24,16" MaxWidth="1000">
            <StackPanel>
                <UniformGrid Rows="1" Columns="6">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="AvgText" Style="{StaticResource MetricValue}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="平均間隔"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="RateText" Style="{StaticResource MetricValue}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="推估更新率"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="MaxText" Style="{StaticResource MetricValue}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="最長一幀"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="LongText" Style="{StaticResource MetricValue}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="長幀（≥1.5×中位數）"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="GapText" Style="{StaticResource MetricValue}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="中斷（&gt;500 ms）"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="FrameText" Style="{StaticResource MetricValue}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="已計幀數"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock x:Name="SpeedText" Foreground="#E6E9EF" FontSize="13" Margin="0,16,0,0"
                           HorizontalAlignment="Center" Text="移動速度　—"/>
                <TextBlock Foreground="#9AA0AA" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="移動條用來以肉眼判讀拖影與過衝：邊界後方拖出灰尾＝反應速度不足，出現反相亮／暗邊＝過驅過頭。與下方靜止參考對照最準。"/>
                <TextBlock Foreground="#6B7280" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="幀時間取自合成器每幀回報的時間戳，量的是「本程式實際被畫出來的節奏」，不是顯示器的面板規格；關閉垂直同步、多螢幕不同更新率或系統忙碌都會反映在這些數字上。前 20 幀（開窗抖動）不計入。"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
