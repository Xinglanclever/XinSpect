<UserControl x:Class="XinSpect.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <UserControl.Resources>
        <!-- 搜尋框：與 DiskScanView 的 PathBox 同形，但可輸入 -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="工具箱"/>

            <!-- ===== 工具目錄（曦覽內建 ＋ Windows 內建 ＋ 第三方導向） =====
                 「曦覽內建」那一組不是裝飾：它是這個工具箱與一般「整合包」的分別——
                 先講清楚哪些事本程式自己就做得到，第三方項目再逐一標注曦覽的對應頁與其不足。 -->
            <Border Style="{StaticResource Card}" local:Anim.RevealDelay="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="工具目錄"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="三種來源混編：標「曦覽內建」的由本程式自己完成；Windows 內建工具一鍵開啟；第三方工具一律導向官方下載頁，本程式不內含任何外部執行檔。第三方項目若有對應的內建功能，右側會多一顆「曦覽內建：…」按鈕可直接前往，滑過主按鈕的提示會誠實寫出兩者差在哪。"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                 Text="{Binding Toolbox.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="以空白分隔多個詞彙；全部命中才會列出（例如「ssd 健康」）。名稱、說明、分類、英文別名都在搜尋範圍內。"/>
                        <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"
                                  Foreground="{StaticResource SecondaryInkBrush}"
                                  Content="只看曦覽做得到的"
                                  ToolTip="只留下曦覽自己有做的項目，以及有對應內建功能的第三方工具——用來確認哪些軟體其實不必再裝。"
                                  IsChecked="{Binding Toolbox.OnlyBuiltin, Mode=TwoWay}"/>
                        <Button Grid.Column="2" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                                Content="清除" Click="ClearFilter_Click" ToolTip="清空搜尋詞與篩選"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Toolbox.FilteredGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource FieldLabel}" Foreground="{StaticResource AccentBrush}"/>
                                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,4,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                                                    <Button Style="{StaticResource ToolButton}"
                                                            Content="{Binding Name}" ToolTip="{Binding Tip}"
                                                            Tag="{Binding}" Click="Tool_Click"/>
                                                    <Button Style="{StaticResource ToolButton}" Margin="4,0,0,0"
                                                            Content="{Binding NativeLabel}" ToolTip="{Binding NativeTip}"
                                                            Tag="{Binding}" Click="Native_Click"
                                                            Visibility="{Binding HasNative, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource ToolButton}" Margin="4,0,0,0"
                                                            Content="{Binding SlotLabel}" ToolTip="{Binding SlotTip}"
                                                            Tag="{Binding}" Click="Slot_Click"
                                                            Visibility="{Binding CanSlot, Converter={StaticResource BoolToVis}}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="更換插槽…" Tag="{Binding}" Click="Slot_Click"/>
                                                                <MenuItem Header="開啟所在資料夾" Tag="{Binding}" Click="SlotOpenFolder_Click"/>
                                                                <MenuItem Header="移除插槽" Tag="{Binding}" Click="SlotClear_Click"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Toolbox.FilterSummary}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Toolbox.StatusLine}"/>
                </StackPanel>
            </Border>

            <!-- ===== 螢幕色域（EDID） ===== -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="80">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="螢幕色域"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="自顯示器 EDID 解析 CIE 色度座標，計算色域三角形對 sRGB、Adobe RGB、DCI-P3 三種標準的覆蓋率。"/>

                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldValue}" Text="{Binding Name}" FontSize="16"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding Manufacturer}" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- 三種標準覆蓋率 -->
                                        <UniformGrid Rows="1" Columns="3" Margin="0,12,0,0"
                                                     Visibility="{Binding Valid, Converter={StaticResource BoolToVis}}">
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,5,0">
                                                <StackPanel>
                                                    <TextBlock Text="sRGB" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Text="{Binding SrgbText}" FontSize="22" Margin="0,2,0,0" Foreground="{StaticResource AccentBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="5,0,5,0">
                                                <StackPanel>
                                                    <TextBlock Text="Adobe RGB" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Text="{Binding AdobeText}" FontSize="22" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="5,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="DCI-P3" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Text="{Binding DciText}" FontSize="22" Margin="0,2,0,0" Foreground="{StaticResource PrimaryInkBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding PrimariesText}"
                                                   Visibility="{Binding Valid, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,2,0,0" Text="{Binding WhitePointText}"
                                                   Visibility="{Binding Valid, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,2,0,0" Text="{Binding AreaText}"
                                                   Visibility="{Binding Valid, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Assessment}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Subtitle}" TextWrapping="Wrap"
                               Visibility="{Binding HasNoMonitors, Converter={StaticResource BoolToVis}}"
                               Text="未從系統取得可用的 EDID 色度資訊。遠端桌面、虛擬顯示器或部分螢幕可能不提供，此為正常情形。"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,12,0,4" TextWrapping="Wrap"
                       Text="部分系統工具（如記憶體診斷、磁碟管理）可能要求系統管理員權限；DDU 建議於安全模式下使用。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
