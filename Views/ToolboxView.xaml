<UserControl x:Class="XinSpect.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <UserControl.Resources>
        <!-- 搜尋框：與 DiskScanView 的 PathBox 同形，但可輸入 -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <local:SectionHead Text="工具箱" HelpKey="toolbox/工具箱"/>

            <!-- ===== 工具目錄（Windows 內建 ＋ 第三方導向） =====
                 1.6.2 起這裡不再放曦覽自己的功能按鈕：那些頁面本來就在左側欄與 Ctrl+K 裡，
                 在工具箱再擺一排跳頁鈕只是同一件事出現兩次。自家功能改以不可點的
                 「曦覽內建：X」標籤掛在對應的第三方項目旁，當作「這個你不必再裝」的註記。 -->
            <Border Style="{StaticResource Card}" local:Anim.RevealDelay="0">
                <StackPanel>
                    <local:SectionHead Text="工具目錄" HelpKey="toolbox/工具目錄"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="兩種來源混編：Windows 內建工具一鍵開啟；第三方工具一律導向官方下載頁，本程式不內含任何外部執行檔。會寫韌體、抹碟或改開機結構的項目旁邊掛一枚警告徽章，滑過去看得到最壞情況。若曦覽已經做到同一件事，滑過主按鈕的提示會誠實寫出兩者差在哪（含曦覽做不到的部分）。"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                 Text="{Binding Toolbox.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="以空白分隔多個詞彙；全部命中才會列出（例如「ssd 健康」）。名稱、說明、分類、英文別名都在搜尋範圍內。"/>
                        <Button Grid.Column="1" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                                Content="清除" Click="ClearFilter_Click" ToolTip="清空搜尋詞"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Toolbox.FilteredGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource AccentBrush}"/>
                                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,4,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                                                    <Button Style="{StaticResource ToolButton}"
                                                            Content="{Binding Name}" ToolTip="{Binding Tip}"
                                                            Tag="{Binding}" Click="Tool_Click"/>
                                                    <!-- 危險等級徽章。這個位置原本掛的是「曦覽內建：X」，
                                                         1.9.0 移除：那枚標籤不可點，只是在每一列後面重複「我們也有」。
                                                         換成真的需要警告的東西——會寫韌體、抹碟或改開機結構的工具。 -->
                                                    <Border Margin="4,0,0,0" VerticalAlignment="Center" Padding="8,5"
                                                            CornerRadius="6" Background="{DynamicResource Surface2Brush}"
                                                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.2"
                                                            ToolTip="{Binding RiskTip}"
                                                            Visibility="{Binding HasRisk, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding RiskLabel}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource WarningBrush}"/>
                                                    </Border>
                                                    <Button Style="{StaticResource ToolButton}" Margin="4,0,0,0"
                                                            Content="{Binding SlotLabel}" ToolTip="{Binding SlotTip}"
                                                            Tag="{Binding}" Click="Slot_Click"
                                                            Visibility="{Binding CanSlot, Converter={StaticResource BoolToVis}}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="更換插槽…" Tag="{Binding}" Click="Slot_Click"/>
                                                                <MenuItem Header="開啟所在資料夾" Tag="{Binding}" Click="SlotOpenFolder_Click"/>
                                                                <MenuItem Header="移除插槽" Tag="{Binding}" Click="SlotClear_Click"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Toolbox.FilterSummary}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Toolbox.StatusLine}"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,12,0,4" TextWrapping="Wrap"
                       Text="部分系統工具（如記憶體診斷、磁碟管理）可能要求系統管理員權限；DDU 建議於安全模式下使用。"/>

            <!-- ===== 一鍵裝機（winget 批次安裝；2.1.0 自獨立分頁併入） ===== -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="60">
                <StackPanel DataContext="{Binding Winget}">
                    <local:SectionHead Text="一鍵裝機" HelpKey="toolbox/一鍵裝機"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="勾選軟體後一鍵批次安裝，全程由 Windows 內建的 winget 從官方來源下載；本程式不含任何安裝檔。「硬體工具」分類收錄圖吧風格的檢測工具——多數曦覽已有對應頁面，要不要重複裝由你決定。"/>

                    <WrapPanel Margin="0,0,0,10">
                        <Button Style="{StaticResource ToolButton}" Content="勾選推薦" Margin="0,0,8,6" Click="SelectRec_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="全部勾選" Margin="0,0,8,6"
                                ToolTip="勾選清單裡全部套件（已安裝的不重複裝）——一鍵裝到滿用" Click="SelectAll_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="清除勾選" Margin="0,0,8,6" Click="Clear_Click"/>
                        <!-- Content 的型別是 object，WPF 會忽略其上的 StringFormat，故綁字串屬性 -->
                        <Button Style="{StaticResource PrimaryButton}" Click="Install_Click"
                                IsEnabled="{Binding CanInstall}"
                                FontSize="14.5" FontWeight="SemiBold" Padding="24,10" MinWidth="140"
                                Content="{Binding InstallButtonText}"/>
                    </WrapPanel>

                    <!-- winget 未安裝提示 -->
                    <Border Margin="0,0,0,10" CornerRadius="8" Background="#33E0552E" BorderBrush="#E0552E" BorderThickness="1"
                            Visibility="{Binding NotAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="14,10">
                            <TextBlock Text="未偵測到 winget（應用程式安裝程式）。" Foreground="{DynamicResource PrimaryInkBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource ToolButton}" Content="前往 Microsoft Store 取得" Click="GetWinget_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 狀態 -->
                    <TextBlock Style="{StaticResource Subtitle}" Margin="2,0,0,8"
                               Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>

                    <!-- 分類與套件清單（捲動交由外層頁面 ScrollViewer，不再巢狀內捲） -->
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Name}" FontSize="15" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Packages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4,18,4"
                                                              Foreground="{DynamicResource PrimaryInkBrush}"
                                                              ToolTip="{Binding Id}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryInkBrush}" FontSize="13"/>
                                                                <!-- 「已安裝」只在 winget 認得它已裝時出現；沒有這個字樣不代表沒裝（msstore／手動安裝的它看不到） -->
                                                                <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" VerticalAlignment="Center"
                                                                        Background="#333F8F5B" BorderBrush="#3F8F5B" BorderThickness="1"
                                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding StateText}" FontSize="10"
                                                                               Foreground="{DynamicResource SecondaryInkBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Desc}" Style="{StaticResource FieldLabel}" FontSize="11"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 安裝記錄 -->
                    <Border Margin="0,4,0,0" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                            <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryInkBrush}"
                                     FontFamily="Consolas" FontSize="12" MinHeight="60"
                                     VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
