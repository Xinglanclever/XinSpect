<UserControl x:Class="XinSpect.BsodView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="0,0,6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,10">
            <TextBlock Style="{StaticResource SectionHeader}" Text="藍屏分析"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="掃描系統小型記憶體傾印（%SystemRoot%\Minidump），解析停止代碼與參數並判讀常見原因。深入定位肇事驅動需 WinDbg 符號分析。"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="重新掃描" Click="Scan_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="開啟傾印資料夾" Click="OpenFolder_Click" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="List" Margin="14,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CodeHex}" FontFamily="Consolas" FontSize="15"
                                                           FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryInkBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding TimeText}" FontSize="12"
                                                       Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0"
                                                   Foreground="{StaticResource SecondaryInkBrush}"/>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Params}" FontFamily="Consolas" FontSize="11.5"
                                                       Foreground="{StaticResource MutedInkBrush}"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource MutedInkBrush}">
                                                <Run Text="{Binding FileName, Mode=OneWay}"/><Run Text=" ・ "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" Padding="12,6" CornerRadius="0,0,10,10">
                    <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource SecondaryInkBrush}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
