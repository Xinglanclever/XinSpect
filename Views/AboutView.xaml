<UserControl x:Class="XinSpect.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <UserControl.Resources>
        <!-- 一筆版本紀錄。逐項改動併成單一 TextBlock（ItemsText 已加好項目符號與換行）：
             巢狀 ItemsControl 在外層 ScrollViewer 裡量測成本高，而這裡只是靜態文字。 -->
        <DataTemplate x:Key="ChangeEntryTemplate">
            <Border Margin="0,0,0,12" Padding="12,10" CornerRadius="6"
                    Background="{DynamicResource Surface2Brush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Version}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding DateText}" Style="{StaticResource FieldLabel}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                    <TextBlock Text="{Binding ItemsText}" Style="{StaticResource FieldValue}"
                               TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"
                               Foreground="{DynamicResource SecondaryInkBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <local:SectionHead Text="關於" HelpKey="about/關於"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- 版號由 AboutView.ApplyVersionCopy 從 AppInfo 寫入；XAML 不寫死，
                         否則每次發版都會留一個舊字串在這裡（原本寫死「XinSpect v2.5 Olympus」）。 -->
                    <TextBlock x:Name="VersionTitle" Text="曦覽 XinSpect" FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                    <!-- 品牌標語：原文就是英文，不進翻譯表（英文模式與中文模式都該長這樣）。
                         16 比內文（13–13.5）大一圈，但刻意遠小於標題的 30——它是署名，不是主標。 -->
                    <TextBlock x:Name="BrandTagline" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"
                               LineHeight="21" Foreground="{DynamicResource AccentBrush}">
                        <Run Text="Designed in East Asia"/><LineBreak/>
                        <Run Text="Manufactured for the World"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0"
                               Text="硬體資訊總覽 ・ 即時偵測工具"/>
                    <TextBlock x:Name="VersionMetadata" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"
                               Text="版本 3.09 ・ Ultima XII ・ 便攜單一執行檔"/>

                    <!-- 官方網站：放在版號正下方，一進「關於」就看得到。
                         位址的唯一來源是 AppInfo.OfficialSiteUrl（AppInfoTests 逐檔比對），
                         這裡只決定它長什麼樣子。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="OpenSiteBtn" Style="{StaticResource PrimaryButton}"
                                Padding="20,10" Click="OpenSite_Click"
                                ToolTip="以預設瀏覽器開啟曦覽官方網站（只開啟網頁，不上傳任何資料）">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                    <Path Fill="{DynamicResource AccentInkBrush}"
                                          Data="F1 M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M12,4 C13.6,4 15.1,4.7 16.1,5.9 C15.1,6.6 14.3,7.6 13.8,8.8 C13.2,8.3 12.6,8 12,8 C11.4,8 10.8,8.3 10.2,8.8 C9.7,7.6 8.9,6.6 7.9,5.9 C8.9,4.7 10.4,4 12,4 Z M6.4,6.7 C7.5,7.3 8.3,8.3 8.8,9.6 C8.1,10.4 7.6,11.4 7.5,12.5 H4.2 C4.5,10.2 5.3,8.2 6.4,6.7 Z M17.6,6.7 C18.7,8.2 19.5,10.2 19.8,12.5 H16.5 C16.4,11.4 15.9,10.4 15.2,9.6 C15.7,8.3 16.5,7.3 17.6,6.7 Z M12,10 C13.1,10 14,10.9 14,12 C14,13.1 13.1,14 12,14 C10.9,14 10,13.1 10,12 C10,10.9 10.9,10 12,10 Z M4.2,14.5 H7.5 C7.6,15.6 8.1,16.6 8.8,17.4 C8.3,18.7 7.5,19.7 6.4,20.3 C5.3,18.8 4.5,16.8 4.2,14.5 Z M16.5,14.5 H19.8 C19.5,16.8 18.7,18.8 17.6,20.3 C16.5,19.7 15.7,18.7 15.2,17.4 C15.9,16.6 16.4,15.6 16.5,14.5 Z M12,16 C12.6,16 13.2,16.3 13.8,16.8 C14.3,18 15.1,19 16.1,19.7 C15.1,20.9 13.6,21.6 12,21.6 C10.4,21.6 8.9,20.9 7.9,19.7 C8.9,19 9.7,18 10.2,16.8 C10.8,16.3 11.4,16 12,16 Z"/>
                                </Viewbox>
                                <TextBlock Text="官方網站　↗" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="OfficialSiteText" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,16"/>

                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"
                               Text="曦覽整合系統、處理器、記憶體、主機板、顯示卡與儲存裝置的靜態規格與即時感測資料，於單一介面呈現型號參數、占用率、頻率、記憶體時序與溫度，靈感取自常見硬體檢測工具與 AIDA64。"/>

                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Text="即時感測資料由 LibreHardwareMonitor 提供；靜態規格取自 WMI；記憶體真實時序於背景透過 CPU-Z 讀取；「免費共用」那條 AI 額度的模型由 Cloudflare Workers AI 提供。"/>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,16"/>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="By：Xinglanclever"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryInkBrush}"/>
                        <local:GifImage Grid.Column="1" GifSource="pack://application:,,,/Assets/hug.gif"
                                        Height="72" Stretch="Uniform" Margin="12,0,0,0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        ToolTip="hug"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="JourneyToggle" Content="一段心路歷程　▸"
                                Style="{StaticResource ToolButton}"
                                Padding="10,4"
                                Click="JourneyToggle_Click"/>
                        <Button x:Name="CheckUpdateBtn" Content="檢查更新"
                                Style="{StaticResource ToolButton}"
                                Padding="10,4" Margin="8,0,0,0"
                                Click="CheckUpdate_Click"
                                ToolTip="僅向 GitHub 查詢最新版本號，不上傳本機任何資料"/>
                        <Button x:Name="OpenEncyclopediaBtn" Content="開啟百科（可翻閱）"
                                Style="{StaticResource ToolButton}"
                                Padding="10,4" Margin="8,0,0,0"
                                Click="OpenEncyclopedia_Click"
                                ToolTip="內嵌的完整百科：左側目錄可點、標題有錨點、可找字；完全離線"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateResultText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="UpdateDownloadRow" Visibility="Collapsed" Margin="0,4,0,0"
                               Style="{StaticResource FieldValue}">
                        <Hyperlink Click="OpenReleases_Click">開啟下載頁（GitHub Releases）</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="JourneyText" Visibility="Collapsed" TextWrapping="Wrap"
                               Margin="0,8,0,0" LineHeight="22"
                               Foreground="{DynamicResource SecondaryInkBrush}" FontSize="13.5"><![CDATA[GPT-3 時代，我的程式能力還很青澀，寫出來的程式碼常被人嘲笑。
那時我暗暗發誓：總有一天，我要成為真正的天才程式設計師。
時過境遷，我的水準突飛猛進。曾經困擾我好幾天的問題，如今片刻就能解決；從前想都不敢想的對案，現在也能信手拏來。
偶爾我也會懷疑：今天的成就，是不是借助了太多外力？
今天，我回顧來時的路：
從 GPT-3、GPT-4，
到 GPT-5.3-Codex、Claude Opus 4.6，
再到 GPT-5.6-Sol、Claude Opus 5，
直到如今的 GPT-6-Astra、Claude Fable 5.1。
模型換了一代又一代，Agent 也換了一套又一套，而我的實力始終穩步上升。
想到這裡，我終於釋然：
工具一直在換，不變的是我。
原來，我早就是天才工程師了(壞笑)]]></TextBlock>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,16"/>

                    <!-- 協力模型：五行輪。排法照傳統五行圖（金在正上，順時針木、水、火、土），
                         圖形與幾何在 Controls/FiveElementsWheel.cs，名單在 Models/FiveElements.cs -->
                    <TextBlock Text="五族共和・攜手共進" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="這個程式由多個 AI 模型協力完成。"/>
                    <Grid Margin="0,10,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <local:GifImage GifSource="pack://application:,,,/Assets/bigfish.gif"
                                            Height="160" Stretch="Uniform"
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="&#x2192;" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedInkBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <local:FiveElementsWheel Grid.Column="1" HorizontalAlignment="Center"/>
                    </Grid>

                    <Button Content="查看特殊型號徽章一覽　▸" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,16,0,0"
                            Click="OpenGallery_Click"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0"
                               Text="收錄 8086K・至尊・Xeon・撕裂者・Titan・工程樣品等專屬原創徽章"/>
                </StackPanel>
            </Border>

            <!-- 外部工具能力對照：回答「為什麼不直接接某某工具」 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <local:SectionHead Text="與外部底層工具的對照" HelpKey="about/外部工具對照"/>

                    <TextBlock Text="本程式已經有等價實作的" FontSize="13.5" FontWeight="SemiBold" Margin="0,10,0,4"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" LineHeight="20"
                               Text="LibreHardwareMonitor（就是現行感測器引擎）、RAMSPDToolkit（自製 SMBus SPD 直讀）、Joular Core（RAPL 功耗直讀）、pciex（PCIe 鏈路與資源）、sc-membench（記憶體頻寬與延遲）、pmu-utils／PCM 的核心 PMU（MSR 直讀與 PMC 編程）。"/>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,14,0,10"/>

                    <TextBlock Text="刻意不整合的" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" LineHeight="20"
                               Text="Perfetto（C++／Web 大型專案，與單一執行檔的散佈方式衝突）、Heimdall（多機 gRPC 監控，定位不同）、Silicon Monitor（Rust 無法嵌入）、OSACA（Python 組語靜態分析，受眾極窄）。"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"
                               Text="openSeaChest 是唯一有實質衝突的：它自帶核心驅動做原始 ATA passthrough，而本程式在 1.9.2 刻意改成經過磁碟類別驅動代理的路徑並加上逾時看門狗——因為實測原始 passthrough 會卡死驅動、殺掉整個行程。"/>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,14,0,10"/>

                    <TextBlock Text="現階段到不了的量測" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" LineHeight="20"
                               Text="iMC 逐通道計數器與 CHA／Cbo（mesh／ring）計數器走 MMIO 映射，本程式的唯讀路徑（MSR 與 PCI 設定空間）到不了；PCIe 鏈路訓練歷史、誤碼率與電源狀態轉換次數在標準設定空間裡不存在，那需要 PHY 層的協定分析儀。這些一律明說讀不到，不給猜出來的值。"/>
                </StackPanel>
            </Border>

            <!-- 版本更新紀錄：資料在 Nav/ChangelogCatalog.cs，ItemsSource 於程式碼後置指定 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <local:SectionHead Text="版本更新紀錄" HelpKey="about/版本更新紀錄"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="每一版做了什麼，由新到舊。1.2.0 起的每一條都對得上 Git 紀錄；1.2.0 之前的四個階段在進入版本控制之前，沒有留下逐項紀錄，因此只寫到階段層級——不補一份想像出來的清單。"/>
                    <ItemsControl x:Name="ChangelogRecent" ItemTemplate="{StaticResource ChangeEntryTemplate}"/>
                    <ItemsControl x:Name="ChangelogOlder" Visibility="Collapsed"
                                  ItemTemplate="{StaticResource ChangeEntryTemplate}"/>
                    <Button x:Name="ChangelogToggle" Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Left" Margin="0,2,0,0" Click="ChangelogToggle_Click"/>
                </StackPanel>
            </Border>

            <!-- 第三方授權（U10-UI-0034）：清單由 ThirdPartyNoticesCatalog 從 THIRD-PARTY-NOTICES.md
                 解析（資源優先、檔案其次），不把內容寫死在 XAML——清單改了版面才不會說謊；
                 讀不到時顯示「讀不到」的原因，不用空清單冒充。ItemsSource 於程式碼後置指定。 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <local:SectionHead Text="第三方授權" HelpKey="about/第三方授權"/>
                    <TextBlock x:Name="LicensesIntro" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="LicensesStatus" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <ItemsControl x:Name="LicenseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="4"
                                        Background="{DynamicResource Surface2Brush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Component}" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource PrimaryInkBrush}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding LicenseAndVersion}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 全域鍵盤快捷鍵（U10-UI-0001／ui.keys.map）：清單由 Services/KeyboardShortcutCatalog
                 提供（單一來源），不寫死在 XAML——綁定改了表才不會說謊；
                 Tests/KeyboardShortcutCatalogTests 把表與原始碼的實際綁定釘在一起。
                 盤點結果如實：目前的全域快捷鍵就命令面板這一組，不硬湊。 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <local:SectionHead Text="鍵盤快捷鍵" HelpKey="about/鍵盤快捷鍵"/>
                    <TextBlock x:Name="ShortcutsIntro" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ShortcutList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Keys}" Style="{StaticResource FieldValue}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource FieldLabel}"
                                               TextWrapping="Wrap" Margin="8,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Scope}" Style="{StaticResource FieldLabel}"
                                               TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 意見反饋 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <local:SectionHead Text="意見反饋 ・ 聯絡我們" HelpKey="about/意見反饋 ・ 聯絡我們"/>
                    <local:FieldRow Label="電子郵件" Value="1491895094i@gmail.com"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="34" Height="34" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{DynamicResource PrimaryInkBrush}"
                                          Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="GitHub 開源" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0"
                                       Foreground="{DynamicResource PrimaryInkBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Hyperlink NavigateUri="https://github.com/Xinglanclever/XinSpect"
                                       RequestNavigate="Link_RequestNavigate"
                                       FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       ToolTip="以瀏覽器開啟 GitHub 專案頁">github.com/Xinglanclever/XinSpect</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="歡迎回報問題、提出建議或功能需求；點擊上方連結可直接前往 GitHub 提交 Issue，或來信與我聯絡。"/>
                </StackPanel>
            </Border>

            <!-- 留言建議：直接在程式裡寫、直接送給作者。只送使用者打的字，別的什麼都不送。 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <local:SectionHead Text="留言建議" HelpKey="about/留言建議"/>

                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                               Text="不想開瀏覽器、不想註冊 GitHub 也沒關係，在這裡寫完按上傳就到我這邊了。只會送出你在下面兩個框裡打的字、你自己選擇附加的檔案與版本號——沒有硬體規格、沒有機器識別碼、沒有記錄檔，一個位元都不會夾帶。"/>

                    <!-- 沒網路或作者還沒開收件端點時，整個輸入區停用；按鈕變灰一定要說得出為什麼 -->
                    <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource Surface2Brush}"
                            Visibility="{Binding Feedback.IsAvailable, Converter={StaticResource InverseBoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="{Binding Feedback.UnavailableReason}"/>
                            <Button Grid.Column="1" Content="重新檢查" Style="{StaticResource ToolButton}"
                                    VerticalAlignment="Center" Click="FeedbackRefresh_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel IsEnabled="{Binding Feedback.IsAvailable}">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="你的建議"/>
                        <TextBox Style="{StaticResource SetTextBox}" MaxLength="2000"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Text="{Binding Feedback.Text, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4"
                                   Text="聯絡方式（選填，想收到回覆再填；留空就是匿名）"/>
                        <TextBox Style="{StaticResource SetTextBox}" MaxLength="120"
                                 Text="{Binding Feedback.Contact, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- 附加檔案 -->
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="📎 附加檔案…" Style="{StaticResource ToolButton}"
                                        Click="AddAttachment_Click"
                                        ToolTip="附加圖片或檔案（每個檔案上限 2 MB，最多 5 個）"/>
                                <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Text="{Binding Feedback.AttachmentCount, Converter={x:Static local:LangFormatConverter.Instance}, ConverterParameter='已附加 {0} 個檔案'}"
                                           Visibility="{Binding Feedback.AttachmentCount, Converter={StaticResource CountToVis}}"/>
                            </StackPanel>
                            <ItemsControl x:Name="AttachmentList" Margin="0,6,0,0"
                                          ItemsSource="{Binding Feedback.Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="8,4" CornerRadius="4"
                                                Background="{DynamicResource Surface2Brush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                           Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PrimaryInkBrush}" FontSize="12.5"
                                                           ToolTip="{Binding FileName}"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                                           Foreground="{DynamicResource SecondaryInkBrush}" FontSize="11.5">
                                                    <TextBlock.Text>
                                                        <Binding Path="Data.Length" StringFormat="{}{0:N0} bytes"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <Button Grid.Column="2" Content="✕" Padding="6,2"
                                                        Style="{StaticResource ToolButton}" FontSize="11"
                                                        Tag="{Binding FileName}"
                                                        Click="RemoveAttachment_Click"
                                                        ToolTip="移除這個檔案"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="FeedbackStatus" Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="{Binding Feedback.Status}"/>
                            <Button Grid.Column="1" Content="上傳" Style="{StaticResource PrimaryButton}"
                                    MinWidth="120" Padding="24,10"
                                    IsEnabled="{Binding Feedback.CanSend}" Click="SendFeedback_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 免責聲明 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <local:SectionHead Text="免責聲明" HelpKey="about/免責聲明"/>
                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Text="本軟體採雙授權（dual licensing），適用於所有版本（不限最新版）：兩條路二選一、功能相同：① GNU Affero General Public License, version 3 or later（AGPL-3.0-or-later）——免費，可自由下載、使用、研究、修改、散布與商業使用，但散布修改版或以網路服務提供給他人使用時，須以相同授權公開原始碼；② 商業授權（見 COMMERCIAL-LICENSE.md）——付費，供閉源整合與隨硬體出貨，不觸發原始碼公開義務。軟體按「現狀」提供，所偵測之數值僅供參考，作者不對其準確性作任何明示或默示之擔保，一切使用風險由使用者自負。"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="參考：圖吧工具箱 WinUI3（GitHub：luolangaga/tubatools）、Windows Package Manager（winget）等。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <local:SectionHead Text="功能模組" HelpKey="about/功能模組"/>
                    <local:FieldRow Label="系統總覽" Value="使用率・溫度・作業系統・主機板摘要・一鍵複製規格摘要"/>
                    <local:FieldRow Label="處理器" Value="規格・各核心時脈與負載・封裝溫度・CPU-Z 深度規格・隱形停頓（SMI 與 C-state 駐留）"/>
                    <local:FieldRow Label="記憶體" Value="真實時序・使用量・實體模組・SPD／XMP 深度資料・大頁與位址轉換成本・L3 未命中與 DRAM 實際流量"/>
                    <local:FieldRow Label="主機板" Value="晶片組・BIOS／UEFI・PCIe 連結・LPCIO 超級 I/O"/>
                    <local:FieldRow Label="顯示卡" Value="時脈・使用率・顯示記憶體・溫度・CPU-Z 深度規格"/>
                    <local:FieldRow Label="顯示卡超頻" Value="NVML 功耗／風扇／溫度上限・NVAPI 核心與記憶體時脈偏移"/>
                    <local:FieldRow Label="系統風扇" Value="主機板／Super I/O 可控風扇手動調速・一鍵還原自動（真實寫入）"/>
                    <local:FieldRow Label="儲存裝置" Value="容量・溫度・S.M.A.R.T. 剩餘壽命"/>
                    <local:FieldRow Label="網路" Value="網路介面・連線速率・即時上下行流量"/>
                    <local:FieldRow Label="感測器" Value="所有感測器讀值・最小・最大"/>
                    <local:FieldRow Label="效能" Value="棋類跑分（中國象棋／西洋棋 perft・自我驗證）・綜合測試・CPU 烤機・GPU 燒機（FurMark＋原生監測）・WinSAT"/>
                    <local:FieldRow Label="健康" Value="狀態燈・綜合分數・溫度與容量警示・開機耗時分解・這台機器多老了"/>
                    <local:FieldRow Label="AI 評價" Value="本機免費 Ollama 或 OpenAI 相容 API・客觀評價・可自訂提示詞"/>
                    <local:FieldRow Label="一鍵裝機" Value="併入「工具箱」頁：勾選推薦／全部勾選後由 winget 批次安裝，含硬體工具分類"/>
                    <local:FieldRow Label="工具箱" Value="Windows 系統工具一鍵開啟＋八十餘款硬體工具官方下載捷徑（不內含任何外部執行檔）；會寫韌體、整碟抹除或改開機結構的項目掛警告徽章並寫明最壞情況"/>
                    <local:FieldRow Label="實用工具" Value="硬體檢測（螢幕壞點／灰階／棋盤／滑鼠／鍵盤／喇叭／動態）・螢幕色域（EDID 覆蓋率＋2D 色度圖）・連接埠占用・Hosts 編輯・藍屏分析・垃圾清理・電池分析・右鍵選單・網速測試・記憶體整理・開機啟動項・DNS 切換・大檔掃描・驅動稽核・幀時間監測・DPC 延遲與中斷歸屬・PCIe 鏈路・USB 鏈路・NVMe 電源狀態・顯示鏈路真相・睡眠與喚醒・網卡進階屬性・Windows 授權"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
