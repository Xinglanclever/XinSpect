<UserControl x:Class="XinSpect.ComputeChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <!-- BoolToVis 由 Themes/Theme.xaml 全域提供，這裡不再重複宣告（兩份來源容易日後改錯邊） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
            <StackPanel Margin="2,0,0,10">
                <local:SectionHead Text="算力圖" HelpKey="computechart/算力圖"/>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="把處理器、記憶體、顯示卡、儲存、NPU 的跑分數字統一正規化為 0–100 長條，一眼看出這台機器各維度的相對強弱。數字來自其他頁面已執行的測試——沒跑過的維度不會顯示。"/>
            </StackPanel>

            <!-- 操作列 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="重新整理" Click="Refresh_Click"/>
                    <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource SecondaryInkBrush}"/>
                </StackPanel>
            </Border>

            <!-- 尚無數據提示 -->
            <Border x:Name="EmptyCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"
                           Text="尚無跑分數據——請先到「綜合跑分」、「磁碟測試」等頁面執行至少一項測試，再回來查看算力圖。"/>
            </Border>

            <!-- 算力長條圖 -->
            <Border x:Name="ChartCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <local:SectionHead Text="各維度算力" HelpKey="computechart/各維度算力"/>
                    <ItemsControl x:Name="ChartItems" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 維度名稱 -->
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{DynamicResource PrimaryInkBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- 色條 -->
                                    <Grid Grid.Column="1" Margin="8,0">
                                        <!-- 底色軌道 -->
                                        <Border CornerRadius="5" Height="22"
                                                Background="{DynamicResource Surface2Brush}"/>
                                        <!-- 填色條 -->
                                        <Border x:Name="Bar" CornerRadius="5" Height="22"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentBrush}">
                                            <Border.Width>
                                                <MultiBinding Converter="{x:Static local:BarWidthConverter.Instance}">
                                                    <Binding Path="BarFraction"/>
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                    <!-- 分數 -->
                                    <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat={}{0:0}}" FontSize="13"
                                               FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right"
                                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                                    <!-- 原始值 -->
                                    <TextBlock Grid.Column="3" Text="{Binding RawText}" FontSize="11.5" Margin="10,0,0,0"
                                               VerticalAlignment="Center" MinWidth="100"
                                               Foreground="{DynamicResource SecondaryInkBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 圖例 -->
            <Border x:Name="LegendCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <local:SectionHead Text="滿分參考值" HelpKey="computechart/滿分參考值"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="分數 100 對應的參考上限（只是視覺基準，不是上不封頂的絕對極限）："/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="22"
                               Text="處理器單核 2,000 MOPS ‧ 處理器多核 40,000 MOPS ‧ 記憶體頻寬 100 GB/s ‧ 顯示卡算力 100 TFLOPS ‧ 儲存循序讀取 7,000 MB/s ‧ 儲存循序寫入 5,000 MB/s ‧ NPU 50 TOPS"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
