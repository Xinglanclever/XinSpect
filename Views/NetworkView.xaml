<UserControl x:Class="XinSpect.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <local:SectionHead Text="網路" HelpKey="network/網路"/>

            <!-- 即時總流量 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="總下行"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Net.TotalDownText}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryInkBrush}" Margin="0,2,0,6"/>
                        <local:HistoryGraph Height="88" History="{Binding Net.TotalDown}"
                                            Stroke="{DynamicResource AccentBrush}" Caption="下行 (B/s)" ShowValue="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource GoodBrush}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="總上行"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Net.TotalUpText}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryInkBrush}" Margin="0,2,0,6"/>
                        <local:HistoryGraph Height="88" History="{Binding Net.TotalUp}"
                                            Stroke="{DynamicResource GoodBrush}" Caption="上行 (B/s)" ShowValue="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 已安裝實體網路卡（含未連線者，WMI Win32_NetworkAdapter） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="20"
                    Visibility="{Binding HasInstalledNics, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="已安裝網路卡（實體）" HelpKey="network/已安裝網路卡（實體）"/>
                    <ItemsControl ItemsSource="{Binding InstalledNics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <local:BrandBadge Kind="Net" EmblemSize="30" ShowModel="False"
                                                          Brand="{Binding Brand}" Model="{Binding Name}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <local:FieldRow Label="名稱" Value="{Binding Name}"/>
                                                <local:FieldRow Label="製造商" Value="{Binding Manufacturer}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <local:FieldRow Label="類型" Value="{Binding TypeText}"/>
                                                <local:FieldRow Label="額定速度" Value="{Binding SpeedText}"/>
                                                <local:FieldRow Label="實體位址 (MAC)" Value="{Binding Mac}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 各介面卡 -->
            <local:SectionHead Text="運作中介面（即時流量）" HelpKey="network/運作中介面（即時流量）" Margin="2,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Net.Adapters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" local:Anim.RevealDelay="40">
                            <StackPanel>
                                <local:BrandBadge Kind="Net" EmblemSize="40" ShowModel="False"
                                                  Model="{Binding Name}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <local:FieldRow Label="介面名稱" Value="{Binding Name}"/>
                                        <local:FieldRow Label="類型" Value="{Binding TypeText}"/>
                                        <local:FieldRow Label="描述" Value="{Binding Description}"/>
                                        <local:FieldRow Label="連線速度" Value="{Binding LinkSpeedText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <local:FieldRow Label="IPv4" Value="{Binding Ipv4}"/>
                                        <local:FieldRow Label="IPv6" Value="{Binding Ipv6}"/>
                                        <local:FieldRow Label="實體位址 (MAC)" Value="{Binding Mac}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <local:FieldRow Label="預設閘道" Value="{Binding Gateway}"/>
                                        <local:FieldRow Label="子網路遮罩" Value="{Binding SubnetMask}"/>
                                        <local:FieldRow Label="DNS 伺服器" Value="{Binding Dns}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <local:FieldRow Label="DHCP" Value="{Binding DhcpText}"/>
                                        <local:FieldRow Label="DNS 尾碼" Value="{Binding DnsSuffix}"/>
                                        <local:FieldRow Label="MTU" Value="{Binding MtuText}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="下行  "/>
                                            <TextBlock Text="{Binding DownText}" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <local:HistoryGraph Height="62" History="{Binding DownHistory}"
                                                            Stroke="{DynamicResource AccentBrush}" ShowValue="False"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="上行  "/>
                                            <TextBlock Text="{Binding UpText}" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <local:HistoryGraph Height="62" History="{Binding UpHistory}"
                                                            Stroke="{DynamicResource GoodBrush}" ShowValue="False"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,2,0,0"
                       Text="僅列出運作中且非回送 / 通道的介面；流量為每秒累計位元組差值換算。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
