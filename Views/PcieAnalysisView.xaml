<UserControl x:Class="XinSpect.PcieAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel MaxWidth="1100">
            <!-- 標題列 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PCIe 分析" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                <Button Grid.Column="1" Style="{StaticResource ToolButton}" Content="重新分析"
                        Click="Refresh_Click"/>
            </Grid>

            <!-- 載入中 / 錯誤 -->
            <TextBlock Text="正在分析…" FontSize="14"
                       Foreground="{DynamicResource SecondaryInkBrush}"
                       Visibility="{Binding PcieAnalysis.IsLoading, Converter={StaticResource BoolToVis}}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{Binding PcieAnalysis.ErrorMessage}" FontSize="14"
                       Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap"
                       Visibility="{Binding PcieAnalysis.ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                       Margin="0,0,0,8"/>

            <!-- 總覽 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <TextBlock Text="{Binding PcieAnalysis.Summary}" FontSize="14" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryInkBrush}"/>
            </Border>

            <!-- ==== 裝置清單 ==== -->
            <TextBlock Text="PCIe 裝置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding PcieAnalysis.Slots}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                          BorderThickness="0" Background="Transparent"
                          RowBackground="Transparent" AlternatingRowBackground="{DynamicResource SurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="裝置" Binding="{Binding DeviceName}" Width="220"/>
                        <DataGridTextColumn Header="位置" Binding="{Binding LocationLabel}" Width="160"/>
                        <DataGridTextColumn Header="協商鏈路" Binding="{Binding NegotiatedLabel}" Width="100"/>
                        <DataGridTextColumn Header="能力鏈路" Binding="{Binding CapableLabel}" Width="100"/>
                        <DataGridTextColumn Header="協商頻寬" Binding="{Binding NegotiatedBwLabel}" Width="110"/>
                        <DataGridTextColumn Header="能力頻寬" Binding="{Binding CapableBwLabel}" Width="110"/>
                        <DataGridTextColumn Header="拆分" Binding="{Binding SplitDescription}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ==== PCIe 世代參考表 ==== -->
            <TextBlock Text="PCIe 世代參考" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,16">
                <DataGrid ItemsSource="{x:Static local:PcieAnalysisService.GenReferences}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                          BorderThickness="0" Background="Transparent"
                          RowBackground="Transparent" AlternatingRowBackground="{DynamicResource SurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="世代" Binding="{Binding Name}" Width="70"/>
                        <DataGridTextColumn Header="傳輸率 (GT/s)" Binding="{Binding TransferRateGTs}" Width="110"/>
                        <DataGridTextColumn Header="編碼" Binding="{Binding Encoding}" Width="140"/>
                        <DataGridTextColumn Header="x1 頻寬 (MB/s)" Width="120">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0:N0}">
                                    <Binding Path="TransferRateGTs"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ==== 通道分配 ==== -->
            <TextBlock Text="通道分配" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="8"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="CPU 通道" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryInkBrush}"/>
                    <ProgressBar Grid.Column="1" Minimum="0"
                                 Maximum="{Binding PcieAnalysis.TotalCpuLanes}"
                                 Value="{Binding PcieAnalysis.UsedCpuLanes, Mode=OneWay}"
                                 Height="18" Margin="8,0"/>
                    <TextBlock Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryInkBrush}">
                        <Run Text="{Binding PcieAnalysis.UsedCpuLanes, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding PcieAnalysis.TotalCpuLanes, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Text="PCH 通道" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryInkBrush}"/>
                    <ProgressBar Grid.Row="2" Grid.Column="1" Minimum="0"
                                 Maximum="{Binding PcieAnalysis.TotalChipsetLanes}"
                                 Value="{Binding PcieAnalysis.UsedChipsetLanes, Mode=OneWay}"
                                 Height="18" Margin="8,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryInkBrush}">
                        <Run Text="{Binding PcieAnalysis.UsedChipsetLanes, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding PcieAnalysis.TotalChipsetLanes, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 通道分配明細 -->
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
                <DataGrid ItemsSource="{Binding PcieAnalysis.LaneMap}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                          BorderThickness="0" Background="Transparent"
                          RowBackground="Transparent" AlternatingRowBackground="{DynamicResource SurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="裝置" Binding="{Binding DeviceName}" Width="280"/>
                        <DataGridTextColumn Header="BUS" Binding="{Binding BusNumber, StringFormat=X2}" Width="60"/>
                        <DataGridTextColumn Header="通道數" Binding="{Binding NegotiatedWidth}" Width="70"/>
                        <DataGridTextColumn Header="來源" Binding="{Binding SourceLabel}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
