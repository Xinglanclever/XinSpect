<UserControl x:Class="XinSpect.FanControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- ══ 深色滑桿（沿用超頻分頁風格）═══════════════════════════════════════ -->
        <Style x:Key="GpuSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="3" Background="{StaticResource HairlineBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3" Background="{StaticResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White"
                                                         Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ══ 深色核取方塊 ═══════════════════════════════════════════════════ -->
        <Style x:Key="GpuCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1.2">
                                <Path x:Name="check" Width="12" Height="12" Stretch="Uniform"
                                      Data="M2,8 L6,12 L14,3" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
            <!-- 標題 -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <TextBlock Style="{StaticResource Title}" Text="系統風扇控制"/>
                <Border Background="{StaticResource WarningBrush}" CornerRadius="5" Padding="7,2" Margin="12,3,0,0" VerticalAlignment="Center">
                    <TextBlock Text="真實寫入硬體" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Subtitle}" Margin="2,0,0,14"
                       Text="與其餘感測共用同一套檢測引擎（LibreHardwareMonitor）。顯示卡風扇請至「顯示卡超頻」分頁調整。"/>

            <!-- 安全說明 + 全域動作 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="安全須知"/>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SecondaryInkBrush}"
                               Text="調整風扇轉速為真實寫入主機板控制器。轉速過低可能使機殼／處理器溫度上升，請一邊觀察溫度一邊調整。切換分頁或關閉程式時，所有手動接管的風扇都會自動交回 BIOS 控制。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="AllowLow" Style="{StaticResource GpuCheck}" Content="允許低於 20%（可能造成過熱，後果自負）"/>
                        <Button Style="{StaticResource ToolButton}" Content="全部還原自動" Click="RestoreAll_Click"
                                Margin="18,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 曲線總控：狀態、樣板一鍵套用、全部停用 -->
            <Border x:Name="CurveBar" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="轉速曲線"/>
                        <TextBlock x:Name="CurveStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SecondaryInkBrush}"
                               Text="啟用後由曲線每秒依溫度自動調速，切到其他分頁仍持續生效。畫布上可直接拖動控制點、空白處雙擊新增、右鍵移除。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="AllowStop" Style="{StaticResource GpuCheck}"
                                  Content="允許曲線低於 20 %（含停轉，後果自負）"
                                  Checked="AllowStop_Changed" Unchecked="AllowStop_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="全部套用樣板" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ToolButton}" Content="靜音" Tag="0" Click="PresetAll_Click" Margin="10,0,0,0"/>
                        <Button Style="{StaticResource ToolButton}" Content="均衡" Tag="1" Click="PresetAll_Click" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource ToolButton}" Content="效能" Tag="2" Click="PresetAll_Click" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource ToolButton}" Content="全部停用曲線" Click="DisableCurves_Click" Margin="18,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 空狀態 -->
            <Border x:Name="Empty" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="狀態"/>
                    <TextBlock x:Name="EmptyText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{StaticResource SecondaryInkBrush}"/>
                </StackPanel>
            </Border>

            <!-- 風扇清單 -->
            <ItemsControl x:Name="FanList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Name}"/>
                                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="5" Padding="7,1" Margin="10,1,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Fan.ModeText}" FontSize="11" Foreground="{StaticResource SecondaryInkBrush}"/>
                                        </Border>
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="7,1" Margin="8,1,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="11.5" Text="{Binding Fan.Location}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="目前輸出" VerticalAlignment="Bottom"/>
                                        <TextBlock Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14"
                                                   VerticalAlignment="Bottom" Text="{Binding Fan.CurrentText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="轉速" VerticalAlignment="Bottom"/>
                                        <TextBlock Margin="8,0,0,0" Foreground="{StaticResource PrimaryInkBrush}" FontWeight="SemiBold" FontSize="14"
                                                   VerticalAlignment="Bottom" Text="{Binding Fan.RpmText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="手動目標"/>
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14"
                                               Text="{Binding Fan.SetPoint, StringFormat={}{0:0} %}"/>
                                </Grid>
                                <Slider Style="{StaticResource GpuSlider}" Minimum="0" Maximum="100"
                                        Value="{Binding Fan.SetPoint, Mode=TwoWay}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="套用" Click="Apply_Click" Tag="{Binding Fan}"/>
                                    <Button Style="{StaticResource ToolButton}" Content="還原自動" Click="Restore_Click" Tag="{Binding Fan}" Margin="10,0,0,0"/>
                                </StackPanel>

                                <!-- 轉速曲線：啟用、溫度來源、遲滯、可拖動畫布 -->
                                <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,16,0,0"/>
                                <Grid Margin="0,14,0,0">
                                    <CheckBox Style="{StaticResource GpuCheck}" Content="以曲線自動調速"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5"
                                               Foreground="{StaticResource AccentBrush}" Text="{Binding TargetText}"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="溫度來源" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Margin="10,0,0,0"
                                              ItemsSource="{Binding Source={x:Static local:FanCurve.SourceNames}}"
                                              SelectedIndex="{Binding SourceIndex, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="遲滯" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="4" Style="{StaticResource GpuSlider}" Margin="10,0,0,0"
                                            Minimum="0" Maximum="15" Value="{Binding Hysteresis, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="5" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                                               Foreground="{StaticResource PrimaryInkBrush}" FontWeight="SemiBold"
                                               Text="{Binding Hysteresis, StringFormat={}{0:0} °C}"/>
                                </Grid>
                                <local:FanCurveEditor Margin="0,12,0,0" Curve="{Binding}"
                                                      Temp="{Binding LiveTempC}" Output="{Binding Fan.CurrentPercent}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="套用樣板" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource ToolButton}" Content="靜音" Tag="0" Click="Preset_Click" Margin="10,0,0,0"/>
                                    <Button Style="{StaticResource ToolButton}" Content="均衡" Tag="1" Click="Preset_Click" Margin="8,0,0,0"/>
                                    <Button Style="{StaticResource ToolButton}" Content="效能" Tag="2" Click="Preset_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
