<UserControl x:Class="XinSpect.OsAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <UserControl.Resources>
        <DataTemplate x:Key="OsFactTemplate">
            <Grid MinHeight="26" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{Binding Key}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap"
                               Foreground="{Binding Sev, Converter={StaticResource SeverityToBrush}}"
                               Text="{Binding Value}"/>
                    <TextBlock Style="{StaticResource Subtitle}" TextWrapping="Wrap"
                               Visibility="{Binding Note, Converter={StaticResource TextToVis}}"
                               Text="{Binding Note}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,0,6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,10">
            <local:SectionHead Text="作業系統分析" HelpKey="osanalysis/作業系統分析"/>
            <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="版本、組建、授權、更新與安全態勢，收攏在一頁。全程唯讀（WMI／登錄檔／韌體變數），不改動任何系統設定。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <local:SectionHead Text="總覽"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="重新掃描"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="Refresh_Click" IsEnabled="{Binding OsAnalysis.CanRefresh}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{Binding OsAnalysis.Summary}"/>
                        <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{Binding OsAnalysis.Status}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <local:SectionHead Text="系統身分"/>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding OsAnalysis.Identity}"
                                      ItemTemplate="{StaticResource OsFactTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <local:SectionHead Text="授權"/>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding OsAnalysis.Activation}"
                                      ItemTemplate="{StaticResource OsFactTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <local:SectionHead Text="更新"/>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding OsAnalysis.Updates}"
                                      ItemTemplate="{StaticResource OsFactTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <local:SectionHead Text="安全態勢"/>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding OsAnalysis.Security}"
                                      ItemTemplate="{StaticResource OsFactTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
