<UserControl x:Class="XinSpect.UsbLinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <StackPanel Margin="2,0,0,10">
                <local:SectionHead Text="USB 鏈路真相" HelpKey="usb/USB 鏈路真相"/>
                <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="直接問每個 USB 集線器，把「這個埠支援什麼協定」、「裝置自己宣告的能力」與「現在真的跑在什麼速度」擺在一起比。支援 10 Gb/s 的外接 SSD 只跑 480 Mb/s，在檔案總管裡看不出來——這裡還會分清是插錯埠還是線材只有 2.0。全程唯讀查詢，不重設埠、不改電源狀態。"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="掃描" HelpKey="usb/掃描"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="重新掃描"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="Refresh_Click" IsEnabled="{Binding UsbLink.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding UsbLink.Summary}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding UsbLink.TopologyText}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding UsbLink.Status}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="132"/><ColumnDefinition Width="104"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="裝置"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="目前速度"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="裝置能力"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="埠支援"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding UsbLink.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 縮排＝拓樸：掛在外接集線器底下的裝置往右一格，看得出誰接在誰上面 -->
                                <StackPanel x:Name="Row" Margin="0,2,0,4">
                                    <Grid MinHeight="24" Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="132"/>
                                            <ColumnDefinition Width="132"/><ColumnDefinition Width="104"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding OperatingText}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding CapableText}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding PortText}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" FontSize="11" TextWrapping="Wrap"
                                               Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}"
                                               Text="{Binding DetailText}"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" FontSize="11" TextWrapping="Wrap"
                                               Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}"
                                               Text="{Binding Verdict}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
