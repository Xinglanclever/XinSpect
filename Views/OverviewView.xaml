<UserControl x:Class="XinSpect.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <UserControl.Resources>
        <!-- ═══ 磁貼樣板 ═══
             資源鍵固定為 Tile.{識別碼}，由 DashboardTileTemplateSelector 依磁貼身分查表取用；
             新增一塊磁貼＝在 DashboardLayout.Catalog 加一筆、在這裡補一個同名樣板，版面碼不必動。
             樣板的 DataContext 是磁貼本身，所以根元素改綁 Vm，內層才能沿用原本的繫結路徑。 -->

        <DataTemplate x:Key="Tile.gauges">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <UniformGrid Rows="1" Columns="4">
                    <local:RadialGauge Caption="CPU 使用率" Unit="%"
                                       Value="{Binding Live.CpuLoad, FallbackValue=0, TargetNullValue=0}"
                                       ArcBrush="{Binding Live.CpuLoadSeverity, Converter={StaticResource SeverityToBrush}}"/>
                    <local:RadialGauge Caption="CPU 溫度" Unit="°C" Max="100"
                                       Value="{Binding Live.CpuTemp, FallbackValue=0, TargetNullValue=0}"
                                       ArcBrush="{Binding Live.CpuTempSeverity, Converter={StaticResource SeverityToBrush}}"/>
                    <local:RadialGauge Caption="記憶體使用率" Unit="%"
                                       Value="{Binding Live.MemLoad, FallbackValue=0, TargetNullValue=0}"
                                       ArcBrush="{Binding Live.MemLoadSeverity, Converter={StaticResource SeverityToBrush}}"/>
                    <local:RadialGauge Caption="GPU 使用率" Unit="%"
                                       Value="{Binding Live.PrimaryGpu.LoadPercent, FallbackValue=0, TargetNullValue=0}"/>
                </UniformGrid>
            </Border>
        </DataTemplate>

        <!-- 七段數字面板：遠一點也讀得到的大字。off 段保留為極淡的殘影，所以數字不會跳位。 -->
        <DataTemplate x:Key="Tile.digits">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="數字面板" HelpKey="overview/數字面板"/>
                    <UniformGrid Rows="1" Columns="4" Margin="0,12,0,0">
                        <StackPanel>
                            <local:OutlineDigits DigitHeight="48" HorizontalAlignment="Left"
                                                 Text="{Binding Live.CpuLoad, StringFormat={}{0:0}, FallbackValue=--, TargetNullValue=--}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CPU 使用率 %" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <local:OutlineDigits DigitHeight="48" HorizontalAlignment="Left"
                                                 Foreground="{Binding Live.CpuTempSeverity, Converter={StaticResource SeverityToBrush}}"
                                                 Text="{Binding Live.CpuTemp, StringFormat={}{0:0}, FallbackValue=--, TargetNullValue=--}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="封裝溫度 °C" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <local:OutlineDigits DigitHeight="48" HorizontalAlignment="Left"
                                                 Text="{Binding Live.CpuPowerW, StringFormat={}{0:0}, FallbackValue=--, TargetNullValue=--}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="封裝功耗 W" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <local:OutlineDigits DigitHeight="48" HorizontalAlignment="Left"
                                                 Text="{Binding Live.MemLoad, StringFormat={}{0:0}, FallbackValue=--, TargetNullValue=--}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="記憶體使用率 %" Margin="0,5,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="「--」代表這台機器沒有這項讀值（多為缺少驅動權限或平台未暴露該感測），不是 0。"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Tile.trends">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="即時走勢（近 90 秒）" HelpKey="overview/即時走勢（近 90 秒）"/>
                    <UniformGrid Rows="1" Columns="4">
                        <local:HistoryGraph Height="104" Margin="0,0,6,0" Caption="CPU 使用率"
                                            History="{Binding CpuLoadHist}" Stroke="{DynamicResource AccentBrush}"/>
                        <local:HistoryGraph Height="104" Margin="3,0,3,0" Caption="CPU 溫度"
                                            History="{Binding CpuTempHist}" Stroke="{DynamicResource SeriousBrush}"/>
                        <local:HistoryGraph Height="104" Margin="3,0,3,0" Caption="記憶體"
                                            History="{Binding MemHist}" Stroke="{DynamicResource GoodBrush}"/>
                        <local:HistoryGraph Height="104" Margin="6,0,0,0" Caption="GPU 使用率"
                                            History="{Binding GpuHist}" Stroke="{DynamicResource WarningBrush}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 預設不顯示：想看頻率與顯示記憶體的人自己打開，總覽第一眼仍以四項主指標為主 -->
        <DataTemplate x:Key="Tile.trends2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="更多走勢（近 90 秒）" HelpKey="overview/更多走勢（近 90 秒）"/>
                    <UniformGrid Rows="1" Columns="3">
                        <local:HistoryGraph Height="104" Margin="0,0,6,0" Caption="CPU 頻率"
                                            History="{Binding CpuClockHist}" Stroke="{DynamicResource GoodBrush}"/>
                        <local:HistoryGraph Height="104" Margin="3,0,3,0" Caption="GPU 溫度"
                                            History="{Binding GpuTempHist}" Stroke="{DynamicResource SeriousBrush}"/>
                        <local:HistoryGraph Height="104" Margin="6,0,0,0" Caption="顯示記憶體"
                                            History="{Binding GpuVramHist}" Stroke="{DynamicResource AccentBrush}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Tile.brands">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="硬體識別" HelpKey="overview/硬體識別"/>
                    <UniformGrid Columns="2" Rows="2">
                        <local:BrandBadge Margin="0,8,12,8" Kind="Cpu" EmblemSize="46"
                                          Brand="{Binding Cpu.Brand}" Model="{Binding Cpu.Name}"
                                          CpuModel="{Binding Cpu.Name}"/>
                        <local:BrandBadge Margin="0,8,0,8" Kind="Gpu" EmblemSize="46"
                                          Brand="{Binding Live.PrimaryGpu.Brand, FallbackValue={x:Static local:Brand.Unknown}}"
                                          Model="{Binding Live.PrimaryGpu.Name, FallbackValue=未偵測到顯示卡}"/>
                        <local:BrandBadge Margin="0,8,12,8" Kind="Board" EmblemSize="46"
                                          Brand="{Binding System.BoardBrand}" Model="{Binding System.BoardModel}"/>
                        <local:BrandBadge Margin="0,8,0,8" Kind="Ram" EmblemSize="46"
                                          Brand="{Binding Modules[0].Brand, FallbackValue={x:Static local:Brand.Unknown}}"
                                          Model="{Binding Modules[0].PartNumber, FallbackValue=—}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="Tile.sysinfo">
            <Grid Margin="0,0,0,14" DataContext="{Binding Vm}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <local:SectionHead Text="作業系統" HelpKey="overview/作業系統"/>
                        <local:FieldRow Label="系統" Value="{Binding System.OsName}"/>
                        <local:FieldRow Label="版本" Value="{Binding System.OsVersion}"/>
                        <local:FieldRow Label="系統架構" Value="{Binding System.OsArch}"/>
                        <local:FieldRow Label="主機名稱" Value="{Binding System.HostName}"/>
                        <local:FieldRow Label="使用者" Value="{Binding System.UserName}"/>
                        <local:FieldRow Label="開機時間" Value="{Binding System.BootTime}"/>
                        <local:FieldRow Label="已運行" Value="{Binding System.Uptime}"/>
                        <local:FieldRow Label="安裝日期" Value="{Binding System.InstallDate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <local:SectionHead Text="機器與主機板" HelpKey="overview/機器與主機板"/>
                        <local:FieldRow Label="製造商" Value="{Binding System.SystemManufacturer}"/>
                        <local:FieldRow Label="機型" Value="{Binding System.SystemModel}"/>
                        <local:FieldRow Label="主機板廠商" Value="{Binding System.BoardVendor}"/>
                        <local:FieldRow Label="主機板型號" Value="{Binding System.BoardModel}"/>
                        <local:FieldRow Label="BIOS 廠商" Value="{Binding System.BiosVendor}"/>
                        <local:FieldRow Label="BIOS 版本" Value="{Binding System.BiosVersion}"/>
                        <local:FieldRow Label="BIOS 日期" Value="{Binding System.BiosDate}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Tile.specs">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="核心規格" HelpKey="overview/核心規格"/>
                    <local:FieldRow Label="處理器" Value="{Binding Cpu.Name}"/>
                    <local:FieldRow Label="實體核心" Value="{Binding Cpu.Cores, Converter={x:Static local:LangFormatConverter.Instance}, ConverterParameter='{}{0} 核'}"/>
                    <local:FieldRow Label="邏輯處理器" Value="{Binding Cpu.Threads, Converter={x:Static local:LangFormatConverter.Instance}, ConverterParameter='{}{0} 執行緒'}"/>
                    <local:FieldRow Label="記憶體" Value="{Binding Live.MemUsageText}"/>
                    <local:FieldRow Label="顯示卡" Value="{Binding Live.PrimaryGpu.Name}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 健康摘要卡（U10-UI-0048／ui.home.healthcards）：彙整既有事實的計數——
             六態分布、缺源（非 Present）筆數與交叉對帳的矛盾。
             刻意不合成評分、不給紅綠燈：判決在各自的老家（健康頁／韌體安全頁），這裡陳述計數與指路。 -->
        <DataTemplate x:Key="Tile.health">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="健康摘要" HelpKey="overview/健康摘要"/>

                    <!-- 事實還沒載入就直說，不畫一張全零的卡 -->
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="尚未擷取——開機序列載入事實後，這裡會出現六態分布與對帳矛盾的計數。"
                               Visibility="{Binding HomeSummary.HasFacts, Converter={StaticResource InverseBoolToVis}}"/>

                    <StackPanel Visibility="{Binding HomeSummary.HasFacts, Converter={StaticResource BoolToVis}}">
                        <local:FieldRow Label="事實總數" Value="{Binding HomeSummary.Total,
                            Converter={x:Static local:LangFormatConverter.Instance}, ConverterParameter='{}{0} 條'}"/>
                        <local:FieldRow Label="讀到了" Value="{Binding HomeSummary.Present,
                            Converter={x:Static local:LangFormatConverter.Instance}, ConverterParameter='{}{0} 條'}"/>
                        <local:FieldRow Label="讀不到（缺源）" Value="{Binding HomeSummary.Unreadable,
                            Converter={x:Static local:LangFormatConverter.Instance},
                            ConverterParameter='{}{0} 條——缺源是環境事實，不扣分也不點燈'}"/>

                        <!-- 六態分布：六個小計並排（2×3），數字是純數值不需翻譯 -->
                        <UniformGrid Rows="2" Columns="3" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="不支援"/>
                                <TextBlock Style="{StaticResource Subtitle}" Text="{Binding HomeSummary.NotSupported}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="權限不足"/>
                                <TextBlock Style="{StaticResource Subtitle}" Text="{Binding HomeSummary.InsufficientPrivilege}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="讀取失敗"/>
                                <TextBlock Style="{StaticResource Subtitle}" Text="{Binding HomeSummary.ReadError}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="本機不適用"/>
                                <TextBlock Style="{StaticResource Subtitle}" Text="{Binding HomeSummary.NotApplicable}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="有值未確認"/>
                                <TextBlock Style="{StaticResource Subtitle}" Text="{Binding HomeSummary.Unknown}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="確認讀到"/>
                                <TextBlock Style="{StaticResource Subtitle}" Text="{Binding HomeSummary.Present}"/>
                            </StackPanel>
                        </UniformGrid>

                        <local:FieldRow Label="交叉對帳" Margin="0,10,0,0" Value="{Binding HomeSummary.ReconcileCount,
                            Converter={x:Static local:LangFormatConverter.Instance}, ConverterParameter='{}已對帳 {0} 條'}"/>
                        <local:FieldRow Label="矛盾" Value="{Binding HomeSummary.ContradictionRules.Count,
                            Converter={x:Static local:LangFormatConverter.Instance}, ConverterParameter='{}{0} 條'}"/>
                        <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="{Binding HomeSummary.ContradictionText}"
                                   Visibility="{Binding HomeSummary.ContradictionText, Converter={StaticResource TextToVis}}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource ToolButton}" Content="看對帳判決（韌體安全）"
                                    Click="NavFirmware_Click"
                                    ToolTip="交叉對帳的逐條判決與理由在韌體安全頁"/>
                            <Button Style="{StaticResource ToolButton}" Margin="8,0,0,0" Content="看事實清單（證據實驗室）"
                                    Click="NavEvidence_Click"
                                    ToolTip="每一把事實鍵與它的六態在證據實驗室"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══ 總覽第一眼：三顆膠囊 ＋ 詳細資訊 ═══
             形狀參照使用者提供的設計稿：上面一排三顆膠囊卡（機型／系統／已運行時間），
             下面一張「詳細資訊」卡，一列一類裝置。
             資料全部取自開機時已經讀好的東西（SystemSummary、Cpu、Modules、Live.Gpus、
             PhysicalDisks、SoundDevices、InstalledNics、Monitors），這一頁不另外掃描——
             總覽是入口，讓它去等 WMI 是本末倒置。 -->

        <DataTemplate x:Key="Tile.capsules">
            <Grid Margin="0,0,0,14" DataContext="{Binding Vm}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <local:CapsuleCard Grid.Column="0" Margin="0,0,5,0"
                                   Label="機型資訊" Glyph="&#xE7F4;"
                                   Value="{Binding System.SystemModel, TargetNullValue=—}"
                                   Sub="{Binding System.SystemManufacturer, TargetNullValue=''}"
                                   Tint="{DynamicResource AccentBrush}"/>
                <local:CapsuleCard Grid.Column="1" Margin="5,0,5,0"
                                   Label="系統資訊" Glyph="&#xE770;"
                                   Value="{Binding System.OsName, TargetNullValue=—}"
                                   Sub="{Binding System.OsVersion, TargetNullValue=''}"
                                   Tint="{DynamicResource GoodBrush}"/>
                <local:CapsuleCard Grid.Column="2" Margin="5,0,0,0"
                                   Label="已運行時間" Glyph="&#xE916;"
                                   Value="{Binding System.Uptime, TargetNullValue=—}"
                                   Sub="{Binding System.BootTime,
                                         Converter={x:Static local:LangFormatConverter.Instance},
                                         ConverterParameter='{}開機於 {0}'}"
                                   Tint="{DynamicResource WarningBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- 詳細資訊每一列的「值」可以是一行字、兩行字或一串裝置；共用的小樣板放在上面，
             列樣板本身只挑一個放進去。 -->
        <DataTemplate x:Key="Line.text">
            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Key="Line.summary">
            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding DisplayText}"/>
        </DataTemplate>
        <DataTemplate x:Key="Line.gpu">
            <TextBlock Style="{StaticResource FieldValue}">
                <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="・VRAM "/><Run Text="{Binding VramText, Mode=OneWay}"/>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="Line.monitor">
            <TextBlock Style="{StaticResource FieldValue}">
                <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="（"/><Run Text="{Binding Manufacturer, Mode=OneWay}"/><Run Text="）"/>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="Tile.details">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="詳細資訊" HelpKey="overview/詳細資訊"/>

                    <local:InfoRow Label="主機板">
                        <local:InfoRow.Value>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap">
                                    <Run Text="{Binding System.BoardVendor, Mode=OneWay}"/><Run Text="　"/><Run Text="{Binding System.BoardModel, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="BIOS "/><Run Text="{Binding System.BiosVersion, Mode=OneWay}"/><Run Text="（"/><Run Text="{Binding System.BiosDate, Mode=OneWay}"/><Run Text="）"/>
                                </TextBlock>
                            </StackPanel>
                        </local:InfoRow.Value>
                    </local:InfoRow>

                    <local:InfoRow Label="處理器">
                        <local:InfoRow.Value>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Cpu.Name}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" Text="{Binding Cpu.SummaryText}"/>
                            </StackPanel>
                        </local:InfoRow.Value>
                    </local:InfoRow>

                    <local:InfoRow Label="記憶體">
                        <local:InfoRow.Value>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Modules}" ItemTemplate="{StaticResource Line.summary}"/>
                                <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0"
                                           Text="{Binding Live.MemUsageText,
                                                  Converter={x:Static local:LangFormatConverter.Instance},
                                                  ConverterParameter='{}目前使用 {0}'}"/>
                            </StackPanel>
                        </local:InfoRow.Value>
                    </local:InfoRow>

                    <local:InfoRow Label="顯示卡">
                        <local:InfoRow.Value>
                            <ItemsControl ItemsSource="{Binding Live.Gpus}" ItemTemplate="{StaticResource Line.gpu}"/>
                        </local:InfoRow.Value>
                    </local:InfoRow>

                    <local:InfoRow Label="顯示器">
                        <local:InfoRow.Value>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Monitors}" ItemTemplate="{StaticResource Line.monitor}"/>
                                <TextBlock Style="{StaticResource FieldValue}" Text="未讀到（EDID 未提供或為虛擬顯示器）"
                                           Visibility="{Binding HasNoMonitors, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </local:InfoRow.Value>
                    </local:InfoRow>

                    <local:InfoRow Label="硬碟">
                        <local:InfoRow.Value>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding PhysicalDisks}" ItemTemplate="{StaticResource Line.summary}"/>
                                <TextBlock Style="{StaticResource FieldValue}" Text="未讀到（磁碟列舉沒有回報）"
                                           Visibility="{Binding HasPhysicalDisks, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </local:InfoRow.Value>
                    </local:InfoRow>

                    <local:InfoRow Label="聲卡">
                        <local:InfoRow.Value>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SoundDevices}" ItemTemplate="{StaticResource Line.text}"/>
                                <TextBlock Style="{StaticResource FieldValue}" Text="未讀到（作業系統沒有回報音訊裝置）"
                                           Visibility="{Binding HasSoundDevices, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </local:InfoRow.Value>
                    </local:InfoRow>

                    <local:InfoRow Label="網卡">
                        <local:InfoRow.Value>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding InstalledNics}" ItemTemplate="{StaticResource Line.summary}"/>
                                <TextBlock Style="{StaticResource FieldValue}" Text="未讀到（沒有實體網路卡或查詢失敗）"
                                           Visibility="{Binding HasInstalledNics, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </local:InfoRow.Value>
                    </local:InfoRow>
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:DashboardTileTemplateSelector x:Key="TileTemplate"/>
        <!-- 深色核取方塊（與歷史回放／風扇分頁同一視覺語彙）-->
        <Style x:Key="TileCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="17" Height="17" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2">
                                <Path x:Name="check" Width="11" Height="11" Stretch="Uniform"
                                      Data="M2,8 L6,12 L14,3" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <local:SectionHead Text="系統總覽" HelpKey="overview/系統總覽" DockPanel.Dock="Left"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" VerticalAlignment="Top"
                        Content="自訂磁貼" Click="Customize_Click"
                        ToolTip="選擇要顯示哪些區塊、調整上下順序"/>
                <Button x:Name="CopySpecButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        VerticalAlignment="Top" Margin="0,0,8,0"
                        Content="複製規格摘要" Click="CopySpec_Click"
                        ToolTip="把八行規格複製到剪貼簿，方便貼到論壇或聊天室問人。不含電腦名稱、使用者名稱與任何序號。"/>
            </DockPanel>

            <!-- 一句話說明這一頁現在是什麼（設計稿上也有一行副標）：先報機型與裝置，不是先報即時數字。 -->
            <TextBlock Style="{StaticResource Subtitle}" Margin="2,-4,0,12" TextWrapping="Wrap"
                       Text="本機型號、系統與關鍵硬體參數的摘要；即時數據請到各自的專頁，儀表預設收起。"/>

            <!-- 自訂面板：只在按下「自訂磁貼」時展開，平時不佔畫面 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                    Visibility="{Binding Dashboard.Editing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <local:SectionHead Text="自訂磁貼" HelpKey="overview/自訂磁貼" DockPanel.Dock="Left"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" VerticalAlignment="Top"
                                Content="回復預設" Click="TileReset_Click" ToolTip="還原內建的顯示項目與順序"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="勾選要顯示的區塊，用 ▲ ▼ 調整上下順序。變更立即生效，並記憶為下次啟動的版面。"/>

                    <ItemsControl ItemsSource="{Binding Dashboard.Tiles}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <CheckBox Style="{StaticResource TileCheck}" Content="{Binding Title}"
                                                  IsChecked="{Binding Visible, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource Subtitle}" Margin="25,1,0,0"
                                                   TextWrapping="Wrap" Text="{Binding Hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource MiniIconButton}" Content="▲" Margin="0,0,4,0"
                                                ToolTip="上移" Click="TileUp_Click" IsEnabled="{Binding CanMoveUp}"/>
                                        <Button Style="{StaticResource MiniIconButton}" Content="▼"
                                                ToolTip="下移" Click="TileDown_Click" IsEnabled="{Binding CanMoveDown}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- 磁貼本體：順序來自使用者設定，隱藏者收起（不留空隙）。
                 進場延遲綁在容器上而非樣板裡，才會跟著實際順位交錯，而不是固定寫死的那幾個數字。 -->
            <ItemsControl ItemsSource="{Binding Dashboard.Tiles}"
                          ItemTemplateSelector="{StaticResource TileTemplate}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Visibility" Value="{Binding Visible, Converter={StaticResource BoolToVis}}"/>
                        <Setter Property="local:Anim.RevealDelay" Value="{Binding RevealDelay}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
