<UserControl x:Class="XinSpect.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <UserControl.Resources>
        <!-- ═══ 磁貼樣板 ═══
             資源鍵固定為 Tile.{識別碼}，由 DashboardTileTemplateSelector 依磁貼身分查表取用；
             新增一塊磁貼＝在 DashboardLayout.Catalog 加一筆、在這裡補一個同名樣板，版面碼不必動。
             樣板的 DataContext 是磁貼本身，所以根元素改綁 Vm，內層才能沿用原本的繫結路徑。 -->

        <DataTemplate x:Key="Tile.gauges">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <UniformGrid Rows="1" Columns="4">
                    <local:RadialGauge Caption="CPU 使用率" Unit="%"
                                       Value="{Binding Live.CpuLoad, FallbackValue=0, TargetNullValue=0}"/>
                    <local:RadialGauge Caption="CPU 溫度" Unit="°C" Max="100"
                                       Value="{Binding Live.CpuTemp, FallbackValue=0, TargetNullValue=0}"
                                       ArcBrush="{Binding Live.CpuTempSeverity, Converter={StaticResource SeverityToBrush}}"/>
                    <local:RadialGauge Caption="記憶體使用率" Unit="%"
                                       Value="{Binding Live.MemLoad, FallbackValue=0, TargetNullValue=0}"/>
                    <local:RadialGauge Caption="GPU 使用率" Unit="%"
                                       Value="{Binding Live.PrimaryGpu.LoadPercent, FallbackValue=0, TargetNullValue=0}"/>
                </UniformGrid>
            </Border>
        </DataTemplate>

        <!-- 七段數字面板：遠一點也讀得到的大字。off 段保留為極淡的殘影，所以數字不會跳位。 -->
        <DataTemplate x:Key="Tile.digits">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="數字面板" HelpKey="overview/數字面板"/>
                    <UniformGrid Rows="1" Columns="4" Margin="0,12,0,0">
                        <StackPanel>
                            <local:OutlineDigits DigitHeight="48" HorizontalAlignment="Left"
                                                 Text="{Binding Live.CpuLoad, StringFormat={}{0:0}, FallbackValue=--, TargetNullValue=--}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CPU 使用率 %" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <local:OutlineDigits DigitHeight="48" HorizontalAlignment="Left"
                                                 Foreground="{Binding Live.CpuTempSeverity, Converter={StaticResource SeverityToBrush}}"
                                                 Text="{Binding Live.CpuTemp, StringFormat={}{0:0}, FallbackValue=--, TargetNullValue=--}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="封裝溫度 °C" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <local:OutlineDigits DigitHeight="48" HorizontalAlignment="Left"
                                                 Text="{Binding Live.CpuPowerW, StringFormat={}{0:0}, FallbackValue=--, TargetNullValue=--}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="封裝功耗 W" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <local:OutlineDigits DigitHeight="48" HorizontalAlignment="Left"
                                                 Text="{Binding Live.MemLoad, StringFormat={}{0:0}, FallbackValue=--, TargetNullValue=--}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="記憶體使用率 %" Margin="0,5,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="「--」代表這台機器沒有這項讀值（多為缺少驅動權限或平台未暴露該感測），不是 0。"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Tile.trends">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="即時走勢（近 90 秒）" HelpKey="overview/即時走勢（近 90 秒）"/>
                    <UniformGrid Rows="1" Columns="4">
                        <local:HistoryGraph Height="104" Margin="0,0,6,0" Caption="CPU 使用率"
                                            History="{Binding CpuLoadHist}" Stroke="{StaticResource AccentBrush}"/>
                        <local:HistoryGraph Height="104" Margin="3,0,3,0" Caption="CPU 溫度"
                                            History="{Binding CpuTempHist}" Stroke="{StaticResource SeriousBrush}"/>
                        <local:HistoryGraph Height="104" Margin="3,0,3,0" Caption="記憶體"
                                            History="{Binding MemHist}" Stroke="{StaticResource GoodBrush}"/>
                        <local:HistoryGraph Height="104" Margin="6,0,0,0" Caption="GPU 使用率"
                                            History="{Binding GpuHist}" Stroke="{StaticResource WarningBrush}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 預設不顯示：想看頻率與顯示記憶體的人自己打開，總覽第一眼仍以四項主指標為主 -->
        <DataTemplate x:Key="Tile.trends2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="更多走勢（近 90 秒）" HelpKey="overview/更多走勢（近 90 秒）"/>
                    <UniformGrid Rows="1" Columns="3">
                        <local:HistoryGraph Height="104" Margin="0,0,6,0" Caption="CPU 頻率"
                                            History="{Binding CpuClockHist}" Stroke="{StaticResource GoodBrush}"/>
                        <local:HistoryGraph Height="104" Margin="3,0,3,0" Caption="GPU 溫度"
                                            History="{Binding GpuTempHist}" Stroke="{StaticResource SeriousBrush}"/>
                        <local:HistoryGraph Height="104" Margin="6,0,0,0" Caption="顯示記憶體"
                                            History="{Binding GpuVramHist}" Stroke="{StaticResource AccentBrush}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Tile.ai">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <local:SectionHead Text="AI 評價" HelpKey="overview/AI 評價" Margin="0,0,0,2"/>
                        <TextBlock Style="{StaticResource Subtitle}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="由 AI 依本機真實數據客觀評價效能與配置。可用本機免費 Ollama 或 OpenAI 相容 API，於「設定 › AI 評價」調整。"/>
                        <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Ai.StatusText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Content="一鍵評價本機" Margin="0,0,10,0"
                                IsEnabled="{Binding Ai.CanSend}" Click="AiEvaluate_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="開啟 AI 助手　▸" Click="OpenAi_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Tile.brands">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="硬體識別" HelpKey="overview/硬體識別"/>
                    <UniformGrid Columns="2" Rows="2">
                        <local:BrandBadge Margin="0,8,12,8" Kind="Cpu" EmblemSize="46"
                                          Brand="{Binding Cpu.Brand}" Model="{Binding Cpu.Name}"
                                          CpuModel="{Binding Cpu.Name}"/>
                        <local:BrandBadge Margin="0,8,0,8" Kind="Gpu" EmblemSize="46"
                                          Brand="{Binding Live.PrimaryGpu.Brand, FallbackValue={x:Static local:Brand.Unknown}}"
                                          Model="{Binding Live.PrimaryGpu.Name, FallbackValue=未偵測到顯示卡}"/>
                        <local:BrandBadge Margin="0,8,12,8" Kind="Board" EmblemSize="46"
                                          Brand="{Binding System.BoardBrand}" Model="{Binding System.BoardModel}"/>
                        <local:BrandBadge Margin="0,8,0,8" Kind="Ram" EmblemSize="46"
                                          Brand="{Binding Modules[0].Brand, FallbackValue={x:Static local:Brand.Unknown}}"
                                          Model="{Binding Modules[0].PartNumber, FallbackValue=—}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="Tile.sysinfo">
            <Grid Margin="0,0,0,14" DataContext="{Binding Vm}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <local:SectionHead Text="作業系統" HelpKey="overview/作業系統"/>
                        <local:FieldRow Label="系統" Value="{Binding System.OsName}"/>
                        <local:FieldRow Label="版本" Value="{Binding System.OsVersion}"/>
                        <local:FieldRow Label="系統架構" Value="{Binding System.OsArch}"/>
                        <local:FieldRow Label="主機名稱" Value="{Binding System.HostName}"/>
                        <local:FieldRow Label="使用者" Value="{Binding System.UserName}"/>
                        <local:FieldRow Label="開機時間" Value="{Binding System.BootTime}"/>
                        <local:FieldRow Label="已運行" Value="{Binding System.Uptime}"/>
                        <local:FieldRow Label="安裝日期" Value="{Binding System.InstallDate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <local:SectionHead Text="機器與主機板" HelpKey="overview/機器與主機板"/>
                        <local:FieldRow Label="製造商" Value="{Binding System.SystemManufacturer}"/>
                        <local:FieldRow Label="機型" Value="{Binding System.SystemModel}"/>
                        <local:FieldRow Label="主機板廠商" Value="{Binding System.BoardVendor}"/>
                        <local:FieldRow Label="主機板型號" Value="{Binding System.BoardModel}"/>
                        <local:FieldRow Label="BIOS 廠商" Value="{Binding System.BiosVendor}"/>
                        <local:FieldRow Label="BIOS 版本" Value="{Binding System.BiosVersion}"/>
                        <local:FieldRow Label="BIOS 日期" Value="{Binding System.BiosDate}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Tile.specs">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Vm}">
                <StackPanel>
                    <local:SectionHead Text="核心規格" HelpKey="overview/核心規格"/>
                    <local:FieldRow Label="處理器" Value="{Binding Cpu.Name}"/>
                    <local:FieldRow Label="實體核心" Value="{Binding Cpu.Cores, StringFormat={}{0} 核}"/>
                    <local:FieldRow Label="邏輯處理器" Value="{Binding Cpu.Threads, StringFormat={}{0} 執行緒}"/>
                    <local:FieldRow Label="記憶體" Value="{Binding Live.MemUsageText}"/>
                    <local:FieldRow Label="顯示卡" Value="{Binding Live.PrimaryGpu.Name}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:DashboardTileTemplateSelector x:Key="TileTemplate"/>
        <!-- 深色核取方塊（與歷史回放／風扇分頁同一視覺語彙）-->
        <Style x:Key="TileCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="17" Height="17" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1.2">
                                <Path x:Name="check" Width="11" Height="11" Stretch="Uniform"
                                      Data="M2,8 L6,12 L14,3" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <local:SectionHead Text="系統總覽" HelpKey="overview/系統總覽" DockPanel.Dock="Left"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" VerticalAlignment="Top"
                        Content="自訂磁貼" Click="Customize_Click"
                        ToolTip="選擇要顯示哪些區塊、調整上下順序"/>
            </DockPanel>

            <!-- 自訂面板：只在按下「自訂磁貼」時展開，平時不佔畫面 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                    Visibility="{Binding Dashboard.Editing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <local:SectionHead Text="自訂磁貼" HelpKey="overview/自訂磁貼" DockPanel.Dock="Left"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" VerticalAlignment="Top"
                                Content="回復預設" Click="TileReset_Click" ToolTip="還原內建的顯示項目與順序"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="勾選要顯示的區塊，用 ▲ ▼ 調整上下順序。變更立即生效，並記憶為下次啟動的版面。"/>

                    <ItemsControl ItemsSource="{Binding Dashboard.Tiles}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <CheckBox Style="{StaticResource TileCheck}" Content="{Binding Title}"
                                                  IsChecked="{Binding Visible, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource Subtitle}" Margin="25,1,0,0"
                                                   TextWrapping="Wrap" Text="{Binding Hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource MiniIconButton}" Content="▲" Margin="0,0,4,0"
                                                ToolTip="上移" Click="TileUp_Click" IsEnabled="{Binding CanMoveUp}"/>
                                        <Button Style="{StaticResource MiniIconButton}" Content="▼"
                                                ToolTip="下移" Click="TileDown_Click" IsEnabled="{Binding CanMoveDown}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- 磁貼本體：順序來自使用者設定，隱藏者收起（不留空隙）。
                 進場延遲綁在容器上而非樣板裡，才會跟著實際順位交錯，而不是固定寫死的那幾個數字。 -->
            <ItemsControl ItemsSource="{Binding Dashboard.Tiles}"
                          ItemTemplateSelector="{StaticResource TileTemplate}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Visibility" Value="{Binding Visible, Converter={StaticResource BoolToVis}}"/>
                        <Setter Property="local:Anim.RevealDelay" Value="{Binding RevealDelay}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
