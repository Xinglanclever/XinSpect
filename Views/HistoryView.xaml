<UserControl x:Class="XinSpect.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 深色核取方塊（與風扇／超頻分頁同一視覺語彙）-->
        <Style x:Key="HistCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="17" Height="17" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2">
                                <Path x:Name="check" Width="11" Height="11" Stretch="Uniform"
                                      Data="M2,8 L6,12 L14,3" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 指標列：開關 ・ 色標 ・ 名稱 ・ 最小/平均/最大/P95 ・ 滿刻度 -->
        <DataTemplate x:Key="MetricRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="132"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <CheckBox Style="{StaticResource HistCheck}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Margin="10,0,7,0"
                               Fill="{Binding Color}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Title}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="{Binding MinText}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding AvgText}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="{Binding MaxText}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="{Binding P95Text}"
                           TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Style="{StaticResource FieldLabel}" Text="{Binding ScaleText}"
                           TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- DataContext 設於首個子元素：根元素繫結在 Host.Content 延遲載入時不解析 -->
    <Grid Margin="0,0,8,0" DataContext="{Binding HistoryView}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題與時間窗控制 -->
        <Grid Grid.Row="0" Margin="2,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Title}" Text="歷史回放"/>
                    <local:HelpDot HelpKey="history/歷史回放"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0"
                           Text="滾輪縮放 ・ 拖曳平移 ・ 雙擊還原 ・ 游標讀值"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox Style="{StaticResource DarkCombo}" Width="104" VerticalAlignment="Center"
                          ItemsSource="{Binding Source={x:Static local:HistoryViewModel.RangeNames}}"
                          SelectedIndex="{Binding RangeIndex, Mode=TwoWay}"
                          ToolTip="選擇要回顧的時間長度"/>
                <CheckBox Style="{StaticResource HistCheck}" Content="自動跟隨" Margin="14,0,0,0"
                          IsChecked="{Binding Follow, Mode=TwoWay}"
                          ToolTip="右緣固定在現在，隨心跳持續右移"/>
                <Button Style="{StaticResource ToolButton}" Content="全選" Margin="14,0,0,0" Click="All_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="全不選" Margin="6,0,0,0" Click="None_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="匯出 CSV" Margin="6,0,0,0" Click="Export_Click"/>
            </StackPanel>
        </Grid>

        <!-- 時間軸圖 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" MinHeight="240">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="2,0,2,6">
                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding RangeText}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding TierText}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <local:TimelineChart x:Name="Chart" Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- 指標開關與統計 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="132"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" Text="指標"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="最小" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="平均" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="最大" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="P95" TextAlignment="Right"/>
                    <TextBlock Grid.Column="5" Style="{StaticResource ColHead}" Text="滿刻度" TextAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource MetricRow}"/>
            </StackPanel>
        </Border>

        <!-- 頁尾：資料點數、倉儲狀態與匯出訊息 -->
        <StackPanel Grid.Row="3" Margin="4,10,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap">
                <Run Text="{Binding CountText, Mode=OneWay}"/><Run Text="　・　"/><Run Text="{Binding StoreText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding StatusText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
