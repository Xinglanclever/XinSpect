<UserControl x:Class="XinSpect.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>

        <!-- 深色滑桿 -->
        <Style x:Key="SetSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="3" Background="{StaticResource HairlineBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3" Background="{StaticResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White"
                                                         Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 深色核取方塊 -->
        <Style x:Key="SetCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1.2">
                                <Path x:Name="check" Width="12" Height="12" Stretch="Uniform"
                                      Data="M2,8 L6,12 L14,3" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色輸入框 -->
        <Style x:Key="SetTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="7" Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1.2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 遮蔽輸入欄（API 金鑰）：與 SetTextBox 同形，但字元以圓點顯示 -->
        <Style x:Key="SetPasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" CornerRadius="7" Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1.2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- @@SETTINGS_BODY@@ -->
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,12,20">

            <TextBlock Style="{StaticResource Title}" Text="設定" Margin="0,0,0,2"/>
            <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,14"
                       Text="外觀、更新頻率、開機自啟、感測器記錄與硬體警示。設定即時生效並自動儲存。"/>

            <!-- ═══ 外觀 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="外觀"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="深／淺色主題與八種強調色。選擇後整個介面立即換色（無須重啟），並記憶為下次啟動的外觀。"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="主題" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="ThemeCombo" Style="{StaticResource DarkCombo}"
                                  HorizontalAlignment="Left" Width="220"
                                  SelectionChanged="Theme_Changed"/>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="強調色" Margin="0,16,0,8"/>
                    <ItemsControl x:Name="AccentList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ToolButton}" Margin="0,0,10,10"
                                        Tag="{Binding Key}" Click="Accent_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center"
                                                Background="{Binding Swatch}"
                                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"/>
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="AccentHint" Style="{StaticResource Subtitle}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ 迷你浮動監視器 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="迷你浮動監視器"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="常駐畫面一角的精簡讀值面板（工具列「迷你」鈕或系統匣選單開啟）。拖曳後會記住位置，下次顯示回到原處；若那台螢幕已拔除，則自動貼回工作區右上角。"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="底板不透明度" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center"
                                Minimum="0.4" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding Settings.MiniOpacity, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.MiniOpacity, StringFormat={}{0:P0}}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="只有底板變淡，讀值文字維持不透明才讀得清楚。"/>

                    <CheckBox Style="{StaticResource SetCheck}" Margin="0,12,0,0" Content="精簡模式：收起 CPU／GPU 波形，只留四行讀值"
                              IsChecked="{Binding Settings.MiniCompact, Mode=TwoWay}"/>
                    <CheckBox Style="{StaticResource SetCheck}" Margin="0,10,0,0" Content="釘選於最上層"
                              IsChecked="{Binding Settings.MiniTopmost, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="27,2,0,0" TextWrapping="Wrap"
                               Text="取消後會被其他視窗蓋住，但仍留在畫面上。這兩項也能在監視器自己的標題列上就地切換。"/>
                </StackPanel>
            </Border>

            <!-- ═══ 環境自檢 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="環境自檢"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="偵測各分頁功能所需的執行階段／驅動／服務是否就緒（.NET、系統管理員、感測器核心驅動、WebView2 內建瀏覽器、winget 一鍵裝機、NVIDIA 顯示卡超頻、Intel XTU CPU 超頻）。缺少的項目會標示並附官方取得連結。全為真實偵測。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" MinWidth="120"
                                Content="開始檢測" Click="EnvCheck_Click"
                                IsEnabled="{Binding EnvCheck.CanRun}"/>
                        <TextBlock Style="{StaticResource FieldValue}" VerticalAlignment="Center" Margin="14,0,0,0"
                                   TextWrapping="Wrap" Text="{Binding EnvCheck.Summary}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding EnvCheck.Items}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="7" Margin="0,0,0,6" Padding="12,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,12,0"
                                                 Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryInkBrush}" FontSize="14" FontWeight="SemiBold"/>
                                                <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11.5"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryInkBrush}" FontSize="12.5"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource ToolButton}" VerticalAlignment="Top" Margin="12,0,0,0"
                                                Content="{Binding LinkText}" Tag="{Binding DownloadUrl}" Click="EnvLink_Click"
                                                Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ 一般 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="一般"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="更新間隔" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center"
                                Minimum="1" Maximum="10" Value="{Binding Settings.UpdateIntervalSec, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.UpdateIntervalSec, StringFormat={}{0} 秒}"/>
                    </Grid>

                    <CheckBox Style="{StaticResource SetCheck}" Margin="0,14,0,0"
                              Content="開機時自動啟動（工作排程器・最高權限，登入靜默啟動、可還原）"
                              IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="預設紀年" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" HorizontalAlignment="Left" Width="220"
                                  ItemsSource="{Binding EraNames}" SelectedIndex="{Binding EraIndex, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- ═══ 感測器記錄 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="感測器記錄（CSV）"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="持續把 CPU／GPU 溫度、頻率、負載、記憶體、顯示記憶體等即時值寫入 CSV，可用 Excel／試算表事後分析。全為真實讀值。"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="記錄間隔" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center"
                                Minimum="1" Maximum="60" Value="{Binding Settings.LogIntervalSec, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.LogIntervalSec, StringFormat={}{0} 秒}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="輸出資料夾" Margin="0,14,0,4"/>
                    <TextBox Style="{StaticResource SetTextBox}" Text="{Binding Settings.LogFolder, Mode=TwoWay}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding SensorLog.ButtonText}"
                                Click="LogToggle_Click" MinWidth="120"/>
                        <Button Style="{StaticResource ToolButton}" Content="開啟資料夾" Margin="12,0,0,0"
                                Click="OpenLogFolder_Click"/>
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="狀態"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding SensorLog.StatusText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="已記錄" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding SensorLog.RowCountText}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="目前檔案" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding SensorLog.CurrentFile}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- ═══ 歷史記錄 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="歷史記錄"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="供「歷史回放」查詢的資料倉：最近一小時保留秒級原始取樣，更早則按分鐘存下最小／平均／最大值。落地於 %APPDATA%\XinSpect\history.bin，一個月約數 MB。"/>

                    <CheckBox Style="{StaticResource SetCheck}" Margin="0,12,0,0" Content="持續累積歷史資料"
                              IsChecked="{Binding Settings.HistoryEnabled, Mode=TwoWay}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="保留天數" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center"
                                Minimum="1" Maximum="120" Value="{Binding Settings.HistoryRetentionDays, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.HistoryRetentionDays, StringFormat={}{0} 天}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="{Binding HistoryView.StoreText}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource ToolButton}" Content="開啟歷史回放" Click="OpenHistory_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="清空歷史資料" Margin="12,0,0,0"
                                Click="ClearHistory_Click"/>
                    </StackPanel>

                    <!-- 跑分紀錄簿：與感測歷史分開，因為它是「跑分基準」本身，清掉就沒有可比的對象了 -->
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,16,0,14"/>
                    <TextBlock Style="{StaticResource FieldValue}" Text="跑分紀錄簿"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="本機歷次跑分成績（含當時的溫度與頻率），存於 %APPDATA%\XinSpect\bench-history.json，最多保留 300 筆。曦覽不內建任何別台機器的參考分數，這份紀錄就是「與上次相比」「重複性」的唯一依據——清空後在累積出新紀錄前，跑分只會有單次數字而無從比較。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                   Text="{Binding Benchmarks.Count, StringFormat=目前 {0} 筆}"/>
                        <Button Style="{StaticResource ToolButton}" Content="清空跑分紀錄" Margin="12,0,0,0"
                                Click="ClearBenchLog_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- ═══ 溫度／負載警示 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="溫度／負載警示"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="任一即時值超過下列上限時，於內容區頂端顯示紅色橫幅並發出系統匣氣泡通知（回落一段幅度後自動解除）。"/>

                    <CheckBox Style="{StaticResource SetCheck}" Margin="0,12,0,0" Content="啟用警示"
                              IsChecked="{Binding Settings.AlertsEnabled, Mode=TwoWay}"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="CPU 溫度上限" VerticalAlignment="Center"/>
                        <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center"
                                Minimum="40" Maximum="110" Value="{Binding Settings.CpuTempThreshold, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.CpuTempThreshold, StringFormat={}{0:0} °C}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="GPU 溫度上限" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center" Margin="0,10,0,0"
                                Minimum="40" Maximum="110" Value="{Binding Settings.GpuTempThreshold, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0"
                                   Text="{Binding Settings.GpuTempThreshold, StringFormat={}{0:0} °C}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="CPU 負載上限" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center" Margin="0,10,0,0"
                                Minimum="50" Maximum="100" Value="{Binding Settings.CpuLoadThreshold, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0"
                                   Text="{Binding Settings.CpuLoadThreshold, StringFormat={}{0:0} %}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="記憶體負載上限" VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center" Margin="0,10,0,0"
                                Minimum="50" Maximum="100" Value="{Binding Settings.MemLoadThreshold, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0"
                                   Text="{Binding Settings.MemLoadThreshold, StringFormat={}{0:0} %}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="近期警示事件" Margin="0,16,0,6"/>
                    <TextBlock Style="{StaticResource Subtitle}" Text="目前沒有警示事件。"
                               Visibility="{Binding Alerts.HasEvents, Converter={StaticResource InverseBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Alerts.Events}" MaxHeight="220">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="6" Margin="0,0,0,5" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource SecondaryInkBrush}" Width="72"/>
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource PrimaryInkBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ AI 評價 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="AI 評價"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="把本機真實硬體規格與即時感測數據交給 AI 做客觀評價。可用本機免費模型（Ollama，無須金鑰、資料不出本機），或填入任何 OpenAI 相容的 API 端點與金鑰。"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="供應商" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="AiProviderCombo" Style="{StaticResource DarkCombo}" HorizontalAlignment="Left" Width="280"
                                  SelectedIndex="{Binding Settings.AiProvider, Mode=TwoWay}" SelectionChanged="AiProvider_Changed">
                            <ComboBoxItem Content="本機 Ollama（免費・離線・建議）"/>
                            <ComboBoxItem Content="OpenAI 相容 API（自填端點與金鑰）"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="API 端點（Base URL）" Margin="0,14,0,4"/>
                    <TextBox Style="{StaticResource SetTextBox}" Text="{Binding Settings.AiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="API 金鑰（本機 Ollama 可留空）" Margin="0,14,0,4"/>
                    <!-- 金鑰預設遮蔽：這個畫面常出現在截圖與螢幕分享裡。
                         勾「顯示」才換成明碼欄位——兩個欄位同時只有一個可見，內容都寫回同一個設定。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="AiKeyMasked" Style="{StaticResource SetPasswordBox}"
                                         PasswordChanged="AiKeyMasked_Changed"
                                         Visibility="{Binding IsChecked, ElementName=AiKeyShow, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBox x:Name="AiKeyPlain" Style="{StaticResource SetTextBox}"
                                     Text="{Binding Settings.AiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsChecked, ElementName=AiKeyShow, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <CheckBox x:Name="AiKeyShow" Grid.Column="1" Style="{StaticResource SetCheck}" Content="顯示"
                                  Margin="12,0,0,0" VerticalAlignment="Center" Unchecked="AiKeyShow_Unchecked"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="金鑰只存在本機 %APPDATA%\XinSpect\settings.json（純文字，未加密——同一台電腦上的其他程式讀得到）。曦覽不會把金鑰寫進報告、記錄檔或任何對外請求以外的地方。"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="模型名稱" Margin="0,14,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource SetTextBox}"
                                 Text="{Binding Settings.AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{StaticResource ToolButton}" Content="一鍵獲取"
                                Margin="10,0,0,0" VerticalAlignment="Center" Click="FetchModels_Click"/>
                    </Grid>
                    <ComboBox x:Name="AiModelsCombo" Style="{StaticResource DarkCombo}" Margin="0,8,0,0"
                              ItemsSource="{Binding Ai.Models}"
                              SelectionChanged="AiModel_Picked"
                              Visibility="{Binding Ai.Models.Count, Converter={StaticResource CountToVis}}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="例：Ollama → llama3.2 / qwen2.5 / gemma2；OpenAI 相容 → gpt-4o-mini / 相容服務之模型名。可先填端點後按「一鍵獲取」自動列出可用模型。"/>
                    <TextBlock x:Name="AiFetchHint" Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{Binding Ai.StatusText}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="溫度" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center"
                                Minimum="0" Maximum="2" TickFrequency="0.1" Value="{Binding Settings.AiTemperature, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.AiTemperature, StringFormat={}{0:0.0}}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0"
                               Text="越低越保守一致（適合客觀評測），越高越發散有創意。"/>

                    <!-- 診斷代理 / 串流 / 保留對話 -->
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,16,0,14"/>
                    <CheckBox Style="{StaticResource SetCheck}" Content="診斷代理：允許 AI 主動查詢本機唯讀資料"
                              IsChecked="{Binding Settings.AiAgentMode, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="27,2,0,0" TextWrapping="Wrap"
                               Text="開啟後，AI 可自行呼叫 33 項唯讀查詢工具（完整規格、處理器拓樸、即時讀值、所有溫度、感測器總表、風扇與曲線、磁碟健康、事件時間軸、歷史統計、顯示卡與處理器調校現況、場景、健康總評、環境自檢、效能成績、記憶體時序與 SPD、網路組態與流量、螢幕 EDID 色域、效能天梯名次、升級建議、電池健康、開機啟動項、藍屏傾印，以及 10 項硬核底層事實：Top-down 管線歸因、頻率真相、平台可信度、BIOS 與 ME 微碼、逐核時間歸因、電源政策、記憶體認可帳本、機器檢查與 WHEA、處理器免疫位元、RDT 監測），並在對話中列出每次查詢。全部只讀不寫：不會改設定、不會動硬體、不會啟動任何程式，也不會自己去發動 PMU／MSR 量測——硬核項目你沒按過量測，AI 就只會說「本機尚未量測」。關閉則只送出一次硬體快照。"/>

                    <CheckBox Style="{StaticResource SetCheck}" Margin="0,14,0,0" Content="主動診斷：警示觸發時自動請 AI 分析"
                              IsChecked="{Binding Settings.AiProactive, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="27,2,0,0" TextWrapping="Wrap"
                               Text="預設關閉。開啟後，只要溫度或負載越過上方的警示上限，就會自動在 AI 分頁發起一次診斷（同一項目最少間隔 10 分鐘）。這會在你沒開口時送出請求——若你用的是計費 API，費用會照算；端點或模型還沒填妥時則安靜略過。"/>

                    <CheckBox Style="{StaticResource SetCheck}" Margin="0,14,0,0" Content="逐字串流回覆"
                              IsChecked="{Binding Settings.AiStreaming, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="27,2,0,0" TextWrapping="Wrap"
                               Text="邊產生邊顯示，長篇評價不必乾等；端點不接受串流時會自動退回整段模式，不會失敗。"/>

                    <CheckBox Style="{StaticResource SetCheck}" Margin="0,14,0,0" Content="保留對話（下次啟動接續）"
                              IsChecked="{Binding Settings.AiKeepHistory, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="27,2,0,0" TextWrapping="Wrap"
                               Text="對話存於 %APPDATA%\XinSpect\aichat.json（僅本機純文字，不含金鑰），最多保留最後 240 則。取消勾選會立刻刪除該檔，不只是停止續寫；按 AI 分頁的「清除對話」同樣會一併刪檔。"/>

                    <!-- 送出長度：上下文不是免費的，這兩項直接決定每次請求要花多少 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="回覆長度上限" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center"
                                Minimum="0" Maximum="8192" TickFrequency="256" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.AiMaxTokens, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.AiMaxTokens, StringFormat={}{0:0}}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="單次回覆的 max_tokens。0 表示不送這個欄位、由端點自行決定——本機 Ollama 建議留 0；計費 API 想控制花費時再設上限。設太小會讓長篇評價在中途被截斷（截斷是端點做的，畫面上就會看到話沒說完）。"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="回送舊對話則數" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource SetSlider}" VerticalAlignment="Center"
                                Minimum="0" Maximum="60" TickFrequency="2" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.AiHistoryTurns, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.AiHistoryTurns, StringFormat={}{0:0}}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="每次請求最多回送幾則舊對話（0 表示全部）。硬體快照本身就佔掉不少上下文，整段歷史一併送出會越談越貴、也容易撞上模型上限。有省略時會在系統提示中告知模型，避免它以為看到的是完整對話。"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="系統提示詞（要求 AI 客觀公正；可自行修改）" Margin="0,16,0,4"/>
                    <TextBox Style="{StaticResource SetTextBox}" Height="150" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Settings.AiSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource ToolButton}" Content="一鍵重置為預設" Click="ResetPrompt_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="儲存提示詞" Margin="12,0,0,0" Click="SavePrompt_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="開啟 AI 助手分頁　▸" Margin="12,0,0,0" Click="OpenAiTab_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="AiPromptHint" Style="{StaticResource Subtitle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ 報告匯出 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="報告匯出"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="把整機規格、即時讀值、健康評分、跑分紀錄、升級建議與 AI 評價寫成一份報告。HTML 為單一自帶樣式的檔案（不外連字型或指令碼），在瀏覽器按「列印／另存 PDF」即得已排好版的 A4 文件；Markdown 適合貼上論壇或議題；純文字適合貼進信件或工單。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="匯出報告…" Click="ExportReport_Click" MinWidth="120"/>
                        <Button Style="{StaticResource ToolButton}" Content="複製為 Markdown" Margin="12,0,0,0" Click="CopyMarkdown_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ReportHint" Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,16,0,14"/>
                    <CheckBox Style="{StaticResource SetCheck}" Content="遮蔽可識別資訊"
                              IsChecked="{Binding Settings.ReportMaskIdentity, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="27,2,0,0" TextWrapping="Wrap"
                               Text="開啟後，報告中的主機名稱、使用者名稱、MAC 位址與磁碟序號改以「（已遮蔽）」輸出，其餘規格與讀值照實不動。要把報告貼到公開場合時再開；自己留存的報告該是完整的。曦覽不提供「產生分享網址」——那必然得把這台機器的硬體資訊送到別人的伺服器上存放，送出就收不回來；要分享請直接分享這份檔案。"/>
                </StackPanel>
            </Border>

            <!-- ═══ 診斷紀錄 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="診斷紀錄"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="曦覽遇到讀不到的東西時（MSR 被拒、WMI 查詢失敗、感測器不存在、驅動沒開放）會讓那一欄顯示「—」並繼續跑，而不是整頁掛掉。但「量不到」和「程式有缺陷」在畫面上長得一模一樣——這份清單就是用來分辨兩者的：每一筆記下發生位置、例外型別與訊息，以及對你的實際後果。"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="{Binding Diagnostics.SummaryText}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource ToolButton}" Content="重新整理" Click="DiagRefresh_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="開啟 diag.log" Margin="12,0,0,0"
                                Click="DiagOpenFile_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="開啟資料夾" Margin="12,0,0,0"
                                Click="DiagOpenFolder_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="清空畫面紀錄" Margin="12,0,0,0"
                                Click="DiagClear_Click"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding Diagnostics.HintText}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{Binding Diagnostics.FilePath, StringFormat=紀錄檔：{0}}"/>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="目前沒有降級紀錄可列。"
                               Visibility="{Binding Diagnostics.HasEntries, Converter={StaticResource InverseBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Diagnostics.Recent}" MaxHeight="260" Margin="0,12,0,0"
                                  Visibility="{Binding Diagnostics.HasEntries, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="6" Margin="0,0,0,5" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{StaticResource SecondaryInkBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Site}" Foreground="{StaticResource PrimaryInkBrush}" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Foreground="{StaticResource PrimaryInkBrush}" TextWrapping="Wrap">
                                                <Run Text="{Binding Type}" Foreground="{StaticResource SecondaryInkBrush}"/>
                                                <Run Text="{Binding Message}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Consequence, StringFormat=→ {0}}" Margin="0,2,0,0"
                                                       Foreground="{StaticResource SecondaryInkBrush}" TextWrapping="Wrap"
                                                       Visibility="{Binding Consequence.Length, Converter={StaticResource CountToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ 所有功能一鍵初始化 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="一鍵初始化"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="重新執行所有模組的偵測與載入（系統與硬體資訊、感測器引擎、網路／行程、磁碟資訊、螢幕色域、CUDA、超頻／顯示卡超頻引擎、winget、深度規格與體驗指數）。若某項功能在啟動時未就緒，可於此重試，不會中斷每秒監控。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ReinitBtn" Style="{StaticResource PrimaryButton}" Content="所有功能一鍵初始化" Click="Reinit_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ReinitHint" Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
