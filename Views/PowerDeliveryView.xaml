<UserControl x:Class="XinSpect.PowerDeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel MaxWidth="1100">
            <!-- 標題列 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="供電模組分析" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                <Button Grid.Column="1" Style="{StaticResource ToolButton}" Content="重新分析"
                        Click="Refresh_Click"/>
            </Grid>

            <!-- 載入中 / 錯誤 -->
            <TextBlock Text="正在分析…" FontSize="14"
                       Foreground="{DynamicResource SecondaryInkBrush}"
                       Visibility="{Binding PowerDelivery.IsLoading, Converter={StaticResource BoolToVis}}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{Binding PowerDelivery.ErrorMessage}" FontSize="14"
                       Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap"
                       Visibility="{Binding PowerDelivery.ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                       Margin="0,0,0,8"/>

            <!-- ==== 平台資訊 ==== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="平台資訊" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="主機板" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PowerDelivery.MotherboardModel}" FontSize="13"
                                   Foreground="{DynamicResource PrimaryInkBrush}"/>
                        <TextBlock Grid.Row="1" Text="CPU" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PowerDelivery.CpuName}" FontSize="13"
                                   Foreground="{DynamicResource PrimaryInkBrush}"/>
                        <TextBlock Grid.Row="2" Text="顯示卡" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PowerDelivery.GpuName}" FontSize="13"
                                   Foreground="{DynamicResource PrimaryInkBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==== VRM 分析 ==== -->
            <TextBlock Text="VRM 供電模組" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="VRM 相位數" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PowerDelivery.VrmPhaseDescription}" FontSize="13"
                                   TextWrapping="Wrap" Foreground="{DynamicResource PrimaryInkBrush}"/>

                        <TextBlock Grid.Row="1" Text="VRM 溫度" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13"
                                   Foreground="{DynamicResource PrimaryInkBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="未偵測到 (主機板未暴露 VRM 溫度感測器)"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PowerDelivery.VrmTempCelsius, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                                            <Setter Property="Text" Value="{Binding PowerDelivery.VrmTempCelsius, StringFormat={}{0:F1} °C}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Text="CPU TDP" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13"
                                   Foreground="{DynamicResource PrimaryInkBrush}"
                                   Text="{Binding PowerDelivery.CpuTdpText}"/>

                        <TextBlock Grid.Row="3" Text="能力評估" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PowerDelivery.VrmCapability}" FontSize="13"
                                   TextWrapping="Wrap" Foreground="{DynamicResource PrimaryInkBrush}"/>

                        <TextBlock Grid.Row="4" Text="建議" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PowerDelivery.VrmTierAdvice}" FontSize="13"
                                   TextWrapping="Wrap" Foreground="{DynamicResource PrimaryInkBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==== GPU 供電 ==== -->
            <TextBlock Text="GPU 供電" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="電源接頭" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Column="1" FontSize="13" Foreground="{DynamicResource PrimaryInkBrush}">
                            <Run Text="{Binding PowerDelivery.GpuConnectorType, Mode=OneWay}"/>
                            <Run Text=" ("/><Run Text="{Binding PowerDelivery.GpuConnectorWattage, Mode=OneWay}"/><Run Text="W)"/>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Text="TDP" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13"
                                   Foreground="{DynamicResource PrimaryInkBrush}"
                                   Text="{Binding PowerDelivery.GpuPowerLimit, StringFormat={}{0:F0}W (估算值)}"/>

                        <TextBlock Grid.Row="2" Text="供電狀態" FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PowerDelivery.GpuPowerSummary}" FontSize="13"
                                   TextWrapping="Wrap" Foreground="{DynamicResource PrimaryInkBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==== 電源接頭參考表 ==== -->
            <TextBlock Text="電源接頭參考" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
                <DataGrid ItemsSource="{Binding PowerDelivery.ConnectorReference}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                          BorderThickness="0" Background="Transparent"
                          RowBackground="Transparent" AlternatingRowBackground="{DynamicResource SurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="接頭類型" Binding="{Binding ConnectorName}" Width="160"/>
                        <DataGridTextColumn Header="供電 (W)" Binding="{Binding Wattage}" Width="80"/>
                        <DataGridTextColumn Header="說明" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
