<UserControl x:Class="XinSpect.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <StackPanel Margin="2,0,0,10">
                <local:SectionHead Text="Windows 授權" HelpKey="license/Windows 授權"/>
                <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="三個問題的答案：這台是不是正版、重裝之後會不會掉、能不能移到新電腦。資料取自 Windows 自己的授權服務，全程唯讀——本頁不提供啟用、變更或移除授權的功能，那是 Windows 設定裡的事。"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="狀態" HelpKey="license/狀態"/>
                        <Button Style="{StaticResource ToolButton}" Content="重新讀取"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                IsEnabled="{Binding License.CanRefresh}" Click="Refresh_Click"/>
                    </Grid>

                    <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource Surface2Brush}">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding License.Verdict.Headline}"
                                       Foreground="{Binding License.Verdict.Severity, Converter={StaticResource SeverityToBrush}}"/>
                            <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource SecondaryInkBrush}"
                                       Text="{Binding License.Verdict.Detail}"/>
                        </StackPanel>
                    </Border>

                    <local:FieldRow Label="版本" Value="{Binding License.EditionText}"/>
                    <local:FieldRow Label="授權通道" Value="{Binding License.ChannelText}"/>
                    <local:FieldRow Label="金鑰後五碼" Value="{Binding License.PartialKeyText}"/>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{Binding License.Status}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,32">
                <StackPanel>
                    <local:SectionHead Text="韌體內嵌金鑰" HelpKey="license/韌體內嵌金鑰"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="品牌機與預裝 Windows 的機器通常會把金鑰寫在主機板韌體裡，重裝時自動帶入。這一欄預設遮蔽；按下按鈕才顯示，而且只顯示在畫面上——不寫入任何檔案、不進診斷紀錄、不隨報告匯出。"/>

                    <TextBlock Text="{Binding License.KeyText}" FontFamily="Consolas" FontSize="15"
                               Foreground="{DynamicResource PrimaryInkBrush}" TextWrapping="Wrap"/>

                    <Button Style="{StaticResource ToolButton}" Content="顯示／隱藏完整金鑰"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            IsEnabled="{Binding License.HasFullKey}" Click="Reveal_Click"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="金鑰是這台機器的憑證，貼給別人等於把授權交出去。抄下來收好就把它藏回去。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
