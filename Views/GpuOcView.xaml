<UserControl x:Class="XinSpect.GpuOcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- ══ 深色滑桿（沿用超頻分頁風格）═══════════════════════════════════════ -->
        <Style x:Key="GpuSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="3" Background="{StaticResource HairlineBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3" Background="{StaticResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White"
                                                         Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ══ 深色核取方塊 ═══════════════════════════════════════════════════ -->
        <Style x:Key="GpuCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1.2">
                                <Path x:Name="check" Width="12" Height="12" Stretch="Uniform"
                                      Data="M2,8 L6,12 L14,3" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0" DataContext="{Binding GpuOc}">

            <!-- 標題 -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <TextBlock Style="{StaticResource Title}" Text="顯示卡超頻"/>
                <Border Background="{StaticResource WarningBrush}" CornerRadius="5" Padding="7,2" Margin="12,3,0,0" VerticalAlignment="Center">
                    <TextBlock Text="測試版・真實寫入" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Subtitle}" Margin="2,0,0,14"
                       Text="{Binding GpuName, StringFormat=裝置：{0}}"/>

            <!-- 可用性 / 權限 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="狀態"/>
                    <TextBlock Text="{Binding AvailabilityText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryInkBrush}" FontSize="12.5"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedInkBrush}"
                               Text="功耗上限、風扇與溫度上限透過 NVML（NVIDIA 官方介面）；核心／顯示記憶體頻率偏移透過 NVAPI 私有介面（帶版本保護，若驅動不支援僅會回報「無法套用」，不會寫入異常值）。每次套用皆檢查回傳碼並如實顯示結果。"/>
                </StackPanel>
            </Border>

            <!-- 即時遙測 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="即時狀態"/>
                    <UniformGrid Columns="5" Margin="0,6,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="核心時脈"/>
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding CoreClockMhz, StringFormat={}{0:0} MHz}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="顯示記憶體時脈"/>
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding MemClockMhz, StringFormat={}{0:0} MHz}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="溫度"/>
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding TempC, StringFormat={}{0:0} °C}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="功耗"/>
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding PowerW, StringFormat={}{0:0} W}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="風扇"/>
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding FanPercent, StringFormat={}{0:0} %}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 最大功耗限制 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="最大功耗限制"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                                   Text="{Binding PowerLimitPercent, StringFormat={}{0:0} %}"/>
                    </Grid>
                    <Slider Style="{StaticResource GpuSlider}" Margin="0,8,0,2"
                            Minimum="{Binding PowerPctMin}" Maximum="{Binding PowerPctMax}"
                            Value="{Binding PowerLimitPercent, Mode=TwoWay}"/>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Foreground="{StaticResource MutedInkBrush}" FontSize="11.5"
                                   Text="{Binding PowerDefaultW, StringFormat=預設功耗 {0:0} W ・ 100% 為原廠上限}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5"
                                   Text="{Binding PowerLimitW, StringFormat=目前 {0:0} W}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="套用功耗上限" Click="Power_Click"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" Text="{Binding PowerStatus}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 最高溫度限制 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="最高溫度限制"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                                   Text="{Binding TargetTempLimitC, StringFormat={}{0:0} °C}"/>
                    </Grid>
                    <Slider Style="{StaticResource GpuSlider}" Margin="0,8,0,2"
                            Minimum="{Binding TempLimitMin}" Maximum="{Binding TempLimitMax}"
                            Value="{Binding TargetTempLimitC, Mode=TwoWay}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5"
                               Text="{Binding TempLimitNow, StringFormat=目前上限 {0:0} °C ・ 達到此溫度將自動降頻保護}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="套用溫度上限" Click="Temp_Click"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" Text="{Binding TempStatus}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 核心頻率偏移 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="核心頻率偏移"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                                   Text="{Binding TargetCoreOffsetMhz, StringFormat={}{0:+0;-0;0} MHz}"/>
                    </Grid>
                    <Slider Style="{StaticResource GpuSlider}" Margin="0,8,0,2"
                            Minimum="{Binding CoreOffMin}" Maximum="{Binding CoreOffMax}"
                            Value="{Binding TargetCoreOffsetMhz, Mode=TwoWay}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5"
                               Text="{Binding CoreOffsetNow, StringFormat=目前偏移 {0:+0;-0;0} MHz ・ 相對原廠曲線的核心頻率位移}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="套用核心偏移" Click="Core_Click"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" Text="{Binding CoreStatus}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 顯示記憶體頻率偏移 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="顯示記憶體頻率偏移"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                                   Text="{Binding TargetMemOffsetMhz, StringFormat={}{0:+0;-0;0} MHz}"/>
                    </Grid>
                    <Slider Style="{StaticResource GpuSlider}" Margin="0,8,0,2"
                            Minimum="{Binding MemOffMin}" Maximum="{Binding MemOffMax}"
                            Value="{Binding TargetMemOffsetMhz, Mode=TwoWay}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5"
                               Text="{Binding MemOffsetNow, StringFormat=目前偏移 {0:+0;-0;0} MHz ・ GDDR 具錯誤更正，過高會降速反而變慢}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="套用顯示記憶體偏移" Click="Mem_Click"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" Text="{Binding MemStatus}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 風扇轉速控制 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="風扇轉速控制"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                                   Text="{Binding TargetFanPercent, StringFormat={}{0:0} %}"/>
                    </Grid>
                    <CheckBox Style="{StaticResource GpuCheck}" Margin="0,8,0,0" Content="手動控制風扇轉速（取消勾選＝還原自動）"
                              IsChecked="{Binding FanManual, Mode=TwoWay}"/>
                    <Slider Style="{StaticResource GpuSlider}" Margin="0,10,0,2" Minimum="0" Maximum="100"
                            IsEnabled="{Binding FanManual}"
                            Value="{Binding TargetFanPercent, Mode=TwoWay}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5"
                               Text="固定風扇轉速可壓低溫度，但風扇壽命與噪音需自行權衡；取消手動即恢復驅動自動調速。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="套用風扇設定" Click="Fan_Click"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" Text="{Binding FanStatus}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 全域動作 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Style="{StaticResource PrimaryButton}" Content="一鍵套用全部" Click="ApplyAll_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource ToolButton}" Content="還原安全預設" Click="Restore_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

