<UserControl x:Class="XinSpect.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <local:SectionHead Text="處理器" HelpKey="cpu/處理器"/>

            <!-- 品牌徽章 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="0">
                <local:BrandBadge Kind="Cpu" EmblemSize="54"
                                  Brand="{Binding Cpu.Brand}" Model="{Binding Cpu.Name}"
                                  CpuModel="{Binding Cpu.Name}"/>
            </Border>

            <Grid local:Anim.RevealDelay="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <local:SectionHead Text="規格" HelpKey="cpu/規格"/>
                        <local:FieldRow Label="型號" Value="{Binding Cpu.Name}"/>
                        <local:FieldRow Label="製造商" Value="{Binding Cpu.Manufacturer}"/>
                        <local:FieldRow Label="插槽" Value="{Binding Cpu.Socket}"/>
                        <local:FieldRow Label="實體核心" Value="{Binding Cpu.Cores, StringFormat={}{0} 核}"/>
                        <local:FieldRow Label="已啟用核心" Value="{Binding Cpu.EnabledCoresText}"/>
                        <local:FieldRow Label="邏輯處理器" Value="{Binding Cpu.Threads, StringFormat={}{0} 執行緒}"/>
                        <local:FieldRow Label="額定頻率" Value="{Binding Cpu.MaxClockMHz, StringFormat={}{0:0} MHz}"/>
                        <local:FieldRow Label="外頻 / 基準匯流排" Value="{Binding Cpu.ExtClockText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <local:SectionHead Text="即時狀態" HelpKey="cpu/即時狀態"/>
                        <local:FieldRow Label="目前最高時脈" Value="{Binding Live.CpuClockText}"/>
                        <local:FieldRow Label="總使用率" Value="{Binding Live.CpuLoadText}"/>
                        <local:FieldRow Label="封裝溫度" Value="{Binding Live.CpuTempText}"/>
                        <local:FieldRow Label="封裝功耗" Value="{Binding Live.CpuPowerText}"/>
                        <local:FieldRow Label="核心電壓" Value="{Binding Live.CpuVoltText}"/>
                        <local:FieldRow Label="匯流排時脈" Value="{Binding Live.CpuBusText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 完整規格（合併識別碼 / 深度規格 CPU-Z / 拓撲 / 快取 / 指令集，去除重複欄位） -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="80">
                <StackPanel>
                    <local:SectionHead Text="完整規格" HelpKey="cpu/完整規格"/>

                    <!-- 識別碼與平台能力（WMI，永遠可用） -->
                    <TextBlock Style="{StaticResource ColHead}" Text="識別碼與平台能力" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <local:FieldRow Label="CPUID 家族" Value="{Binding Cpu.Family}"/>
                            <local:FieldRow Label="CPUID 型號" Value="{Binding Cpu.ModelNo}"/>
                            <local:FieldRow Label="CPUID 步進" Value="{Binding Cpu.SteppingId}"/>
                            <local:FieldRow Label="處理器修訂" Value="{Binding Cpu.Revision}"/>
                            <local:FieldRow Label="處理器識別碼" Value="{Binding Cpu.ProcessorId}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <local:FieldRow Label="位址寬度" Value="{Binding Cpu.AddressWidthText}"/>
                            <local:FieldRow Label="資料寬度" Value="{Binding Cpu.DataWidthText}"/>
                            <local:FieldRow Label="韌體回報電壓" Value="{Binding Cpu.CurrentVoltageText}"/>
                            <local:FieldRow Label="虛擬化 (VT-x/AMD-V)" Value="{Binding Cpu.Virtualization}"/>
                            <local:FieldRow Label="二階位址轉譯 (EPT/NPT)" Value="{Binding Cpu.Slat}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 深度識別（CPU-Z） -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding CpuDetail.Loaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource ColHead}" Text="深度識別（CPU-Z）" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <local:FieldRow Label="核心代號" Value="{Binding CpuDetail.Codename}"/>
                                <local:FieldRow Label="規格全名" Value="{Binding CpuDetail.Specification}"/>
                                <local:FieldRow Label="封裝" Value="{Binding CpuDetail.Package}"/>
                                <local:FieldRow Label="製程" Value="{Binding CpuDetail.Technology}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <local:FieldRow Label="CPUID" Value="{Binding CpuDetail.CpuId}"/>
                                <local:FieldRow Label="延伸 CPUID" Value="{Binding CpuDetail.ExtCpuId}"/>
                                <local:FieldRow Label="微碼" Value="{Binding CpuDetail.Microcode}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <!-- 頻率・功耗・熱設計（CPU-Z；即時時脈/電壓見上方「即時狀態」，此處不重複） -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding CpuDetail.Loaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource ColHead}" Text="頻率・功耗・熱設計" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <local:FieldRow Label="倍頻" Value="{Binding CpuDetail.Multiplier}"/>
                                <local:FieldRow Label="出廠頻率" Value="{Binding CpuDetail.StockFreq}"/>
                                <local:FieldRow Label="基礎頻率" Value="{Binding CpuDetail.MaxNonTurbo}"/>
                                <local:FieldRow Label="最高睿頻" Value="{Binding CpuDetail.MaxTurbo}"/>
                                <local:FieldRow Label="最高效能比" Value="{Binding CpuDetail.MaxEfficiency}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <local:FieldRow Label="TDP" Value="{Binding CpuDetail.TdpLimit}"/>
                                <local:FieldRow Label="Tjmax" Value="{Binding CpuDetail.Tjmax}"/>
                                <local:FieldRow Label="功耗上限 PL1" Value="{Binding CpuDetail.PowerMaxPl1}"/>
                                <local:FieldRow Label="PL1 時間窗" Value="{Binding CpuDetail.Pl1Window}"/>
                                <local:FieldRow Label="功耗上限 PL2" Value="{Binding CpuDetail.PowerMaxPl2}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 各核心數睿頻倍頻表 -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding CpuDetail.HasTurboRatios, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource ColHead}" Text="睿頻倍頻（依作用中核心數）" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding CpuDetail.TurboRatios}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="5"
                                                Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    <!-- 快取階層：優先顯示作業系統原生明細（含容量/組關聯/快取行/共用執行緒，永遠可讀）；
                         僅在原生明細讀不到時，才退回顯示 CPU-Z 的靜態容量，避免同一份資料重複兩次。 -->
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource ColHead}" Text="快取階層" Margin="0,0,0,6"/>
                        <Grid Visibility="{Binding CpuTopology.HasCaches, Converter={StaticResource InverseBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <local:FieldRow Label="L1 資料快取" Value="{Binding CpuDetail.L1D}"/>
                                <local:FieldRow Label="L1 指令快取" Value="{Binding CpuDetail.L1I}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <local:FieldRow Label="L2 快取" Value="{Binding CpuDetail.L2}"/>
                                <local:FieldRow Label="L3 快取" Value="{Binding CpuDetail.L3}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,4,0,0"
                                    Visibility="{Binding CpuTopology.HasCaches, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding CpuTopology.Caches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:FieldRow Label="{Binding Label}" Value="{Binding Detail}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- 拓撲（作業系統原生；核心/執行緒總數見上方「規格」，此處不重複） -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding CpuTopology.Loaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource ColHead}" Text="拓撲（作業系統原生）" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <local:FieldRow Label="實體封裝 (插槽)" Value="{Binding CpuTopology.PackagesText}"/>
                                <local:FieldRow Label="同步多執行緒" Value="{Binding CpuTopology.SmtText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <local:FieldRow Label="NUMA 節點" Value="{Binding CpuTopology.NumaText}"/>
                                <local:FieldRow Label="處理器群組" Value="{Binding CpuTopology.GroupsText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <!-- 指令集與平台能力旗標 -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding CpuDetail.Loaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource ColHead}" Text="指令集" Margin="0,0,0,4"/>
                        <local:FieldRow Label="支援指令集" Value="{Binding CpuDetail.Instructions}"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding CpuTopology.Loaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource ColHead}" Text="平台能力（作業系統回報）" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding CpuTopology.Features}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="5"
                                            Padding="10,5" Margin="0,0,6,6">
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 即時走勢 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="120">
                <StackPanel>
                    <local:SectionHead Text="即時走勢（近 90 秒）" HelpKey="cpu/即時走勢（近 90 秒）"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <local:HistoryGraph Grid.Column="0" Height="112" Margin="0,0,6,0" Caption="使用率 (%)"
                                            History="{Binding CpuLoadHist}" Stroke="{DynamicResource AccentBrush}"/>
                        <local:HistoryGraph Grid.Column="1" Height="112" Margin="3,0,3,0" Caption="溫度 (°C)"
                                            History="{Binding CpuTempHist}" Stroke="{DynamicResource SeriousBrush}"/>
                        <local:HistoryGraph Grid.Column="2" Height="112" Margin="6,0,0,0" Caption="時脈 (MHz)"
                                            History="{Binding CpuClockHist}" Stroke="{DynamicResource GoodBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 各邏輯處理器使用率（仿 Windows 工作管理員格狀曲線） -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="150">
                <StackPanel>
                    <local:SectionHead Text="各邏輯處理器使用率（仿工作管理員）" HelpKey="cpu/各邏輯處理器使用率（仿工作管理員）"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,10"
                               Text="{Binding CoreLoads.Count, StringFormat=每格為一顆邏輯處理器（共 {0} 顆）・ 0–100% ・ 近 90 秒}"/>
                    <ItemsControl ItemsSource="{Binding CoreLoads.Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:HistoryGraph Width="140" Height="66" Margin="0,0,6,6"
                                                    Caption="{Binding Label}"
                                                    History="{Binding History}"
                                                    Stroke="{DynamicResource AccentBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="180">
                <StackPanel>
                    <local:SectionHead Text="各核心即時" HelpKey="cpu/各核心即時"/>
                    <!-- 逐核液柱：一核一管，液面＝使用率、顏色＝溫度（與熱區圖同一套色階） -->
                    <local:CoreColumns Cores="{Binding Live.CpuCores}" Height="150" Margin="0,10,0,4"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="管壁上的細線是最近數秒的高點——瞬間的滿載不會留在每秒取樣裡，這條線會。灰管＝拿不到那顆核心的溫度，不是它涼。"/>
                    <!-- 表頭 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" Text="核心"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="時脈"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="使用率"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="溫度" TextAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Live.CpuCores}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ClockText}"/>
                                    <Grid Grid.Column="2" Margin="0,0,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Style="{StaticResource LoadBar}" Value="{Binding LoadPercent, Mode=OneWay}"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LoadText}"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding TempText}"
                                               TextAlignment="Right"
                                               Foreground="{Binding TempSeverity, Converter={StaticResource SeverityToBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 核心到核心延遲 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="核心到核心延遲" HelpKey="cpu/核心到核心延遲"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="CoreLatencyStop_Click" IsEnabled="{Binding CoreLatency.IsRunning}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="開始量測"
                                    Click="CoreLatencyStart_Click" IsEnabled="{Binding CoreLatency.CanStart}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="兩個執行緒各自釘在指定的邏輯處理器上，對同一條快取線做原子交換，量其往返延遲（多輪取中位數，ns）。可看出 SMT 兄弟（同實體核）、同 mesh 與跨 mesh 的層次差異。量測期間參與的邏輯處理器滿載；僅支援單一處理器群組（≤64 邏輯處理器）。"/>
                    <ProgressBar Style="{StaticResource LoadBar}" Value="{Binding CoreLatency.ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding CoreLatency.StatusLine}"/>
                    <local:CoreLatencyHeatmap x:Name="Heat" Margin="0,10,0,0" MinHeight="300"
                                              Data="{Binding CoreLatency.MatrixNs}" Lps="{Binding CoreLatency.Lps}"/>
                    <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryInkBrush}" Text="{Binding HoverText, ElementName=Heat}"/>
                </StackPanel>
            </Border>

            <!-- ===== Intel RDT 監測（逐核心 L3 占用與記憶體頻寬） ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="L3 占用與記憶體頻寬（Intel RDT）" HelpKey="cpu/L3 占用與記憶體頻寬（Intel RDT）"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="RdtStop_Click" IsEnabled="{Binding Rdt.IsRunning}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="開始監測"
                                    Click="RdtStart_Click" IsEnabled="{Binding Rdt.CanStart}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,4" TextWrapping="Wrap"
                               Text="全核指派同一個 RMID（PQR_ASSOC），每秒逐核心經 QM_EVTSEL／QM_CTR 讀 L3 快取占用（即時值）與記憶體頻寬（區間差分）。占用量以 CPUID 0x0F.1 的 upscaling 換算成位元組，與 Linux resctrl 的 mon_scale 是同一個值。"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="誠實界線：RMID 全核統一指派，因此得到的是「全系統＋逐核心」視角，做不到逐行程歸屬（那需要核心層的 RMID 排程）。QM_CTR 回報 Error／Unavailable 旗標時顯示「—」，絕不把錯誤碼當讀值。若整片為 0，最可能是本機 BIOS／平台未開放 RDT 監測——那就如實顯示 0。"/>
                    <UniformGrid Rows="1" Columns="2" Margin="0,0,0,6">
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="全系統記憶體頻寬" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Rdt.TotalBwText}" FontSize="20" Margin="0,2,0,0"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="狀態" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Rdt.Status}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Rdt.SupportText}"/>
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="邏輯處理器"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="L3 占用"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="占用量" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="總頻寬" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="本機頻寬" TextAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Rdt.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}" Text="{Binding LpText}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource LoadBar}" Maximum="1" VerticalAlignment="Center"
                                                 Margin="0,0,10,0" Value="{Binding BarFraction, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding OccupancyText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding TotalBwText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding LocalBwText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 頻率真相（倍頻表、實際 BCLK、逐核有效時脈） ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="頻率真相（倍頻表與實際 BCLK）" HelpKey="cpu/頻率真相（倍頻表與實際 BCLK）"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="讀取並量測" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="FreqTruthRead_Click" IsEnabled="{Binding FreqTruth.CanStart}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,4" TextWrapping="Wrap"
                               Text="全部來自 MSR 直讀與實測，不解析任何第三方報告：0xCE（PLATFORM_INFO）給基頻／最低效能倍頻與倍頻是否解鎖；0x10（TSC）對 QPC 實測 TSC 頻率，除以基頻倍頻得到實際 BCLK（不假設 100 MHz）；0x1AD／0x1AE 給渦輪倍頻表；0xE7／0xE8（MPERF／APERF）差分給逐邏輯處理器的有效時脈。"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="誠實界線：倍頻表是「目前的設定」而非原廠規格——BIOS 解鎖改過就是改過的值，本工具不還原成規格書數字。有效時脈是取樣窗內的平均，不是瞬時峰值。「黃金核心」需要 HWP 的逐核心 Highest Performance（MSR 0x771）；讀不到就不宣稱任何一顆是黃金核心。"/>
                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,6">
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="實際 BCLK" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding FreqTruth.BclkText}" FontSize="20" Margin="0,2,0,0"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="實測 TSC 頻率" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding FreqTruth.TscText}" FontSize="20" Margin="0,2,0,0"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="基頻倍頻" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding FreqTruth.BaseText}" FontSize="17" Margin="0,2,0,0"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                                <TextBlock Text="{Binding FreqTruth.MinText}" Style="{StaticResource Subtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="倍頻鎖定" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding FreqTruth.UnlockText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding FreqTruth.Status}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding FreqTruth.HwpText}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding FreqTruth.CrossCheckText}"/>

                    <TextBlock Text="渦輪倍頻表" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,6" TextWrapping="Wrap" Text="{Binding FreqTruth.TurboNote}"/>
                    <ItemsControl ItemsSource="{Binding FreqTruth.TurboRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Opacity="{Binding Opacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}" Text="{Binding CoresText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding RatioText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding FreqText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Subtitle}" Text="{Binding Note}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="逐邏輯處理器有效時脈（實測）" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,4,0,4"/>
                    <ItemsControl ItemsSource="{Binding FreqTruth.ClockRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}" Text="{Binding LpText}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource LoadBar}" Maximum="1" VerticalAlignment="Center"
                                                 Margin="0,0,10,0" Value="{Binding BarFraction, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding MhzText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding RatioText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== CPUID 晶片直讀 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <local:SectionHead Text="CPUID 晶片直讀" HelpKey="cpu/CPUID 晶片直讀"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="以 .NET 內建的 CPUID 指令直接問矽晶片：快取真實幾何、指令集位元、標稱頻率與拓樸層級。超出最大葉位的葉絕不讀取（會回傳無意義值）；讀不到的項目顯示「—」。"/>
                    <ItemsControl ItemsSource="{Binding CpuId.Info}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="快取幾何（leaf 0x04，實測容量＝路數×分割×行×集合）"/>
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="層級"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="容量"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="相聯度"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="行大小"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="集合數"/>
                        <TextBlock Grid.Column="5" Style="{StaticResource ColHead}" Text="共用上界"/>
                        <TextBlock Grid.Column="6" Style="{StaticResource ColHead}" Text="含括下層"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CpuId.Caches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Level}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Capacity}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding Ways}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding Line}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding Sets}"/>
                                    <TextBlock Grid.Column="5" Style="{StaticResource FieldValue}" Text="{Binding Shared}"/>
                                    <TextBlock Grid.Column="6" Style="{StaticResource FieldValue}" Text="{Binding Inclusive}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="「共用上界」是 CPUID 給的可定址邏輯處理器數（EAX 25:14＋1），硬體會向上取到 2 的冪次，只能當上界看：18 核 36 執行緒的 L3 會回「最多 64 執行緒」，那不代表有 64 個核心。「含括下層」讀 EDX 位 1；L1 之下沒有更低階快取，這一欄對它沒有意義，故留「—」。"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding CpuId.FrequencyText, StringFormat=標稱頻率：{0}}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="拓樸層級（0x1F／0x0B）"/>
                    <ItemsControl ItemsSource="{Binding CpuId.Topology}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource FieldValue}" Margin="0,2">
                                    <Run Text="{Binding Leaf, Mode=OneWay}"/>
                                    <Run Text="{Binding Level, Mode=OneWay}"/>
                                    <Run Text="{Binding Count, Mode=OneWay}"/>
                                    <Run Text="{Binding Shift, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="每一列的數字是「該層在上一層範圍內的邏輯處理器數」（EBX 15:0），不是那一層有幾個實例：SMT 層是每個核心的執行緒數，核心層是每個封裝的邏輯處理器數（18 核 36 執行緒會回 36）。"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4"
                               Text="{Binding CpuId.Features.Count, Mode=OneWay, StringFormat=指令集與功能位元（{0} 項支援）}"/>
                    <ItemsControl ItemsSource="{Binding CpuId.Features}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="8,3" Margin="0,0,6,6"
                                        ToolTip="{Binding Source}">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryInkBrush}" Text="{Binding Name}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="熱能與電源管理能力（leaf 0x06）"
                               Visibility="{Binding CpuId.HasPower, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding CpuId.Power}"
                                  Visibility="{Binding CpuId.HasPower, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Key}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="架構效能監測單元（leaf 0x0A，決定 Top-down 卡片能不能跑）"
                               Visibility="{Binding CpuId.HasPmu, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding CpuId.Pmu}"
                                  Visibility="{Binding CpuId.HasPmu, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Key}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="XSAVE 狀態元件（leaf 0x0D，每次執行緒切換要搬多少位元組）"
                               Visibility="{Binding CpuId.HasXSave, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding CpuId.XSave}"
                                  Visibility="{Binding CpuId.HasXSave, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Key}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 黏滯節流位元 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="黏滯節流位元" HelpKey="cpu/黏滯節流位元"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="讀取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="StickyRead_Click" IsEnabled="{Binding ThermalSticky.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="IA32_PACKAGE_THERM_STATUS（0x1B1）的 log 位元是「發生過就保持為 1」的紀錄：使用者說會頓但開監控時又不頓，這裡能回答自開機以來到底有沒有撞過溫度牆／功耗牆。唯讀，本程式不清除位元。"/>
                    <ItemsControl ItemsSource="{Binding ThermalSticky.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" TextAlignment="Right"
                                               Foreground="{DynamicResource PrimaryInkBrush}" Text="{Binding StateText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ThermalSticky.Status}"/>
                </StackPanel>
            </Border>

            <!-- ===== 安全緩解狀態 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="安全緩解狀態" HelpKey="cpu/安全緩解狀態"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="讀取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="SecurityRead_Click" IsEnabled="{Binding CpuSecurity.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="IA32_ARCH_CAPABILITIES（0x10A）＝晶片自己宣告的免疫位元；IA32_SPEC_CTRL（0x48）＝作業系統目前實際啟用的緩解。兩者並列即為誠實呈現——全部量到，不需要會過期的漏洞資料庫；不宣稱「你受某 CVE 影響」。"/>
                    <ItemsControl ItemsSource="{Binding CpuSecurity.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" TextAlignment="Right"
                                               Foreground="{DynamicResource PrimaryInkBrush}" Text="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding CpuSecurity.Status}"/>
                </StackPanel>
            </Border>
            <!-- ===== 逐核時間歸因（NtQuerySystemInformation） ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="逐核時間歸因（閒置／使用者／核心／DPC／中斷）" HelpKey="cpu/逐核時間歸因（閒置／使用者／核心／DPC／中斷）"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="取樣" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="CoreTimeSample_Click" IsEnabled="{Binding CoreTime.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,4" TextWrapping="Wrap"
                               Text="工作管理員與 perfmon 用的同一份計數器（NtQuerySystemInformation，零特權）。取兩次樣求差約一秒——不報自開機以來的累計平均，那會把三天前的一次編譯攤平成看不出問題的數字。"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="{Binding CoreTime.ReadingNotice}"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="處理器"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="忙碌"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" TextAlignment="Right" Text="忙碌%"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" TextAlignment="Right" Text="使用者"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" TextAlignment="Right" Text="核心"/>
                        <TextBlock Grid.Column="5" Style="{StaticResource ColHead}" TextAlignment="Right" Text="DPC"/>
                        <TextBlock Grid.Column="6" Style="{StaticResource ColHead}" TextAlignment="Right" Text="中斷"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CoreTime.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource LoadBar}" Margin="0,6,10,6"
                                                 Value="{Binding BusyPercent, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" TextAlignment="Right"
                                               Foreground="{DynamicResource PrimaryInkBrush}" Text="{Binding BusyText}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" TextAlignment="Right" Text="{Binding UserText}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" TextAlignment="Right" Text="{Binding KernelText}"/>
                                    <TextBlock Grid.Column="5" Style="{StaticResource FieldValue}" TextAlignment="Right"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" Text="{Binding DpcText}"/>
                                    <TextBlock Grid.Column="6" Style="{StaticResource FieldValue}" TextAlignment="Right"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" Text="{Binding InterruptText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,10,0,0" TextWrapping="Wrap"
