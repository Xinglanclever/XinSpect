                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding CoreTime.Status}"/>
                </StackPanel>
            </Border>

            <!-- 隱形停頓：SMI 次數與 C-state 駐留（全唯讀 MSR） -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="隱形停頓（SMI 與 C-state 駐留）" HelpKey="cpu/隱形停頓（SMI 與 C-state 駐留）"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="量一次"
                                HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="110"
                                IsEnabled="{Binding InvisibleStall.CanMeasure}" Click="InvisibleStallMeasure_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="系統管理中斷（SMI）由韌體處理，發生時核心離開作業系統的視野——工作管理員永遠是 0%，但音訊會爆、幀時間會有尖峰。硬體只留下次數，沒有留下每次待了多久，所以本卡片只給頻率，不換算損失時間。C-state 駐留則說明封裝與核心真的睡了多久：閒著卻沒睡，代表有東西定期把它叫起來。"/>

                    <local:FieldRow Label="SMI 累計（自開機）" Value="{Binding InvisibleStall.SmiTotalText}"/>
                    <local:FieldRow Label="SMI 頻率" Value="{Binding InvisibleStall.SmiRateText}"/>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,10"
                            Visibility="{Binding InvisibleStall.Rows.Count, Converter={StaticResource CountToVis}}"/>
                    <ItemsControl ItemsSource="{Binding InvisibleStall.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                                   Text="{Binding Text}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="110,1,0,0"
                                               Text="{Binding Note}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource Surface2Brush}">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding InvisibleStall.Verdict.Headline}"
                                       Foreground="{Binding InvisibleStall.Verdict.Severity, Converter={StaticResource SeverityToBrush}}"/>
                            <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource SecondaryInkBrush}"
                                       Text="{Binding InvisibleStall.Verdict.Detail}"/>
                            <TextBlock Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{Binding InvisibleStall.Status}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
