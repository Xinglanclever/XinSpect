<UserControl x:Class="XinSpect.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:XinSpect">
    <UserControl.Resources>
        <!-- 網址列與工具列樣式（本檢視自帶，主題未定義 TextBox）。底色一律走佈景資源：
             寫死深色會讓淺色主題的網址列變成深底黑字。 -->
        <Style x:Key="AddressBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 由他頁跳轉而來（如網速測試）時的返回鈕：文字寬度自動 -->
        <Style x:Key="ReturnBtn" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具列：WrapPanel 自動換行——窄窗／低 DPI 時網址列與按鈕折到下一行，不再水平截斷。
             網址列以固定寬度參與折行（WrapPanel 不支援 * 填滿），寬窗時一行容納，窄窗時自動獨立一行。 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="8,8" Margin="0,0,0,8"
                CornerRadius="10">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="BackBtn" Style="{StaticResource NavBtn}" Click="Back_Click"   Content="‹"  ToolTip="上一頁"/>
                <Button x:Name="FwdBtn"  Style="{StaticResource NavBtn}" Click="Forward_Click" Content="›"  ToolTip="下一頁"/>
                <Button x:Name="ReloadBtn" Style="{StaticResource NavBtn}" Click="Reload_Click" Content="⟳" ToolTip="重新整理"/>
                <Button x:Name="HomeBtn" Style="{StaticResource NavBtn}" Click="Home_Click"   Content="⌂"  ToolTip="首頁（硬體導航）"/>
                <Button x:Name="ReturnUtilityBtn" Style="{StaticResource ReturnBtn}" Click="ReturnUtility_Click"
                        Content="⟨ 回到測速頁面" ToolTip="回到網速測試頁" Visibility="Collapsed" Margin="6,0,2,0"/>
                <TextBox x:Name="AddressBar" Width="420" MinWidth="200" Margin="8,4" VerticalAlignment="Center"
                         Style="{StaticResource AddressBox}" KeyDown="AddressBar_KeyDown"/>
                <Button Style="{StaticResource NavBtn}" Click="Go_Click" Content="→" ToolTip="前往" VerticalAlignment="Center"/>
                <Button Style="{StaticResource NavBtn}" Click="OpenExternal_Click" Content="↗" ToolTip="以系統瀏覽器開啟目前網址" VerticalAlignment="Center"/>
                <Button Style="{StaticResource NavBtn}" Click="Downloads_Click" Content="⬇" ToolTip="開啟下載資料夾（%LOCALAPPDATA%\XinSpect\Downloads）" VerticalAlignment="Center"/>
                <Button Style="{StaticResource NavBtn}" Click="FindToggle_Click" Content="🔍" ToolTip="頁內尋找（Ctrl＋F 亦可在網址列有焦點時用；頁面內按 Ctrl＋F 由 Chromium 自己處理）" VerticalAlignment="Center"/>
                <Button Style="{StaticResource NavBtn}" Click="ClearData_Click" Content="🧹" ToolTip="清除瀏覽資料（Cookie、快取、本機儲存）" VerticalAlignment="Center"/>
                <Button Style="{StaticResource NavBtn}" Click="ZoomOut_Click" Content="−" ToolTip="縮小（Ctrl＋滾輪亦可；範圍 50%–200%）" VerticalAlignment="Center"/>
                <Button x:Name="ZoomResetBtn" Style="{StaticResource ReturnBtn}" Click="ZoomReset_Click"
                        Content="100%" ToolTip="重設縮放為 100%" VerticalAlignment="Center" Margin="2,0"/>
                <Button Style="{StaticResource NavBtn}" Click="ZoomIn_Click" Content="＋" ToolTip="放大（Ctrl＋滾輪亦可；範圍 50%–200%）" VerticalAlignment="Center"/>
                <local:HelpDot HelpKey="browser/瀏覽器" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- 頁內尋找列：預設收起，按工具列的 🔍 或 Ctrl＋F 打開 -->
        <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}"
                Padding="8,6" Margin="0,0,0,8" CornerRadius="10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="頁內尋找" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <TextBox x:Name="FindBox" Width="240" Style="{StaticResource AddressBox}" Margin="0,0,8,0"
                         KeyDown="FindBox_KeyDown"/>
                <Button Style="{StaticResource ToolButton}" Content="上一個" Margin="0,0,6,0" Click="FindPrev_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="下一個" Margin="0,0,6,0" Click="FindNext_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="關閉" Click="FindClose_Click"/>
                <TextBlock x:Name="FindHint" Style="{StaticResource Subtitle}" VerticalAlignment="Center"
                           Margin="10,0,0,0" TextWrapping="Wrap"/>
            </WrapPanel>
        </Border>

        <!-- WebView2 承載區（含未安裝執行階段時的後備提示） -->
        <Border Grid.Row="2" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource PagePlaneBrush}">
            <Grid>
                <wv2:WebView2 x:Name="Web" PreviewMouseWheel="Web_PreviewMouseWheel"/>
                <Border x:Name="Fallback" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="內建瀏覽器無法啟動" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryInkBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FallbackMsg" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryInkBrush}" TextAlignment="Center"/>
                        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center">
                            <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"
                                       RequestNavigate="Link_RequestNavigate"
                                       Foreground="{DynamicResource AccentBrush}">下載 WebView2 執行階段</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- B：頂端細載入進度條（NavigationStarting 顯示、Completed 隱藏） -->
                <ProgressBar x:Name="LoadBar" Height="3" VerticalAlignment="Top" IsIndeterminate="True"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>

                <!-- 載入失敗頁：WebView2 預設只會留一片空白，使用者看不出是「網站掛了」還是「網路斷了」 -->
                <Border x:Name="NavError" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="24">
                        <TextBlock Text="這個頁面沒有載入成功" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryInkBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NavErrorMsg" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Foreground="{DynamicResource SecondaryInkBrush}" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Style="{StaticResource ToolButton}" Content="重試" Margin="0,0,10,0"
                                    Click="NavErrorRetry_Click"/>
                            <Button Style="{StaticResource ToolButton}" Content="回首頁" Click="NavErrorHome_Click"/>
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource SecondaryInkBrush}"
                                   Text="提示：內建瀏覽器只開 http／https，且不會略過 TLS 憑證警告。"/>
                    </StackPanel>
                </Border>

                <!-- 提示條：被擋下的連結、下載位置、權限拒絕都寫在這裡（9 秒後自動收起） -->
                <Border x:Name="Notice" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="12" Padding="12,8" CornerRadius="8" MaxWidth="620"
                        Background="{DynamicResource Surface2Brush}" BorderThickness="1"
                        BorderBrush="{DynamicResource HairlineBrush}">
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource PrimaryInkBrush}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
