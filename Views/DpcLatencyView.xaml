<UserControl x:Class="XinSpect.DpcLatencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <StackPanel Margin="2,0,0,10">
                <local:SectionHead Text="DPC／ISR 延遲" HelpKey="dpc/DPC／ISR 延遲"/>
                <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="量每一支驅動的 DPC／ISR 在 CPU 上的執行時長，排出肇事模組排行（ETW 核心追蹤，零驅動安裝）。音訊爆音、滑鼠瞬間停頓、串流掉幀，往往是某支驅動的 DPC 吃掉數百微秒——這個資料只有作業系統知道。經驗法則：單次超過 1000 µs 就值得注意，但它只是統計不是判決。"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="量測" HelpKey="dpc/量測"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="Stop_Click" IsEnabled="{Binding DpcLatency.IsRunning}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="開始量測"
                                    Click="Start_Click" IsEnabled="{Binding DpcLatency.CanStart}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="量測時長" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Content="10 秒" Margin="0,0,10,0" GroupName="DpcDur" Tag="10" Checked="Dur_Checked"/>
                        <RadioButton Content="15 秒" Margin="0,0,10,0" GroupName="DpcDur" Tag="15" IsChecked="True" Checked="Dur_Checked"/>
                        <RadioButton Content="30 秒" Margin="0,0,10,0" GroupName="DpcDur" Tag="30" Checked="Dur_Checked"/>
                        <RadioButton Content="60 秒" GroupName="DpcDur" Tag="60" Checked="Dur_Checked"/>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource LoadBar}" Margin="0,10,0,0" Value="{Binding DpcLatency.ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding DpcLatency.Status}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="驅動模組"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="類別"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="次數"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="最大"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="平均"/>
                        <TextBlock Grid.Column="5" Style="{StaticResource ColHead}" Text="佔用"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DpcLatency.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Row" MinHeight="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Module}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Kind}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding CountText}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding MaxText}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding AvgText}"/>
                                    <TextBlock Grid.Column="5" Style="{StaticResource FieldValue}" Text="{Binding BusyText}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 中斷落在哪顆核：把「哪顆核被壓住」變成「是誰壓住它」 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,32">
                <StackPanel>
                    <local:SectionHead Text="中斷落在哪顆核" HelpKey="dpc/中斷落在哪顆核"/>
                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{Binding DpcLatency.AffinityVerdict}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="只統計 ISR（中斷服務常式）真正在哪顆核上執行；DPC 可能被排到別的核，混在一起會失去意義。歸屬的粒度是驅動映像，不是裝置實例——同型號的兩張網卡是同一支 .sys。"/>

                    <ItemsControl ItemsSource="{Binding DpcLatency.ByCpu}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/><ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                               Text="{Binding CountText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}"
                                               Text="{Binding Text}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,10"
                            Visibility="{Binding DpcLatency.ByModule.Count, Converter={StaticResource CountToVis}}"/>
                    <TextBlock Style="{StaticResource ColHead}" Text="每一支驅動的中斷集中在哪裡"
                               Visibility="{Binding DpcLatency.ByModule.Count, Converter={StaticResource CountToVis}}"/>
                    <ItemsControl ItemsSource="{Binding DpcLatency.ByModule}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Module}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                               Text="{Binding CountText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}"
                                               Text="{Binding SpreadText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
