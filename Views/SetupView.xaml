<UserControl x:Class="XinSpect.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <!-- DataContext 指定於此子 Grid（而非 UserControl 根）：根元素 DataContext 繫結在 Host.Content 延遲載入時不解析，改於首個子元素設定方能正確解析 Winget -->
    <Grid Margin="0,0,8,0" DataContext="{Binding Winget}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題與操作 -->
        <Grid Grid.Row="0" Margin="2,0,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="一鍵裝機"/>
                <TextBlock Style="{StaticResource Subtitle}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                           Text="勾選常用軟體後一鍵批次安裝，全程由 Windows 內建的 winget 從官方來源下載安裝；本程式不含任何安裝檔。（此功能直接沿用圖吧工具箱 WinUI3）"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource ToolButton}" Content="勾選推薦" Margin="0,0,8,0" Click="SelectRec_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="清除勾選" Margin="0,0,8,0" Click="Clear_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Click="Install_Click"
                        IsEnabled="{Binding CanInstall}"
                        Content="{Binding SelectedCount, StringFormat=開始安裝（{0}）}"/>
            </StackPanel>
        </Grid>

        <!-- winget 未安裝提示 -->
        <Border Grid.Row="1" Margin="0,0,0,10" CornerRadius="8" Background="#33E0552E" BorderBrush="#E0552E" BorderThickness="1"
                Visibility="{Binding NotAvailable, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="14,10">
                <TextBlock Text="未偵測到 winget（應用程式安裝程式）。" Foreground="{StaticResource PrimaryInkBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Style="{StaticResource ToolButton}" Content="前往 Microsoft Store 取得" Click="GetWinget_Click"/>
            </StackPanel>
        </Border>

        <!-- 狀態 -->
        <TextBlock Grid.Row="2" Style="{StaticResource Subtitle}" Margin="2,0,0,8"
                   Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>

        <!-- 分類與套件清單 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Name}" FontSize="15"/>
                                <ItemsControl ItemsSource="{Binding Packages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4,18,4"
                                                      Foreground="{StaticResource PrimaryInkBrush}"
                                                      ToolTip="{Binding Id}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryInkBrush}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Desc}" Style="{StaticResource FieldLabel}" FontSize="11"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 安裝記錄 -->
        <Border Grid.Row="4" Margin="0,10,0,0" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" MaxHeight="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource SecondaryInkBrush}"
                         FontFamily="Consolas" FontSize="12" MinHeight="60"
                         VerticalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
