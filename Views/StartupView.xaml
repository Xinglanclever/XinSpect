<UserControl x:Class="XinSpect.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- 停用／啟用切換鈕：依 Enabled 切換文字 -->
        <Style x:Key="ToggleBtn" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Content" Value="停用"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Padding" Value="12,7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Content" Value="啟用"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,10">
            <local:SectionHead Text="開機啟動項管理" HelpKey="startup/開機啟動項管理"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="列舉登錄 Run 機碼、啟動資料夾，以及登入／開機觸發的排程工作——工作管理員的「啟動」分頁看不到排程工作，很多常駐更新程式正是靠它起來的。停用登錄與資料夾項目＝寫入與工作管理員相同、可逆的核准旗標；停用排程工作＝走 Windows 自己的 schtasks，兩者都不刪除原始項目，隨時可還原。變更「全部使用者」或系統排程工作需系統管理員權限。"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="重新掃描" Click="Scan_Click"/>
                <CheckBox x:Name="SysTasks" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                          FontSize="13" Foreground="{DynamicResource SecondaryInkBrush}"
                          Content="顯示 Windows 內建的排程工作" Click="SysTasks_Click"
                          ToolTip="\Microsoft\… 底下的工作是作業系統自己的維護工作，預設不列出"/>
                <TextBlock x:Name="MsgText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource SecondaryInkBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="List" Margin="14,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8"
                                        Padding="14,11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryInkBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                        Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                               Foreground="{DynamicResource SecondaryInkBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Location}" FontSize="11.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource MutedInkBrush}"/>
                                            <TextBlock Text="{Binding Command}" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource SecondaryInkBrush}"
                                                       TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                                       FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ToggleBtn}" Click="Toggle_Click"/>
                                            <Button Style="{StaticResource ToolButton}" Content="定位" Click="Locate_Click"
                                                    Padding="12,7" Margin="8,0,0,0"
                                                    ToolTip="開啟項目所在位置"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" Padding="12,6" CornerRadius="0,0,10,10">
                    <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource SecondaryInkBrush}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
