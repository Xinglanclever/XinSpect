<UserControl x:Class="XinSpect.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="健康總評"/>

            <!-- 綜合評分（大儀表 + 評語） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <local:RadialGauge Grid.Column="0" Width="150" Height="150" Margin="4,6,20,6"
                                       Caption="綜合健康評分" Unit="分" Max="100"
                                       Value="{Binding Health.Score, FallbackValue=0, TargetNullValue=0}"
                                       ArcBrush="{Binding Health.ScoreSeverity, Converter={StaticResource SeverityToBrush}}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Health.Summary}" TextWrapping="Wrap"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryInkBrush}"/>
                        <TextBlock Text="{Binding Health.Advice}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   FontSize="14" Foreground="{StaticResource SecondaryInkBrush}"/>
                        <TextBlock Text="評分越高越健康 ・ 依各項指標嚴重度即時扣分計算"
                                   Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 指標狀態燈 -->
            <Border Style="{StaticResource Card}" local:Anim.RevealDelay="80">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="指標狀態"/>
                    <ItemsControl ItemsSource="{Binding Health.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="9" Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="9,0,0,9"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                        <StackPanel Grid.Column="1" Margin="16,12,16,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ValueText}" FontSize="21" Margin="0,2,0,0"
                                                       Foreground="{StaticResource PrimaryInkBrush}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource FieldLabel}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 升級建議：瓶頸判定 + 依優先度排序的建議 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="140">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="重新分析"
                                VerticalAlignment="Top" Click="RefreshUpgrade_Click"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="升級建議"/>
                    </DockPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4"
                                Background="{Binding Upgrade.BottleneckSeverity, Converter={StaticResource SeverityToBrush}}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding Upgrade.Bottleneck}" FontSize="18" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{StaticResource PrimaryInkBrush}"/>
                            <TextBlock Text="{Binding Upgrade.BottleneckDetail}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       FontSize="13.5" Foreground="{StaticResource SecondaryInkBrush}"/>
                            <TextBlock Text="{Binding Upgrade.Confidence}" Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="目前的讀值還不足以支撐任何一條建議。累積一段時間的歷史記錄（設定頁可開啟）後再回來看會更準——曦覽寧可少說，也不以「一般情況」代替你這台機器的實際數字。"
                               Visibility="{Binding Upgrade.HasItems, Converter={StaticResource InverseBoolToVis}}"/>

                    <ItemsControl ItemsSource="{Binding Upgrade.Items}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="9" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="9,0,0,9"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                        <StackPanel Grid.Column="1" Margin="16,12,16,13">
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="4" Padding="7,1" VerticalAlignment="Center"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                                    <TextBlock Text="{Binding PriorityText}" Foreground="White" FontSize="11.5"/>
                                                </Border>
                                                <Border CornerRadius="4" Padding="7,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                        Background="{StaticResource SurfaceBrush}">
                                                    <TextBlock Text="{Binding PartText}" Foreground="{StaticResource SecondaryInkBrush}" FontSize="11.5"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryInkBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Evidence, StringFormat=依據：{0}}" TextWrapping="Wrap"
                                                       Margin="0,8,0,0" FontSize="13"
                                                       Foreground="{StaticResource SecondaryInkBrush}"/>
                                            <TextBlock Text="{Binding Action, StringFormat=做法：{0}}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" FontSize="13"
                                                       Foreground="{StaticResource SecondaryInkBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding GainText}" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock Text="{Binding CostText}" Style="{StaticResource FieldLabel}" Margin="18,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="每條建議的「依據」都是本機實際讀到的數字；讀值不足以支撐的規則會整條跳過。「預期效益」寫的是同類升級的經驗範圍，不是本機實測結果。"
                               Visibility="{Binding Upgrade.HasItems, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ===== WHEA 硬體錯誤紀錄 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="WHEA 硬體錯誤紀錄"/>
                        <Button Style="{StaticResource ToolButton}" Content="重新讀取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="WheaRefresh_Click" IsEnabled="{Binding Whea.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="事件檢視器 Microsoft-Windows-WHEA-Logger 頻道的近 30 天紀錄：CPU 內部錯誤、PCIe 可修正／不可修正錯誤、記憶體與快取階層的韌體級錯誤都在這裡。零特權、由 Windows 收集，可靠；0 筆是好事，就照實說。"/>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="{Binding Whea.Summary}"/>
                    <ItemsControl ItemsSource="{Binding Whea.Rows}" MaxHeight="260">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Time}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Level}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding Id}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Text="{Binding Message}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 可靠性歷史 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="可靠性歷史"/>
                        <Button Style="{StaticResource ToolButton}" Content="重新讀取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="ReliabilityRefresh_Click" IsEnabled="{Binding Reliability.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,8" TextWrapping="Wrap"
                               Text="近 30 天的機器病歷：非預期關機（Kernel-Power 41／6008）、藍屏（BugCheck 1001）、應用程式當機與停止回應（1000／1002），以及開機耗時趨勢（Diagnostics-Performance 100）。只呈現事件與時間，不下診斷結論。"/>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding Reliability.Summary}"/>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Reliability.BootTrend}"/>
                    <ItemsControl ItemsSource="{Binding Reliability.Rows}" MaxHeight="220">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Time}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Category}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Text="{Binding Detail}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 機器檢查銀行（MCA）===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="機器檢查銀行（MCA）"/>
                        <Button Style="{StaticResource ToolButton}" Content="重新掃描" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="McaRefresh_Click" IsEnabled="{Binding Mca.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,8" TextWrapping="Wrap"
                               Text="逐核逐銀行讀 IA32_MCi_STATUS：位 63 valid、位 61 不可修正、位 38–52 為已修正錯誤計數。已修正＝系統沒崩、使用者無感——但計數往上跑就是記憶體／IMC 劣化的最早訊號。只列出有內容的銀行；歷史紀錄另見上方 WHEA 卡片。"/>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Mca.Summary}"/>
                    <ItemsControl ItemsSource="{Binding Mca.Rows}" MaxHeight="200">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Core}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Bank}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding Kind}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding Corrected}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding Detail}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 平台可信度 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="平台可信度（讀到的數字算不算原生）"/>
                        <Button Style="{StaticResource ToolButton}" Content="重新讀取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="PlatformTrustRefresh_Click" IsEnabled="{Binding PlatformTrust.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,8" TextWrapping="Wrap"
                               Text="VBS／HVCI 開啟時 Windows 本身是 Hyper-V 上的一個分割區，MSR 可能被攔截或回傳虛擬值、PMU 計數可能不被轉送、TSC 可能被偏移。本程式所有 MSR 類卡片（Top-down、頻率真相、RDT、MCA、安全位元）的可信度都取決於這張卡片，所以先把資格條件講清楚。全部唯讀。"/>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{StaticResource PrimaryInkBrush}" Text="{Binding PlatformTrust.Verdict}"/>
                    <ItemsControl ItemsSource="{Binding PlatformTrust.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="26" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" TextWrapping="Wrap"
                                               Foreground="{StaticResource PrimaryInkBrush}" Text="{Binding Value}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Text="{Binding Note}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding PlatformTrust.Status}"/>
                </StackPanel>
            </Border>

            <!-- ===== 計時器地基 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="計時器地基"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="所有量測的精度來源：QPC 走 TSC 還是被 useplatformclock 降級到 HPET、系統計時器解析度被誰拉高、Invariant TSC 支援與否。誠實的工具必須先交代地基。"/>
                    <ItemsControl ItemsSource="{Binding TimerFoundation.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="26" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Key}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Foreground="{StaticResource PrimaryInkBrush}" Text="{Binding Value}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Text="{Binding Note}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 電源政策實況 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="電源政策實況（藏在進階設定裡的那幾項）"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="讀取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="PowerPolicyRefresh_Click" IsEnabled="{Binding PowerPolicy.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="核心停放、PCIe ASPM、USB 選擇性暫停這三項會直接造成間歇卡頓或裝置掉線，而它們在 Windows 的進階電源設定裡預設是隱藏的。這裡把目前計劃的實際值攤開。"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldValue}" Text="作用中電源計劃"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimaryInkBrush}" Text="{Binding PowerPolicy.PlanName}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PowerPolicy.Settings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="26" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" TextWrapping="Wrap"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" Text="{Binding Value}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Text="{Binding Note}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,2" Text="逐邏輯處理器（CallNtPowerInformation）"/>
                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap"
                               Foreground="{StaticResource PrimaryInkBrush}" Text="{Binding PowerPolicy.ProcessorSummary}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding PowerPolicy.CurrentMhzNotice}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,2" Text="平台睡眠能力（平台自己宣告的，不是建議）"/>
                    <ItemsControl ItemsSource="{Binding PowerPolicy.SleepStates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                               Foreground="{StaticResource PrimaryInkBrush}" Text="{Binding Value}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Text="{Binding Note}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding PowerPolicy.ScopeNotice}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding PowerPolicy.Status}"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,10,0,0"
                       Text="溫度 / 壽命來自感測器與 S.M.A.R.T.；磁碟空間取用量最高的磁碟區。部分裝置或未提供資料。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
