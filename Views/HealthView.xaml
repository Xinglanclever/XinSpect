<UserControl x:Class="XinSpect.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="健康總評"/>

            <!-- 綜合評分（大儀表 + 評語） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <local:RadialGauge Grid.Column="0" Width="150" Height="150" Margin="4,6,20,6"
                                       Caption="綜合健康評分" Unit="分" Max="100"
                                       Value="{Binding Health.Score, FallbackValue=0, TargetNullValue=0}"
                                       ArcBrush="{Binding Health.ScoreSeverity, Converter={StaticResource SeverityToBrush}}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Health.Summary}" TextWrapping="Wrap"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryInkBrush}"/>
                        <TextBlock Text="{Binding Health.Advice}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   FontSize="14" Foreground="{StaticResource SecondaryInkBrush}"/>
                        <TextBlock Text="評分越高越健康 ・ 依各項指標嚴重度即時扣分計算"
                                   Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 指標狀態燈 -->
            <Border Style="{StaticResource Card}" local:Anim.RevealDelay="80">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="指標狀態"/>
                    <ItemsControl ItemsSource="{Binding Health.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="9" Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="9,0,0,9"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                        <StackPanel Grid.Column="1" Margin="16,12,16,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ValueText}" FontSize="21" Margin="0,2,0,0"
                                                       Foreground="{StaticResource PrimaryInkBrush}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource FieldLabel}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,10,0,0"
                       Text="溫度 / 壽命來自感測器與 S.M.A.R.T.；磁碟空間取用量最高的磁碟區。部分裝置或未提供資料。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
