<UserControl x:Class="XinSpect.MotherboardAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
            <StackPanel Margin="2,0,0,10">
                <local:SectionHead Text="主機板分析" HelpKey="mainboard/主機板分析"/>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="先從 WMI 讀出主機板廠牌型號，再用你設定的 AI 查詢詳細規格（晶片組、供電、插槽、網路與音效晶片）。"/>
            </StackPanel>

            <!-- 主機板基本資訊 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="開始分析"
                                Click="Analyze_Click" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"/>
                        <local:SectionHead Text="基本資訊"/>
                    </DockPanel>
                    <local:FieldRow Label="廠牌" Value="{Binding Manufacturer}"/>
                    <local:FieldRow Label="型號" Value="{Binding Model}"/>
                    <local:FieldRow Label="序號" Value="{Binding SerialNumber}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 錯誤 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource WarningBrush}"/>
            </Border>

            <!-- 圖片確認 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding ImageSearchUrl, Converter={StaticResource TextToVis}}">
                <StackPanel>
                    <local:SectionHead Text="確認型號"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,4,0,8"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Text="已開啟圖片搜尋。請對照實體主機板，確認是不是這一張——是的話按「是這張」，AI 才會給出針對這張板子的詳細介紹。"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="是這張" Click="Confirm_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="不是，換一張" Margin="8,0,0,0" Click="SearchAgain_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="在瀏覽器開啟" Margin="8,0,0,0" Click="OpenImage_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AI 分析結果 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding AiAnalysis, Converter={StaticResource TextToVis}}">
                <StackPanel>
                    <local:SectionHead Text="詳細規格（AI 查詢）"/>
                    <TextBlock Text="{Binding AiAnalysis}" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                               Foreground="{DynamicResource SecondaryInkBrush}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="以上內容由 AI 依型號推斷，非本機實測。若與實物不符，以主機板手冊為準。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
