<Window x:Class="XinSpect.IconGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XinSpect"
        Title="曦覽 XinSpect — 特殊型號徽章一覽" Width="772" SizeToContent="Height" MaxHeight="1180"
        WindowStartupLocation="CenterScreen" Background="#0E1116">
    <Window.Resources>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB0C0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,16,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#181D25"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#242B35"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- 「朕知道了」關閉鈕：朱批朱紅底 + 金框（呼應御批硃筆意象） -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF4E2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="28,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderThickness="1.2" BorderBrush="#E8B23A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#C7382B" Offset="0"/>
                                    <GradientStop Color="#8A1710" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D8443A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6E1109"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 底部固定頁腳：關閉鈕常駐可見（不隨內容捲動） -->
        <Border DockPanel.Dock="Bottom" Background="#0E1116"
                BorderBrush="#242B35" BorderThickness="0,1,0,0" Padding="18,12">
            <Button Content="朕知道了" Style="{StaticResource CloseBtn}"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14,18,20">
                <TextBlock Text="曦覽 XinSpect — 特殊型號徽章示意圖" Foreground="#F2F5F8" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="By：Xinglanclever ・ Claude Opus 4.8 ・ 原創向量徽章（非官方商標重製）"
                           Foreground="#6B7A8A" FontSize="11" Margin="0,3,0,4"/>

                <TextBlock Style="{StaticResource Sec}" Text="Intel 至尊 / 限定"/>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Core i7-8086K" Model="Core i7-8086K"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Core i9-9990XE" Model="Core i9-9990XE"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Core i9-10980XE" Model="Core i9-10980XE"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Core i9-9900X" Model="Core i9-9900X"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Core i7-3960X" Model="Core i7-3960X"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Core(TM) i7 CPU 975 @ 3.33GHz" Model="Core i7-975 至尊"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Core(TM)2 Extreme CPU QX9650" Model="Core 2 Extreme QX9650"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Pentium(R) Extreme Edition CPU 965" Model="Pentium EE 965"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Core(TM) i7-5960X CPU @ 3.00GHz" Model="Core i7-5960X 至尊"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Core(TM) i7-6950X CPU @ 3.00GHz" Model="Core i7-6950X 至尊"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Core(TM) CC150 CPU @ 3.50GHz" Model="Core CC150（8C/16T 定頻）"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Core(TM) i9-14900KS CPU @ 3.20GHz" Model="Core i9-14900KS 特別版"/></Border>
                </UniformGrid>

                <TextBlock Style="{StaticResource Sec}" Text="Everest 珠穆朗瑪峰系列（Intel 非路線圖極限 bin：膠囊標系列、中心字標機種）"/>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Xeon(R) CPU X5698 @ 4.40GHz" Model="Xeon X5698（4.4GHz 雙核）"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel JKT EVEREST SS 4.4GHZ INTERNAL USE ONLY" Model="JKT Everest"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel BlackOps 6 Core 4.60GHz Engineering Sample" Model="BlackOps 6C"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Xeon(R) CPU E5-2602 v4" Model="Xeon E5-2602 v4（傳聞）"/></Border>
                </UniformGrid>

                <TextBlock Style="{StaticResource Sec}" Text="Intel Xeon（左上 Xeon；Scalable 右上級別斜面 銅/銀/金/白金、W・E 系右上字母）"/>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon Platinum 8480" Model="Xeon Platinum 8480+"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon Gold 6248R" Model="Xeon Gold 6248R"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon Silver 4214" Model="Xeon Silver 4214"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon Bronze 3204" Model="Xeon Bronze 3204"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon W-2295" Model="Xeon W-2295"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon E-2288G" Model="Xeon E-2288G"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon E3-1230 v6" Model="Xeon E3-1230 v6"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon E5-2680 v4" Model="Xeon E5-2680 v4"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Xeon(R) CPU E5-1680 v2 @ 3.00GHz" Model="Xeon E5-1680 v2（黑工作站頂規）"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon E7-8890 v4" Model="Xeon E7-8890 v4"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Xeon 5160" Model="Xeon 5160"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Xeon(R) W-3175X CPU @ 3.10GHz" Model="Xeon W-3175X（限量）"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Xeon(R) CPU E5-2696 v4 @ 2.20GHz" Model="Xeon E5-2696 v4（OEM 專供）"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Xeon Phi(TM) CPU 7250 @ 1.40GHz" Model="Xeon Phi 7250（72 核）"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel(R) Itanium(R) Processor 9750 @ 2.53GHz" Model="Itanium 9750（IA-64）"/></Border>
                </UniformGrid>

                <TextBlock Style="{StaticResource Sec}" Text="AMD ・ Intel Pentium Gold ・ 工程樣品"/>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="AMD Ryzen Threadripper 3990X" Model="Ryzen Threadripper 3990X"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="AMD Ryzen 9 5950X" Model="Ryzen 9 5950X"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="AMD Ryzen 7 9800X3D 8-Core Processor" Model="Ryzen 7 9800X3D"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="AMD EPYC 9754 128-Core Processor" Model="EPYC 9754"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="AMD Opteron(tm) Processor 6276" Model="Opteron 6276"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="AMD Athlon(tm) 64 FX-60 Processor" Model="Athlon 64 FX-60"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="AMD FX(tm)-9590 Eight-Core Processor" Model="FX-9590（5GHz）"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Intel Pentium Gold G7400" Model="Pentium Gold G7400"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Cpu" EmblemSize="54" CpuModel="Genuine Intel(R) CPU 0000" Model="工程樣品 0000"/></Border>
                </UniformGrid>

                <TextBlock Style="{StaticResource Sec}" Text="NVIDIA 顯示卡（Titan 黑底銀邊 ・ Titan V / CEO 銀底金邊 ・ Tesla 綠）"/>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA TITAN RTX"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA TITAN V"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA TITAN V CEO Edition"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA Tesla V100"/></Border>
                </UniformGrid>

                <TextBlock Style="{StaticResource Sec}" Text="專業卡與運算卡（Quadro / RTX Pro 黑底 ・ 資料中心綠 ・ Instinct 紅 ・ Radeon Pro 藍）"/>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA Quadro P5000"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA RTX A6000"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA RTX 6000 Ada Generation"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA H100 80GB HBM3"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="AMD Instinct MI300X"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="AMD Radeon Pro W7900"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA GeForce GTX TITAN Z"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA GeForce RTX 4090 D"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Gpu" EmblemSize="54" Model="NVIDIA CMP 90HX"/></Border>
                </UniformGrid>

                <TextBlock Style="{StaticResource Sec}" Text="儲存與主機板（Optane 3D XPoint ・ 各家超頻名門板）"/>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Disk" EmblemSize="54" Model="INTEL SSDPED1D480GA"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Board" EmblemSize="54" Model="ROG MAXIMUS Z790 APEX"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Board" EmblemSize="54" Model="EVGA Z790 DARK KINGPIN"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Board" EmblemSize="54" Model="MEG Z790 GODLIKE"/></Border>
                    <Border Style="{StaticResource Card}"><local:BrandBadge Kind="Board" EmblemSize="54" Model="Z790 AORUS TACHYON"/></Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
