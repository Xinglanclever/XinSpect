<UserControl x:Class="XinSpect.ScreenGamutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">

            <!-- 標題 -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <TextBlock Style="{StaticResource Title}" Text="螢幕色域"/>
                <local:HelpDot HelpKey="gamut/螢幕色域" Margin="10,4,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Subtitle}" Margin="2,0,0,14" TextWrapping="Wrap"
                       Text="自顯示器 EDID 解析 CIE 色度座標，計算色域三角形對 sRGB、Adobe RGB、DCI-P3 三種標準的覆蓋率，並以 2D 色度圖與 3D 色彩立方把色域畫出來。"/>

            <!-- 2D：CIE 1931 xy 色度圖 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <local:SectionHead Text="CIE 1931 色度圖（2D）" HelpKey="gamut/色度圖"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,8" TextWrapping="Wrap"
                               Text="馬蹄形外框是可見光光譜軌跡；虛線三角形是 sRGB 標準，實心半透明三角形是本機螢幕的色域。三角形越貼近光譜軌跡，能顯示的顏色越飽和。"/>
                    <local:GamutChromaticityDiagram Height="360" Margin="0,4,0,0"
                                                    Monitors="{Binding Monitors}"/>
                </StackPanel>
            </Border>

            <!-- 3D：RGB 色彩立方 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <local:SectionHead Text="RGB 色彩立方（3D）" HelpKey="gamut/色彩立方"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,8" TextWrapping="Wrap"
                               Text="以 R／G／B 三原色為軸的完整色彩空間模型，可按住拖曳旋轉。三原色各自拉到最大值的中間色都在這個立方體裡——色域硬體就是從中挑出一個三角形切片。"/>
                    <local:RgbCube3D Height="340" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 各顯示器覆蓋率（自工具箱遷入） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <local:SectionHead Text="覆蓋率" HelpKey="gamut/覆蓋率"/>
                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldValue}" Text="{Binding Name}" FontSize="16"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Text="{Binding Manufacturer}" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- 三種標準覆蓋率 -->
                                        <UniformGrid Rows="1" Columns="3" Margin="0,12,0,0"
                                                     Visibility="{Binding Valid, Converter={StaticResource BoolToVis}}">
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,5,0">
                                                <StackPanel>
                                                    <TextBlock Text="sRGB" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Text="{Binding SrgbText}" FontSize="22" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="5,0,5,0">
                                                <StackPanel>
                                                    <TextBlock Text="Adobe RGB" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Text="{Binding AdobeText}" FontSize="22" Margin="0,2,0,0" Foreground="{DynamicResource PrimaryInkBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="5,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="DCI-P3" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Text="{Binding DciText}" FontSize="22" Margin="0,2,0,0" Foreground="{DynamicResource PrimaryInkBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="{Binding PrimariesText}"
                                                   Visibility="{Binding Valid, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,2,0,0" Text="{Binding WhitePointText}"
                                                   Visibility="{Binding Valid, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,2,0,0" Text="{Binding AreaText}"
                                                   Visibility="{Binding Valid, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Assessment}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Subtitle}" TextWrapping="Wrap"
                               Visibility="{Binding HasNoMonitors, Converter={StaticResource BoolToVis}}"
                               Text="未從系統取得可用的 EDID 色度資訊。遠端桌面、虛擬顯示器或部分螢幕可能不提供，此為正常情形。"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="4,0,0,20" TextWrapping="Wrap"
                       Text="EDID 是螢幕自己回報的規格值，不是校色儀實測；廠商填錯或留空時此頁會顯示「—」。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
