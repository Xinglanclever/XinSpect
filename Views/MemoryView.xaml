<UserControl x:Class="XinSpect.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <local:SectionHead Text="記憶體" HelpKey="memory/記憶體"/>

            <!-- 品牌徽章（取第一條模組） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="0">
                <local:BrandBadge Kind="Ram" EmblemSize="54"
                                  Brand="{Binding Modules[0].Brand, FallbackValue={x:Static local:Brand.Unknown}}"
                                  Model="{Binding Modules[0].PartNumber, FallbackValue=—}"/>
            </Border>

            <Grid local:Anim.RevealDelay="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 時序 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <Grid>
                            <local:SectionHead Text="時序 (CPU-Z)" HelpKey="memory/時序 (CPU-Z)"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Timings.Status}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <local:FieldRow Label="記憶體類型" Value="{Binding Timings.MemoryTypeText}"/>
                        <local:FieldRow Label="通道" Value="{Binding Timings.ChannelsText}"/>
                        <local:FieldRow Label="DRAM 頻率" Value="{Binding Timings.FrequencyText}"/>
                        <local:FieldRow Label="資料速率" Value="{Binding Timings.DataRateText}"/>
                        <local:FieldRow Label="主要時序" Value="{Binding Timings.PrimaryTimingsText}"/>
                        <local:FieldRow Label="CAS 延遲 (CL)" Value="{Binding Timings.CL}"/>
                        <local:FieldRow Label="tRCD" Value="{Binding Timings.TRCD}"/>
                        <local:FieldRow Label="tRP" Value="{Binding Timings.TRP}"/>
                        <local:FieldRow Label="tRAS" Value="{Binding Timings.TRAS}"/>
                        <local:FieldRow Label="tRFC" Value="{Binding Timings.TRFC}"/>
                        <local:FieldRow Label="命令率 (CR)" Value="{Binding Timings.CommandRate}"/>
                        <local:FieldRow Label="Uncore" Value="{Binding Timings.UncoreText}"/>
                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,8,0,8"/>
                        <TextBlock Style="{StaticResource ColHead}" Text="次要時序 / 晶片組" Margin="0,0,0,4"/>
                        <local:FieldRow Label="tCCD" Value="{Binding Timings.TCCD}"/>
                        <local:FieldRow Label="tCCD_L" Value="{Binding Timings.TCCDL}"/>
                        <local:FieldRow Label="tCCD_WR" Value="{Binding Timings.TCCDWR}"/>
                        <local:FieldRow Label="tCCD_WR_L" Value="{Binding Timings.TCCDWRL}"/>
                        <local:FieldRow Label="記憶體總量" Value="{Binding Timings.MemorySizeText}"/>
                        <local:FieldRow Label="主橋 (Host Bridge)" Value="{Binding Timings.HostBridge}"/>
                    </StackPanel>
                </Border>

                <!-- 使用量 -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <local:SectionHead Text="即時使用量" HelpKey="memory/即時使用量"/>
                        <local:FieldRow Label="總容量" Value="{Binding Live.MemTotalGB, StringFormat={}{0:0.0} GB}"/>
                        <local:FieldRow Label="已使用" Value="{Binding Live.MemUsedGB, StringFormat={}{0:0.0} GB}"/>
                        <local:FieldRow Label="可用" Value="{Binding Live.MemAvailGB, StringFormat={}{0:0.0} GB}"/>
                        <local:FieldRow Label="使用率" Value="{Binding Live.MemLoadText}"/>
                        <ProgressBar Style="{StaticResource LoadBar}" Value="{Binding Live.MemLoad, Mode=OneWay}" Margin="0,10,0,0"/>
                        <local:HistoryGraph Height="108" Margin="0,12,0,0" Caption="使用率走勢 (%)"
                                            History="{Binding MemHist}" Stroke="{StaticResource GoodBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 插槽配置圖：先看「哪裡還能插、有沒有插對通道」，再往下看逐條規格 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="100"
                    Visibility="{Binding Dimms.HasData, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="插槽配置" HelpKey="memory/插槽配置"/>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{Binding Dimms.Headline}"/>
                    <local:DimmMap Layout="{Binding Dimms}" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="{Binding Dimms.Detail}"/>
                    <ItemsControl ItemsSource="{Binding Dimms.Notes}" Margin="0,8,0,0"
                                  Visibility="{Binding Dimms.HasNotes, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="{Binding StringFormat=・{0}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 模組 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="120">
                <StackPanel>
                    <local:SectionHead Text="實體模組" HelpKey="memory/實體模組"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" Text="插槽"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="製造商"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="型號"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="類型"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="型式"/>
                        <TextBlock Grid.Column="5" Style="{StaticResource ColHead}" Text="容量"/>
                        <TextBlock Grid.Column="6" Style="{StaticResource ColHead}" Text="速率"/>
                        <TextBlock Grid.Column="7" Style="{StaticResource ColHead}" Text="電壓"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Modules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}" Text="{Binding Slot}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Manufacturer}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding PartNumber}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding MemoryType}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding FormFactor}"/>
                                    <TextBlock Grid.Column="5" Style="{StaticResource FieldValue}" Text="{Binding CapacityText}"/>
                                    <TextBlock Grid.Column="6" Style="{StaticResource FieldValue}" Text="{Binding SpeedText}"/>
                                    <TextBlock Grid.Column="7" Style="{StaticResource FieldValue}" Text="{Binding Voltage}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- SPD 深度資料 (CPU-Z) -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="180"
                    Visibility="{Binding HasSpdModules, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="SPD 深度資料 (CPU-Z)" HelpKey="memory/SPD 深度資料 (CPU-Z)"/>
                    <ItemsControl ItemsSource="{Binding SpdModules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <local:BrandBadge Kind="Ram" EmblemSize="34" Margin="0,0,0,8"
                                                          Brand="{Binding Brand}" Model="{Binding Header}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <local:FieldRow Label="插槽" Value="{Binding Slot}"/>
                                                <local:FieldRow Label="類型" Value="{Binding MemoryType}"/>
                                                <local:FieldRow Label="模組格式" Value="{Binding ModuleFormat}"/>
                                                <local:FieldRow Label="容量" Value="{Binding Size}"/>
                                                <local:FieldRow Label="製造商" Value="{Binding Manufacturer}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <local:FieldRow Label="料號" Value="{Binding PartNumber}"/>
                                                <local:FieldRow Label="最高頻寬" Value="{Binding MaxBandwidth}"/>
                                                <local:FieldRow Label="最高 JEDEC" Value="{Binding MaxJedec}"/>
                                                <local:FieldRow Label="製造日期" Value="{Binding ManufacturingDate}"/>
                                                <local:FieldRow Label="標稱電壓" Value="{Binding NominalVoltage}"/>
                                                <local:FieldRow Label="XMP/EXPO" Value="{Binding XmpSummary}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- JEDEC 標準時序表 -->
                                        <StackPanel Margin="0,6,0,0"
                                                    Visibility="{Binding HasJedec, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource ColHead}" Text="JEDEC 標準時序" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Jedec}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <local:FieldRow Label="{Binding Label}" Value="{Binding Values}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding XmpProfiles}" Margin="0,4,0,0"
                                                      Visibility="{Binding HasXmp, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,6,0,0">
                                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                                   Text="{Binding Name, StringFormat=效能設定檔：{0}}"/>
                                                        <local:FieldRow Label="規格" Value="{Binding Specification}"/>
                                                        <local:FieldRow Label="電壓" Value="{Binding Voltage}"/>
                                                        <local:FieldRow Label="最高 CL" Value="{Binding MaxCL}"/>
                                                        <ItemsControl ItemsSource="{Binding Timings}" Margin="0,2,0,0"
                                                                      Visibility="{Binding HasTimings, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <local:FieldRow Label="{Binding Label}" Value="{Binding Values}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- ===== 記憶體圖樣檢測 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" local:Anim.RevealDelay="240">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <local:SectionHead Text="圖樣檢測" HelpKey="memory/圖樣檢測" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="測試量" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Style="{StaticResource DarkCombo}" Width="110" Margin="0,0,12,0"
                                      IsEnabled="{Binding MemTest.CanStart}"
                                      ItemsSource="{Binding MemTest.SizeChoices}"
                                      SelectedIndex="{Binding MemTest.SizeIndex, Mode=TwoWay}"/>
                            <Button Style="{StaticResource ToolButton}" Content="停止" Margin="0,0,10,0"
                                    Click="MemTestStop_Click" IsEnabled="{Binding MemTest.IsRunning}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="開始測試"
                                    Click="MemTestStart_Click" IsEnabled="{Binding MemTest.CanStart}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="在一段實際配置到的記憶體上寫入特定圖樣再整段回讀比對，抓永遠卡在某一態的位元、相鄰位元干擾與位址解碼錯誤。測試期間可正常操作，但整機會變慢。"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding MemTest.PlanText}"/>

                    <UniformGrid Rows="1" Columns="4" Margin="0,12,0,0">
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="測試範圍" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding MemTest.TestedText}" FontSize="20" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="不符處數" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding MemTest.ErrorText}" FontSize="20" Margin="0,2,0,0"
                                           Foreground="{Binding MemTest.Verdict, Converter={StaticResource SeverityToBrush}}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="耗時" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding MemTest.ElapsedText}" FontSize="20" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="讀寫吞吐" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding MemTest.SpeedText}" FontSize="20" Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryInkBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <ProgressBar Style="{StaticResource LoadBar}" Margin="0,12,0,0"
                                 Value="{Binding MemTest.ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding MemTest.StatusLine}"/>

                    <ItemsControl ItemsSource="{Binding MemTest.Rows}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ResultText}" VerticalAlignment="Center"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{Binding NoteText}" Margin="0,0,12,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding NoteText}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="{Binding TimeText}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding ThroughputText}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.75"
                               Text="這不是 MemTest86 的替代品：作業系統的虛擬記憶體讓程式無法指定實體位址，也碰不到已被系統與其他行程佔用的頁面，因此本檢測只覆蓋當下配置得到的那一段——通過不代表整條記憶體沒問題，但只要出現一處不符，那就是真的量到了。要徹底確認請在開機前環境跑滿整條記憶體。"/>
                </StackPanel>
            </Border>

            <!-- ===== 記憶體真實面貌 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <local:SectionHead Text="記憶體真實面貌（認可）" HelpKey="memory/記憶體真實面貌（認可）"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="「已使用 12 GB」掩蓋一半事實——認可（Commit）才是程式真正要求過的量。認可尖峰超過實體＝系統曾經真的動用分頁檔（開機至今累積），卡頓的常見源頭。"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldValue}" Text="目前認可"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding MemoryTruth.CommitText}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldValue}" Text="認可尖峰"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding MemoryTruth.PeakText}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldValue}" Text="頁面大小"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding MemoryTruth.PageSizeText}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldValue}" Text="判定"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Foreground="{StaticResource PrimaryInkBrush}"
                                   Text="{Binding MemoryTruth.Verdict}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" TextWrapping="Wrap" Text="{Binding MemoryTruth.VerdictText}"/>
                </StackPanel>
            </Border>

            <!-- ===== SMBIOS 記憶體裝置（Type 17 直讀）===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <local:SectionHead Text="SMBIOS 記憶體裝置" HelpKey="memory/SMBIOS 記憶體裝置"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="直讀韌體 Type 17 結構：每條記憶體的插槽位置、標稱／設定速度、序號、型號與 Rank——這些是韌體回報的資料（位移核對 dmidecode 3.x），未填的欄位顯示「—」。"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Smbios.MemoryArray.Count, Mode=OneWay, StringFormat=記憶體陣列資訊（{0} 組）}"/>
                    <ItemsControl ItemsSource="{Binding Smbios.MemoryArray}" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource FieldValue}" Margin="0,1">
                                    <Run Text="{Binding Key, Mode=OneWay}"/>
                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Smbios.MemoryDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryInkBrush}" Text="{Binding Locator}"/>
                                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource PrimaryInkBrush}"
                                                       Text="{Binding Size}"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Type}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}">
                                                <Run Text="標稱 "/><Run Text="{Binding Speed, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}">
                                                <Run Text="設定 "/><Run Text="{Binding Configured, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding Bank}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="{Binding Manufacturer, StringFormat=製造商：{0}}"/>
                                        <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap"
                                                   Text="{Binding Part, StringFormat=型號：{0}}"/>
                                        <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap"
                                                   Text="{Binding Serial, StringFormat=序號：{0}}"/>
                                        <TextBlock Style="{StaticResource FieldValue}"
                                                   Text="{Binding Rank, StringFormat=Rank：{0}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
