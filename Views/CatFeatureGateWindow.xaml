<Window x:Class="XinSpect.CatFeatureGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="喵！先確認一下" Width="480" Height="280"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource PagePlaneBrush}"
        ShowInTaskbar="False">
    <Border Margin="18" Padding="24" CornerRadius="16" Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="喵！先確認一下" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryInkBrush}"/>
            <TextBlock x:Name="PromptText" Grid.Row="1" Margin="0,20,0,20"
                       TextWrapping="Wrap" FontSize="15" LineHeight="23"
                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryInkBrush}"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeclineButton" MinWidth="120" Margin="0,0,10,0"
                        IsCancel="True" IsDefault="True"
                        Style="{StaticResource ToolButton}"/>
                <Button x:Name="ProceedButton" MinWidth="140" Style="{StaticResource PrimaryButton}"
                        Click="Proceed_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
