<UserControl x:Class="XinSpect.DriverAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <Grid Margin="0,0,6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,10">
            <local:SectionHead Text="進階驅動分析" HelpKey="driveranalysis/進階驅動分析"/>
            <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="基於驅動稽核的掃描結果，提供分類彙總、年齡分布、重複偵測、已知問題驅動與更新建議。全程唯讀。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 掃描控制 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <local:SectionHead Text="分析"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="重新分析"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="OnAnalyze_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{Binding DriverAnalysis.StatusText}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DriverAnalysis.TotalAnalyzed}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="已分析" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DriverAnalysis.CategoriesWithIssues}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="問題類別" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DriverAnalysis.DuplicateCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="重複 INF" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DriverAnalysis.KnownProblematicCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource CriticalBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="已知問題" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分類彙總 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <local:SectionHead Text="分類彙總"/>
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ColHead}" Text="類別"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="總數"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="問題數"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DriverAnalysis.Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="22" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Category}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Total}"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding IssueCount}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 年齡分布 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <local:SectionHead Text="驅動年齡分布"/>
                        <ItemsControl ItemsSource="{Binding DriverAnalysis.AgeHistogram}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Count, Mode=OneWay}"
                                                     Maximum="{Binding DataContext.DriverAnalysis.TotalAnalyzed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Height="20" Margin="8,0"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Style="{StaticResource FieldValue}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 重複偵測 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <local:SectionHead Text="重複驅動偵測"/>
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ColHead}" Text="INF 檔案"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="數量"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="版本"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DriverAnalysis.Duplicates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="22" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding InfName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding EntryCount}"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding Versions}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 更新建議 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                    <StackPanel>
                        <local:SectionHead Text="更新建議"/>
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/><ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ColHead}" Text="優先度"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="驅動程式"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="目前版本"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="原因"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DriverAnalysis.Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="22" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="300"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding PriorityDisplay}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding DriverName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DriverName}"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding CurrentVersion}" FontFamily="Consolas"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding Reason}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
