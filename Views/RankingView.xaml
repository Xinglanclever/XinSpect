<UserControl x:Class="XinSpect.RankingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <UserControl.Resources>
        <!-- 單列樣板：名次・型號・等級・分數・規格摘要；本機硬體高亮 -->
        <DataTemplate x:Key="RankRowTemplate">
            <Border x:Name="Bd" CornerRadius="6" Padding="10,6" Margin="0,1" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="78"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{Binding Rank}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="5,0" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="本機" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Detail}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{Binding Grade}"
                               VerticalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding Score}"
                               VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RankListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemTemplate" Value="{StaticResource RankRowTemplate}"/>
        </Style>
    </UserControl.Resources>
    <!-- DataContext 指定於此子 Grid（而非 UserControl 根）：根元素 DataContext 繫結在 Host.Content 延遲載入時不解析，改於首個子元素設定方能正確解析 Ranking -->
    <Grid Margin="0,0,8,0" DataContext="{Binding Ranking}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:SectionHead Text="效能天梯榜" HelpKey="ranking/效能天梯榜" Grid.Row="0" Margin="2,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 處理器天梯 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <local:SectionHead Text="處理器" HelpKey="ranking/處理器" FontSize="16"/>
                        <ComboBox Style="{StaticResource DarkCombo}" Width="110" HorizontalAlignment="Right"
                                  SelectedIndex="{Binding CpuScope, Mode=TwoWay}">
                            <ComboBoxItem Content="桌上型"/>
                            <ComboBoxItem Content="筆記型"/>
                        </ComboBox>
                    </Grid>
                    <TextBox Grid.Row="1" Margin="0,0,0,8"
                             Text="{Binding CpuFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource PrimaryInkBrush}"
                             BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="10,7"
                             CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center"
                             ToolTip="輸入型號關鍵字搜尋處理器"/>
                    <Grid Grid.Row="2" Margin="10,0,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="78"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" Text="名次"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="型號"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="等級" TextAlignment="Center"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="多核分" TextAlignment="Right"/>
                    </Grid>
                    <ListBox Grid.Row="3" Style="{StaticResource RankListStyle}" ItemsSource="{Binding CpuList}"/>
                </Grid>
            </Border>

            <!-- 顯示卡天梯 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <local:SectionHead Text="顯示卡" HelpKey="ranking/顯示卡" FontSize="16"/>
                        <ComboBox Style="{StaticResource DarkCombo}" Width="110" HorizontalAlignment="Right"
                                  SelectedIndex="{Binding GpuScope, Mode=TwoWay}">
                            <ComboBoxItem Content="桌上型"/>
                            <ComboBoxItem Content="筆記型"/>
                        </ComboBox>
                    </Grid>
                    <TextBox Grid.Row="1" Margin="0,0,0,8"
                             Text="{Binding GpuFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource PrimaryInkBrush}"
                             BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="10,7"
                             CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center"
                             ToolTip="輸入型號關鍵字搜尋顯示卡"/>
                    <Grid Grid.Row="2" Margin="10,0,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="78"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" Text="名次"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="型號"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="等級" TextAlignment="Center"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="評分" TextAlignment="Right"/>
                    </Grid>
                    <ListBox Grid.Row="3" Style="{StaticResource RankListStyle}" ItemsSource="{Binding GpuList}"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Margin="4,10,0,0" TextWrapping="Wrap"
                   Text="{Binding CpuSource, StringFormat=第三方公開跑分整理，僅供參考。{0}（topcpu.net）；已自動標示本機硬體所在名次（近似比對）。}"/>
    </Grid>
</UserControl>
