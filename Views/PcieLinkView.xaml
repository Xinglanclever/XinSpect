<UserControl x:Class="XinSpect.PcieLinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <StackPanel Margin="2,0,0,10">
                <local:SectionHead Text="PCIe 鏈路實況" HelpKey="pcie/PCIe 鏈路實況"/>
                <TextBlock Style="{StaticResource Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="直接讀每個裝置的 PCIe 能力結構，把「目前協商到的速度與寬度」和「裝置自己宣告的能力」擺在一起比。x16 的顯示卡實際跑在 x4、NVMe 插在只有兩條通道的 M.2 上，只有這裡看得出來。全程唯讀，不寫任何暫存器。"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="掃描" HelpKey="pcie/掃描"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="重新掃描"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="Refresh_Click" IsEnabled="{Binding PcieLink.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding PcieLink.Summary}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding PcieLink.Status}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/><ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="裝置"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="位置"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="類別"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="目前"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="能力"/>
                        <TextBlock Grid.Column="5" Style="{StaticResource ColHead}" Text="頻寬佔比"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding PcieLink.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel x:Name="Row" Margin="0,2,0,4">
                                    <Grid MinHeight="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/><ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Location}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding Kind}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding CurrentText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding CapableText}" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="5" Style="{StaticResource LoadBar}" Maximum="1" VerticalAlignment="Center"
                                                     Value="{Binding BarFraction, Mode=OneWay}"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" FontSize="11" TextWrapping="Wrap"
                                               Text="{Binding Verdict}"/>
                                    <!-- 自開機以來的錯誤旗標：鏈路速度正常但一直在重試時，只有這裡看得出來 -->
                                    <TextBlock Style="{StaticResource FieldLabel}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,2,0,0" Text="{Binding ErrorText}"
                                               Foreground="{Binding ErrorBadge, Converter={StaticResource SeverityToBrush}}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ══ Resizable BAR ═════════════════════════════════════════════
                 和上面那張表刻意分開：上面讀的是 PCI 設定空間（速度與寬度），這裡讀的是
                 Windows 回報的「已指派記憶體資源」。ReBAR 的能力結構在設定空間 0x100 之後，
                 傳統的 0xCF8／0xCFC 機制到不了那裡，所以兩者走的是不同的路。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="Resizable BAR" HelpKey="pcie/Resizable BAR"/>
                        <Button Style="{StaticResource ToolButton}" Content="重新讀取"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="RefreshBar_Click" IsEnabled="{Binding ResizableBar.CanRefresh}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="ReBAR 要 BIOS 開啟、驅動支援、CSM 關掉、以純 UEFI 開機，四個條件缺一個就不會生效——而 Windows 沒有任何地方告訴你現況，驅動說「支援」也不等於現在真的生效。這裡問的是「這張卡實際被指派了多大的記憶體視窗」：還停在傳統的 256 MB 就是沒生效。不需要驅動也不需要管理員權限。"/>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{Binding ResizableBar.Summary}"/>
                    <TextBlock Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{Binding ResizableBar.Status}"/>

                    <ItemsControl ItemsSource="{Binding ResizableBar.Rows}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8"
                                        Padding="13,10" Margin="0,0,0,7">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                                       Foreground="{DynamicResource PrimaryInkBrush}"/>
                                            <TextBlock Text="{Binding Verdict}" FontSize="13.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                        </Grid>
                                        <local:FieldRow Label="最大記憶體視窗" Value="{Binding LargestText}"/>
                                        <local:FieldRow Label="顯示記憶體總量" Value="{Binding VramText}"/>
                                        <local:FieldRow Label="視窗覆蓋率" Value="{Binding CoverageText}"/>
                                        <local:FieldRow Label="已指派視窗數" Value="{Binding RangeCountText}"/>
                                        <local:FieldRow Label="位置" Value="{Binding Location}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource FieldLabel}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18"/>

                                        <!-- 判定的依據逐段列出：一句「已撐開」不附證據，和沒說一樣 -->
                                        <TextBlock Text="已指派的記憶體視窗" Style="{StaticResource ColHead}" Margin="0,10,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Ranges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource FieldValue}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                                   Style="{StaticResource FieldValue}" TextAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
