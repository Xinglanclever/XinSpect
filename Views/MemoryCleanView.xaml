<UserControl x:Class="XinSpect.MemoryCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
            <StackPanel Margin="2,0,0,10">
                <TextBlock Style="{StaticResource SectionHeader}" Text="記憶體整理"/>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="採 RAMMap 等級的系統記憶體清單操作，真正把待命快取釋回可用記憶體，而非只是移動單一行程的工作集數字。"/>
            </StackPanel>

            <!-- 真實分佈 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="實體記憶體分佈"/>
                        <TextBlock x:Name="LoadText" HorizontalAlignment="Right" FontSize="12.5"
                                   Foreground="{StaticResource SecondaryInkBrush}"/>
                    </Grid>

                    <Border x:Name="BarHost" Height="22" CornerRadius="6" Margin="0,10,0,0" ClipToBounds="True"
                            Background="{StaticResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="UsedSeg" Background="{StaticResource AccentBrush}"/>
                            <Border x:Name="StandbySeg" Background="{StaticResource WarningBrush}"/>
                            <Border x:Name="FreeSeg" Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="使用中" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource SecondaryInkBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="UsedText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                       Foreground="{StaticResource PrimaryInkBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="待命快取（可釋放）" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource SecondaryInkBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="StandbyText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                       Foreground="{StaticResource PrimaryInkBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource HairlineBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="可用" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource SecondaryInkBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="AvailText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                       Foreground="{StaticResource PrimaryInkBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="總計 / 認可" FontSize="12" Foreground="{StaticResource SecondaryInkBrush}"/>
                            <TextBlock x:Name="TotalText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                       Foreground="{StaticResource PrimaryInkBrush}"/>
                            <TextBlock x:Name="CommitText" Text="" FontSize="11" Margin="0,1,0,0"
                                       Foreground="{StaticResource MutedInkBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- 操作 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="一鍵深度整理" Click="Deep_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="重新整理" Click="Refresh_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource ToolButton}" Content="清除待命快取" Click="PurgeStandby_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource ToolButton}" Content="清空所有工作集" Click="EmptyWs_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource ToolButton}" Content="清除低優先待命" Click="PurgeLow_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource ToolButton}" Content="刷新已修改頁面" Click="Flush_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="ResultText" Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- 誠實說明 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="這些動作實際做了什麼（誠實說明）"/>
                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource SecondaryInkBrush}"
                               Text="・清除待命快取：把系統快取的檔案資料釋回「可用」——唯一能大量釋放 RAM 的動作。代價是這些快取本用來加速讀取，清掉後相關檔案下次需重新讀取。適合在跑大型任務前、或待命占用異常膨脹時使用。"/>
                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource SecondaryInkBrush}"
                               Text="・清空工作集：命令所有行程把工作集頁面移往待命清單。「使用中」數字會下降，但頁面多半只是轉到待命、需要時會被重新讀回，可能造成短暫卡頓；本身不等於釋放。"/>
                    <TextBlock Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource SecondaryInkBrush}"
                               Text="・刷新已修改頁面：把已修改頁面寫回磁碟後轉為待命，讓後續清除待命能釋放更多。一鍵深度整理＝清空工作集 → 刷新已修改 → 清除待命，依此順序取得最大實際釋放量。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
