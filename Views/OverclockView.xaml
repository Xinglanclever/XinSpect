<UserControl x:Class="XinSpect.OverclockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>

        <!-- ══ 深色滑桿 ═══════════════════════════════════════════════════════ -->
        <Style x:Key="OcSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="3" Background="{DynamicResource HairlineBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3" Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White"
                                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ 深色核取方塊 ═══════════════════════════════════════════════════ -->
        <Style x:Key="OcCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2">
                                <Path x:Name="check" Width="12" Height="12" Stretch="Uniform"
                                      Data="M2,8 L6,12 L14,3" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ 深色輸入框 ═════════════════════════════════════════════════════ -->
        <Style x:Key="OcTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryInkBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="7" Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ 微調鈕（滑桿下方 ±小/中/大）════════════════════════════════════ -->
        <Style x:Key="OcNudge" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryInkBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{DynamicResource PagePlaneBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ 可展開／收合區塊（深色主題可見的自繪箭頭；預設用於每核心明細）══════ -->
        <Style x:Key="OcExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <!-- 標題列＝可點擊的切換鈕（整條寬），右側自繪三角形隨展開旋轉 -->
                            <ToggleButton Cursor="Hand" HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="hb" CornerRadius="8" Padding="13,10"
                                                Background="{DynamicResource Surface2Brush}"
                                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1.2">
                                            <Grid>
                                                <ContentPresenter ContentSource="Content" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <!-- 收合時朝右的三角形、展開時朝下的三角形（以顯示切換取代旋轉，避免具名 Freezable 觸發器解析問題） -->
                                                <Path x:Name="arrowClosed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Data="M 0 0 L 7 5.5 L 0 11 Z" Fill="{DynamicResource AccentBrush}"/>
                                                <Path x:Name="arrowOpen" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Data="M 0 0 L 11 0 L 5.5 7 Z" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="arrowClosed" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="arrowOpen" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hb" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <!-- 切換鈕的內容＝Expander.Header -->
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <!-- 展開內容：預設收合 -->
                            <ContentPresenter x:Name="content" Visibility="Collapsed" Margin="0,10,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="content" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ 單一旋鈕列（DataContext = OcKnob）════════════════════════════════ -->
        <DataTemplate x:Key="KnobRow">
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="9" Padding="14,11" Margin="0,0,0,9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 標題列：繁中譯名 + 英文原名 + ❓說明 + 整數倍/狀態徽章 -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryInkBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EnglishName}" FontSize="11.5" Margin="8,2,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedInkBrush}"/>
                            <!-- ❓ 圓圈：滑鼠移入顯示說明 + 引用來源 -->
                            <Border Width="17" Height="17" CornerRadius="9" Margin="8,1,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource PagePlaneBrush}" BorderBrush="{DynamicResource MutedInkBrush}" BorderThickness="1"
                                    Cursor="Help" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000"
                                    Visibility="{Binding HasHelp, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="?" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryInkBrush}"/>
                                <Border.ToolTip>
                                    <!-- 底色走佈景的浮出面：寫死深灰底會讓淺色主題的近黑墨色看不見 -->
                                    <ToolTip MaxWidth="380" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource HairlineBrush}"
                                             BorderThickness="1" Padding="11,9">
                                        <TextBlock Text="{Binding HelpTip}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                                   Foreground="{DynamicResource PrimaryInkBrush}"/>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                            <!-- 整數倍徽章（倍頻類） -->
                            <Border Background="{DynamicResource PagePlaneBrush}" CornerRadius="4" Padding="6,1"
                                    Margin="8,1,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsRatio, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="整數倍" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <!-- 狀態徽章（停用／失效／唯讀） -->
                            <Border Background="{DynamicResource PagePlaneBrush}" CornerRadius="4" Padding="6,1"
                                    Margin="8,1,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding Unavailable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StatusBadge}" FontSize="10.5" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="現值 " FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}"/>
                            <TextBlock Text="{Binding ActiveText}" FontSize="12.5" Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="　範圍 " FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}"/>
                            <TextBlock Text="{Binding RangeText}" FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 滑桿列（倍頻類對齊整數刻度） -->
                    <Grid Grid.Row="1" Margin="0,9,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Style="{StaticResource OcSlider}" VerticalAlignment="Center"
                                Minimum="{Binding Min}" Maximum="{Binding Max}"
                                SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                IsSnapToTickEnabled="{Binding SnapToTick}" TickFrequency="{Binding TickFrequency}"
                                Value="{Binding Target, Mode=TwoWay}" IsEnabled="{Binding Writable}"/>
                        <TextBlock Grid.Column="2" Text="{Binding TargetText}" FontSize="17" FontWeight="Bold"
                                   Foreground="{Binding TargetBandBrush}" VerticalAlignment="Center"
                                   MinWidth="104" TextAlignment="Right"/>
                    </Grid>

                    <!-- 微調鈕列：－大 －中 －小　＋小 ＋中 ＋大 -->
                    <WrapPanel Grid.Row="2" Margin="0,0,0,6" IsEnabled="{Binding Writable}">
                        <Button Style="{StaticResource OcNudge}" Tag="-3" Click="Nudge_Click" Content="{Binding NudgeMinus3Text}"/>
                        <Button Style="{StaticResource OcNudge}" Tag="-2" Click="Nudge_Click" Content="{Binding NudgeMinus2Text}"/>
                        <Button Style="{StaticResource OcNudge}" Tag="-1" Click="Nudge_Click" Content="{Binding NudgeMinus1Text}"/>
                        <Border Width="10"/>
                        <Button Style="{StaticResource OcNudge}" Tag="1" Click="Nudge_Click" Content="{Binding NudgePlus1Text}"/>
                        <Button Style="{StaticResource OcNudge}" Tag="2" Click="Nudge_Click" Content="{Binding NudgePlus2Text}"/>
                        <Button Style="{StaticResource OcNudge}" Tag="3" Click="Nudge_Click" Content="{Binding NudgePlus3Text}"/>
                    </WrapPanel>

                    <!-- 狀態列 -->
                    <Grid Grid.Row="3">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ApplyModeText}" FontSize="12"
                                       Foreground="{Binding ApplyModeSeverity, Converter={StaticResource SeverityToBrush}}"/>
                            <TextBlock Text="{Binding DriftText}" FontSize="12" Margin="14,0,0,0"
                                       Foreground="{DynamicResource MutedInkBrush}"/>
                            <TextBlock Text="{Binding ApplyStatus}" FontSize="12" Margin="14,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="360"
                                       Foreground="{Binding ApplySeverity, Converter={StaticResource SeverityToBrush}}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ToolButton}"
                                Click="ApplyKnob_Click" IsEnabled="{Binding Writable}" Content="套用"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,24">

            <!-- ══ 標題 + 引擎狀態 ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="超頻" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource WarningBrush}" CornerRadius="5" Padding="7,2"
                                Margin="12,4,0,0" VerticalAlignment="Center">
                            <TextBlock Text="測試版" FontSize="11.5" FontWeight="SemiBold" Foreground="#1b1b1b"/>
                        </Border>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <local:FieldRow Label="超頻引擎" Value="{Binding Overclock.EngineName}"/>
                            <local:FieldRow Label="處理器" Value="{Binding Overclock.ProcessorFamilyText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="引擎狀態" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Overclock.EngineStatusText}" HorizontalAlignment="Right"
                                           TextAlignment="Right" TextWrapping="Wrap" MaxWidth="360" FontSize="13.5"
                                           Foreground="{Binding Overclock.EngineStatusSeverity, Converter={StaticResource SeverityToBrush}}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource PagePlaneBrush}" CornerRadius="8" Padding="12,9" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}"
                                       Text="本模組透過 Intel XTU 超頻引擎對硬體進行真實寫入。可即時生效的項目會立刻套用；需重新開機的項目（如外頻、記憶體比率）將排入下次開機。若引擎未就緒，畫面僅提供唯讀監測，不會有任何寫入。"/>
                            <!-- 平台限制 + 整數倍調整說明 -->
                            <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12.5" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryInkBrush}"
                                       Text="目前僅支援 Intel 平台（透過 Intel XTU 引擎驅動真實寫入）；AMD 平台尚未支援，於 AMD 機器上本頁僅提供唯讀監測。所有倍頻（全核／單核／負載倍頻上限）一律以整數倍調整，因為 Intel XTU 僅支援整數倍；電壓與電壓偏移則為連續值。"/>
                            <!-- XTU 下載連結 -->
                            <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12.5" Margin="0,8,0,0" Foreground="{DynamicResource MutedInkBrush}">
                                <Run Text="尚未安裝 Intel XTU 引擎？請先下載並安裝 "/><Hyperlink NavigateUri="https://www.intel.com/content/www/us/en/download/17881/intel-extreme-tuning-utility-intel-xtu.html"
                                          RequestNavigate="Link_RequestNavigate" Foreground="{DynamicResource AccentBrush}"
                                          ToolTip="開啟 Intel 官方下載中心（編號 17881）">Intel® Extreme Tuning Utility（XTU）</Hyperlink><Run Text="（Intel 官方下載中心・編號 17881）。安裝後重新啟動本程式即可啟用超頻引擎。"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ 目標時脈規劃（倍頻 × 外頻）══════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="40"
                    Visibility="{Binding Overclock.HasFrequencyPlanner, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="目標時脈規劃" HelpKey="oc/目標時脈規劃"/>
                    <TextBlock Text="{Binding Overclock.TargetFrequencyText}" FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,0,0,12"
                               Foreground="{DynamicResource MutedInkBrush}"
                               Text="最終頻率 = 全核心倍頻 × 外頻（BCLK）。倍頻為整數倍調整（Intel XTU 僅支援整數倍）；外頻與電壓為連續值。倍頻與外頻按「套用目標時脈」一次寫入；全核心電壓（含電壓錶與微調鈕）併在同一區，但有自己的「套用電壓」按鈕，不會被連帶寫入。"/>

                    <!-- 全核心倍頻（整數倍，含微調鈕與說明） -->
                    <ContentControl Content="{Binding Overclock.CoreRatioKnob}" ContentTemplate="{StaticResource KnobRow}"/>

                    <!-- ══ 全核心電壓 Vcore（原本自成一卡，已併入本區）════════════════════
                         頻率與電壓本來就是同一個決定：倍頻拉高多少、電壓要跟著給多少。原「核心電壓
                         Vcore」卡的三樣東西——類比電壓錶（儀表盤）、微調鈕、危險等級徽章——全部搬進
                         來，和倍頻滑桿上下相鄰，不必再在兩張卡之間來回對照同一個 VcoreKnob。
                         套用仍走專用 ApplyVcore_Click（含逐核心扇出邏輯與高電壓二次確認）。 -->
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="9" Padding="14,11" Margin="0,0,0,9"
                            Visibility="{Binding Overclock.HasVcore, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- 標題列。❓ 沿用「核心電壓 Vcore」那條說明：裡頭的高電壓風險警告
                                 （過壓會永久加速電晶體老化）不能因為併卡而消失。 -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="全核心電壓" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryInkBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="All-Core Voltage（Vcore）" FontSize="11.5" Margin="8,2,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource MutedInkBrush}"/>
                                    <local:HelpDot HelpKey="oc/核心電壓 Vcore" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="現值 " FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}"/>
                                    <TextBlock Text="{Binding Overclock.VcoreKnob.ActiveText}" FontSize="12.5" Foreground="{DynamicResource SecondaryInkBrush}"/>
                                    <TextBlock Text="　範圍 " FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}"/>
                                    <TextBlock Text="{Binding Overclock.VcoreKnob.RangeText}" FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 聚合說明：此平台僅提供逐核心覆寫時，說明本滑桿會一次套用至全部核心 -->
                            <TextBlock Text="{Binding Overclock.VcoreScopeText}" TextWrapping="Wrap" FontSize="12"
                                       LineHeight="18" Margin="0,6,0,0" Foreground="{DynamicResource MutedInkBrush}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 類比電壓錶（儀表盤）：實測值，與下方滑桿的「目標值」分屬兩件事 -->
                                <local:AnalogVoltMeter Grid.Column="0" VerticalAlignment="Top"
                                                       Value="{Binding Overclock.VoltmeterValue}"
                                                       Max="{Binding Overclock.VoltmeterMax}"
                                                       DangerFrom="1.4" Caption="Vcore（伏特）"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <!-- 實測讀值 ＋ 危險等級徽章（≥1.5 V 閃爍） -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Overclock.VoltageValueText}" FontSize="34" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryInkBrush}" VerticalAlignment="Center"/>
                                        <Border CornerRadius="8" Padding="11,5" Margin="14,4,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{Binding Overclock.VoltageBadgeBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Overclock.VoltageBadgeFlashing}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="Flash">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.3" Duration="0:0:0.5"
                                                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="Flash"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Overclock.VoltageBadgeText}" FontSize="13.5"
                                                       FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 目標電壓滑桿（起點＝目前電壓） -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource OcSlider}" VerticalAlignment="Center"
                                                Minimum="{Binding Overclock.VcoreKnob.Min}" Maximum="{Binding Overclock.VcoreKnob.Max}"
                                                SmallChange="0.005" LargeChange="0.01"
                                                Value="{Binding Overclock.VcoreKnob.Target, Mode=TwoWay}"
                                                IsEnabled="{Binding Overclock.VcoreKnob.Writable}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Overclock.VcoreKnob.TargetText}" FontSize="18"
                                                   FontWeight="Bold" Foreground="{Binding Overclock.VcoreKnob.TargetBandBrush}"
                                                   MinWidth="104" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 微調鈕（±0.01／±0.05／±0.1 V）：DataContext 換成旋鈕本身，
                                         Nudge_Click 直接從 sender 的 DataContext 取 OcKnob -->
                                    <WrapPanel Margin="0,10,0,0" DataContext="{Binding Overclock.VcoreKnob}"
                                               IsEnabled="{Binding Writable}">
                                        <Button Style="{StaticResource OcNudge}" Tag="-3" Click="Nudge_Click" Content="{Binding NudgeMinus3Text}"/>
                                        <Button Style="{StaticResource OcNudge}" Tag="-2" Click="Nudge_Click" Content="{Binding NudgeMinus2Text}"/>
                                        <Button Style="{StaticResource OcNudge}" Tag="-1" Click="Nudge_Click" Content="{Binding NudgeMinus1Text}"/>
                                        <Border Width="10"/>
                                        <Button Style="{StaticResource OcNudge}" Tag="1" Click="Nudge_Click" Content="{Binding NudgePlus1Text}"/>
                                        <Button Style="{StaticResource OcNudge}" Tag="2" Click="Nudge_Click" Content="{Binding NudgePlus2Text}"/>
                                        <Button Style="{StaticResource OcNudge}" Tag="3" Click="Nudge_Click" Content="{Binding NudgePlus3Text}"/>
                                    </WrapPanel>

                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="{Binding Overclock.VcoreKnob.ApplyModeText}" HorizontalAlignment="Left" FontSize="12"
                                                   Foreground="{Binding Overclock.VcoreKnob.ApplyModeSeverity, Converter={StaticResource SeverityToBrush}}"/>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource ToolButton}" Content="套用電壓"
                                                Click="ApplyVcore_Click" IsEnabled="{Binding Overclock.VcoreKnob.Writable}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 外頻 BCLK（連續值；多為重開機生效）。無外頻旋鈕（如 X299）時整列隱藏，避免空白鬼影列 -->
                    <ContentControl Content="{Binding Overclock.BclkKnob}" ContentTemplate="{StaticResource KnobRow}"
                                    Visibility="{Binding Overclock.HasBclk, Converter={StaticResource BoolToVis}}"/>

                    <!-- PCIe 瓶頸提醒 -->
                    <Border Background="{DynamicResource PagePlaneBrush}" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                            Visibility="{Binding Overclock.PcieWarningVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="5" CornerRadius="3" Background="{DynamicResource WarningBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Overclock.PcieWarningText}" TextWrapping="Wrap" MaxWidth="700"
                                       FontSize="12.5" LineHeight="20" Foreground="{DynamicResource SeriousBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                            Click="ApplyPlanner_Click" Content="套用目標時脈"/>
                </StackPanel>
            </Border>

            <!-- ══ 快取（Uncore／Ring：頻率＋電壓同區）══════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="50"
                    Visibility="{Binding Overclock.HasCacheKnobs, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="快取 Cache（Uncore／Ring）" HelpKey="oc/快取 Cache（Uncore／Ring）"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,0,0,4"
                               Foreground="{DynamicResource MutedInkBrush}"
                               Text="快取（環匯流排）倍頻與電壓／電壓偏移集中於此，緊接目標時脈規劃之下。倍頻為整數倍；電壓偏移範圍限 −1 V～+1 V、預設 0 V。細節見各列 ❓ 說明。"/>
                    <ItemsControl ItemsSource="{Binding Overclock.CacheKnobs}" ItemTemplate="{StaticResource KnobRow}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══ 示波器（電壓 / 電流波形）══════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="80">
                <StackPanel>
                    <local:SectionHead Text="即時波形" HelpKey="oc/即時波形"/>
                    <!-- 通道色固定：兩條線同時在畫面上，顏色是識別而非裝飾（同 CoreDetailWindow） -->
                    <local:Oscilloscope Height="126" Margin="0,4,0,0"
                                        History="{Binding Overclock.OscilloVolt}"
                                        TraceBrush="#35E06A" Caption="Vcore 波形"/>
                    <local:Oscilloscope Height="126" Margin="0,12,0,0"
                                        History="{Binding Overclock.OscilloCurrent}"
                                        TraceBrush="#F0C24A" Caption="電流波形（估算）"/>
                </StackPanel>
            </Border>

            <!-- ══ 即時遙測 ══════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="100">
                <StackPanel>
                    <local:SectionHead Text="即時遙測" HelpKey="oc/即時遙測"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <!-- 核心溫度（依嚴重度上色） -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="核心溫度" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Overclock.CoreTempText}" HorizontalAlignment="Right" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{Binding Overclock.CoreTempSeverity, Converter={StaticResource SeverityToBrush}}"/>
                            </Grid>
                            <local:FieldRow Label="即時有效頻率" Value="{Binding Overclock.EffectiveClockText}"/>
                            <local:FieldRow Label="電流（估算）" Value="{Binding Overclock.CurrentText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <local:FieldRow Label="功耗限制 PL1" Value="{Binding Overclock.Pl1Text}"/>
                            <local:FieldRow Label="功耗限制 PL2" Value="{Binding Overclock.Pl2Text}"/>
                            <!-- VRM 溫度（依嚴重度上色） -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="VRM 溫度" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Overclock.VrmTempText}" HorizontalAlignment="Right" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{Binding Overclock.VrmTempSeverity, Converter={StaticResource SeverityToBrush}}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ 核心熱區圖（IHS 風格）═════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="120">
                <StackPanel>
                    <Grid>
                        <local:SectionHead Text="核心熱區圖" HelpKey="oc/核心熱區圖" HorizontalAlignment="Left"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ToolButton}"
                                Click="OpenCoreDetail_Click" Content="每核心明細 ↗"
                                ToolTip="開啟獨立視窗：每核心即時溫度、每核心電壓設定值與封裝 Vcore／電流波形"/>
                    </Grid>
                    <TextBlock Text="每格對應一個實體核心，紅＝熱、藍＝冷。" FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource MutedInkBrush}"/>
                    <local:CoreHeatmap Cores="{Binding Overclock.Cores}"/>
                </StackPanel>
            </Border>

            <!-- ══ 體質評分（矽晶品質特徵化）═════════════════════════════════
                 舊版是「取樣 5 秒、抓峰值頻率與當下電壓、套一條寫死的參考線換成 0–100 分」。
                 那個分數沒有統計意義，也分不出「體質好」與「使用者自己降過壓」。這一版改成多點
                 V/F 特徵化：程式自己控制負載階梯讓處理器走過睿頻表，逐段取一個工作點，擬合出
                 V ＝ a ＋ k·f，再在重心頻率上與世代參考線相減。畫面上四件事分開陳列——
                 推估（百分位）、實測（ΔV／斜率／C_eff）、條件（信賴度與溫度）、方法與出處。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="140">
                <StackPanel>
                    <local:SectionHead Text="體質評分" HelpKey="oc/體質評分"/>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 推估值：百分位而不是「幾分」。單位一定要寫出來，否則 78 會被讀成滿分 100 的 78 分 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="96">
                            <TextBlock Text="{Binding Overclock.SiliconScoreText}" FontSize="46" FontWeight="Bold"
                                       Foreground="{Binding Overclock.SiliconSeverity, Converter={StaticResource SeverityToBrush}}"/>
                            <TextBlock Text="{Binding Overclock.SiliconScoreUnit}" FontSize="11.5" Margin="0,-4,0,0"
                                       Foreground="{DynamicResource MutedInkBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Overclock.SiliconVerdict}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{Binding Overclock.SiliconSeverity, Converter={StaticResource SeverityToBrush}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="族內位置 " FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}"/>
                                <TextBlock Text="{Binding Overclock.SiliconPercentileText}" FontSize="12.5"
                                           Foreground="{DynamicResource SecondaryInkBrush}"/>
                                <TextBlock Text="　信賴度 " FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}"/>
                                <TextBlock Text="{Binding Overclock.SiliconConfidenceText}" FontSize="12.5"
                                           Foreground="{Binding Overclock.SiliconConfidenceSeverity, Converter={StaticResource SeverityToBrush}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Overclock.SiliconDetail}" FontSize="12.5" Margin="0,8,0,0"
                                       TextWrapping="Wrap" MaxWidth="640" LineHeight="20"
                                       Foreground="{DynamicResource MutedInkBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 開始／停止 ＋ 進度。取樣期間會逐階把處理器推到滿載，必須先說清楚 -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Click="RetestSilicon_Click"
                                IsEnabled="{Binding Overclock.SiliconCanTest}"
                                Content="{Binding Overclock.SiliconTestButtonText}"/>
                        <Button Style="{StaticResource ToolButton}" Margin="10,0,0,0" Content="停止"
                                Click="CancelSilicon_Click"
                                Visibility="{Binding Overclock.SiliconTesting, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="約 20–30 秒。程式會自己控制負載階梯（1／2／4… 顆核心滿載）讓處理器走過睿頻表，全程唯讀，不寫入任何倍頻或電壓。"
                                   FontSize="12" TextWrapping="Wrap" MaxWidth="520" LineHeight="18" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedInkBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding Overclock.SiliconTesting, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Style="{StaticResource LoadBar}"
                                     Value="{Binding Overclock.SiliconProgressPercent, Mode=OneWay}"/>
                        <TextBlock Text="{Binding Overclock.SiliconPhase}" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryInkBrush}"/>
                    </StackPanel>
                    <!-- ── 實測結果表：每一列都附「這個數字怎麼來的／代表什麼」 ─────────── -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding Overclock.SiliconMetrics.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="量到什麼" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource PrimaryInkBrush}"/>
                        <ItemsControl ItemsSource="{Binding Overclock.SiliconMetrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8"
                                            Padding="13,10" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource PrimaryInkBrush}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Value}" FontSize="14.5" FontWeight="Bold"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,4,0,0"
                                                           TextWrapping="Wrap" LineHeight="18"
                                                           Foreground="{DynamicResource MutedInkBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- ── 原始素材：實際取到的 V/F 工作點，逐點列出 ──────────────────
                         這是整份評定的依據，不該藏起來：使用者看到「6 核那一階只有 3 筆取樣」
                         就知道該對那個點的權重打折，而看不到就只能相信一個數字。 -->
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding Overclock.SiliconPoints.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="取到的 V/F 工作點" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource PrimaryInkBrush}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="活躍核心" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="有效頻率" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="2" Text="最低電壓" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="3" Text="封裝溫度" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="4" Text="封裝功耗" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="5" Text="取樣數" Style="{StaticResource FieldLabel}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Overclock.SiliconPoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="7"
                                            Padding="0,7" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="72"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CoresText}" Style="{StaticResource FieldValue}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FreqText}" Style="{StaticResource FieldValue}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VoltText}" Style="{StaticResource FieldValue}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TempText}" Style="{StaticResource FieldValue}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding PowerText}" Style="{StaticResource FieldValue}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding SamplesText}" Style="{StaticResource FieldValue}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- ── 方法與出處：每個數字是從哪個介面讀來的 ────────────────────── -->
                    <Border Background="{DynamicResource PagePlaneBrush}" CornerRadius="8" Padding="12,9" Margin="0,10,0,0"
                            Visibility="{Binding Overclock.HasSiliconResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Overclock.SiliconMethodText}" TextWrapping="Wrap"
                                   FontSize="12.5" LineHeight="20" Foreground="{DynamicResource MutedInkBrush}"/>
                    </Border>

                    <!-- ── 這個數字不能拿去做什麼：限制與前提，逐條列出 ───────────────── -->
                    <Border Background="{DynamicResource PagePlaneBrush}" CornerRadius="8" Padding="12,9" Margin="0,8,0,0"
                            Visibility="{Binding Overclock.HasSiliconCaveats, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="5" CornerRadius="3" Background="{DynamicResource WarningBrush}" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="這個數字的前提與限制" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,5"
                                           Foreground="{DynamicResource SecondaryInkBrush}"/>
                                <TextBlock Text="{Binding Overclock.SiliconCaveatText}" TextWrapping="Wrap" MaxWidth="700"
                                           FontSize="12.5" LineHeight="20" Foreground="{DynamicResource MutedInkBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ 核心 ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="160"
                    Visibility="{Binding Overclock.HasCoreKnobs, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="核心 Core" HelpKey="oc/核心 Core"/>
                    <ItemsControl ItemsSource="{Binding Overclock.CoreKnobs}" ItemTemplate="{StaticResource KnobRow}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══ 功耗 ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="180"
                    Visibility="{Binding Overclock.HasPowerKnobs, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="功耗 Power" HelpKey="oc/功耗 Power"/>
                    <ItemsControl ItemsSource="{Binding Overclock.PowerKnobs}" ItemTemplate="{StaticResource KnobRow}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══ 記憶體 ════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="200"
                    Visibility="{Binding Overclock.HasMemoryKnobs, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="記憶體 Memory" HelpKey="oc/記憶體 Memory"/>
                    <ItemsControl ItemsSource="{Binding Overclock.MemoryKnobs}" ItemTemplate="{StaticResource KnobRow}" Margin="0,4,0,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedInkBrush}"
                               Text="註：記憶體比率／電壓多為需重新開機生效項目。Gear 1/2 為 Comet Lake 以後平台的記憶體控制器分頻概念；此平台若無對應旋鈕則不顯示，實際等效頻率與 Gear 以 BIOS 回報為準。"/>
                </StackPanel>
            </Border>

            <!-- ══ 匯流排（外頻 / PCIe）══════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="220"
                    Visibility="{Binding Overclock.HasBusKnobs, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="匯流排 Bus" HelpKey="oc/匯流排 Bus"/>
                    <ItemsControl ItemsSource="{Binding Overclock.BusKnobs}" ItemTemplate="{StaticResource KnobRow}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══ 每核心獨立調節（倍頻上限＋電壓＋偏移 合併）══════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="230"
                    Visibility="{Binding Overclock.HasCoreTuneRows, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="每核心獨立調節 Per-Core" HelpKey="oc/每核心獨立調節 Per-Core"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,0,0,4"
                               Foreground="{DynamicResource MutedInkBrush}"
                               Text="每顆實體核心的倍頻上限、電壓覆寫與電壓偏移合併於同一區塊；倍頻為整數倍。並非所有平台都開放單核調節，未提供的項目不顯示。細節見各列 ❓ 說明。"/>
                    <Expander Style="{StaticResource OcExpander}" IsExpanded="False" Margin="0,4,0,0">
                        <Expander.Header>
                            <TextBlock Text="展開／收合每核心明細（預設收合，避免畫面雜亂）" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryInkBrush}"/>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Overclock.CoreTuneRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- DataContext = CoreTuneRow；缺席的子項（Ratio／Voltage／Offset）整列隱藏，避免空白鬼影列 -->
                                    <Border Background="{DynamicResource PagePlaneBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                            <ContentControl Content="{Binding Ratio}"   ContentTemplate="{StaticResource KnobRow}"
                                                            Visibility="{Binding HasRatio, Converter={StaticResource BoolToVis}}"/>
                                            <ContentControl Content="{Binding Voltage}" ContentTemplate="{StaticResource KnobRow}"
                                                            Visibility="{Binding HasVoltage, Converter={StaticResource BoolToVis}}"/>
                                            <ContentControl Content="{Binding Offset}"  ContentTemplate="{StaticResource KnobRow}"
                                                            Visibility="{Binding HasOffset, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ══ 進階 ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="240"
                    Visibility="{Binding Overclock.HasAdvancedKnobs, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="進階 Advanced" HelpKey="oc/進階 Advanced"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedInkBrush}"
                               Text="含 PL1 時間窗、各負載核心數倍頻上限等進階項目，數量較多；預設收合以保持畫面整潔，需要時再展開。"/>
                    <Expander Style="{StaticResource OcExpander}" IsExpanded="False" Margin="0,6,0,0">
                        <Expander.Header>
                            <TextBlock Text="展開／收合進階項目（預設收合，避免畫面雜亂）" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryInkBrush}"/>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Overclock.AdvancedKnobs}" ItemTemplate="{StaticResource KnobRow}"/>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ══ 負載線校準 LLC ════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="260">
                <StackPanel>
                    <local:SectionHead Text="負載線校準 LLC" HelpKey="oc/負載線校準 LLC"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="等級" Style="{StaticResource FieldValue}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" Style="{StaticResource DarkCombo}"
                                  ItemsSource="{Binding Overclock.LlcLevels}"
                                  SelectedIndex="{Binding Overclock.LlcIndex, Mode=TwoWay}"/>
                    </Grid>
                    <TextBlock Text="{Binding Overclock.LlcAnnotation}" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                               Margin="0,10,0,0" Foreground="{DynamicResource SecondaryInkBrush}"/>
                    <Border Background="{DynamicResource PagePlaneBrush}" CornerRadius="8" Padding="12,9" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource MutedInkBrush}"
                                   Text="誠實提醒：LLC 只能於 BIOS 設定，XTU／軟體層無法寫入。此處為對照說明，協助你在 BIOS 中選擇對應等級，本程式不會宣稱已套用 LLC。"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ 看門狗 / 開機還原 ═════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="280">
                <StackPanel>
                    <local:SectionHead Text="看門狗與安全網" HelpKey="oc/看門狗與安全網"/>
                    <CheckBox Style="{StaticResource OcCheck}" Margin="0,6,0,0"
                              IsChecked="{Binding Overclock.WatchdogEnabled, Mode=TwoWay}"
                              Content="啟用看門狗（套用後 30 秒無回應即自動還原設定）"/>
                    <CheckBox Style="{StaticResource OcCheck}" Margin="0,12,0,0"
                              IsChecked="{Binding Overclock.BootRestore, Mode=TwoWay}"
                              Content="開機自動回復最後穩定設定（崩潰重開後）"/>
                    <Grid Margin="0,14,0,0">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Overclock.WatchdogStatusText}" FontSize="13"
                                       Foreground="{DynamicResource SecondaryInkBrush}"/>
                            <TextBlock Text="{Binding Overclock.HwWatchdogText}" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedInkBrush}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}"
                                Click="ConfirmStable_Click" Content="確認目前設定穩定"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ 一鍵加速（Speed Optimizer）════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="300"
                    Visibility="{Binding Overclock.SpeedOptimizerSupported, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <local:SectionHead Text="一鍵加速 Speed Optimizer" HelpKey="oc/一鍵加速 Speed Optimizer"/>
                    <TextBlock Text="{Binding Overclock.SpeedOptimizerStatusText}" FontSize="13" Margin="0,4,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInkBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Click="SpeedOptOn_Click" Content="開啟"/>
                        <Button Style="{StaticResource ToolButton}" Margin="10,0,0,0" Click="SpeedOptExtreme_Click" Content="極限模式"/>
                        <Button Style="{StaticResource ToolButton}" Margin="10,0,0,0" Click="SpeedOptOff_Click" Content="關閉"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ 設定檔（Profile）══════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="320">
                <StackPanel>
                    <local:SectionHead Text="設定檔" HelpKey="oc/設定檔"/>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource OcTextBox}"
                                 Text="{Binding Overclock.ProfileNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="SaveProfile_Click" Content="儲存目前設定"/>
                        <Button Grid.Column="4" Style="{StaticResource ToolButton}" Click="ExportProfile_Click" Content="匯出 .ocp"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Style="{StaticResource DarkCombo}"
                                  ItemsSource="{Binding Overclock.Profiles}"
                                  SelectedIndex="{Binding Overclock.SelectedProfileIndex, Mode=TwoWay}"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="ApplyProfile_Click" Content="套用所選"/>
                        <Button Grid.Column="4" Style="{StaticResource ToolButton}" Click="ImportProfile_Click" Content="匯入 .ocp"/>
                    </Grid>

                    <Button HorizontalAlignment="Left" Style="{StaticResource ToolButton}" Margin="0,12,0,0"
                            Click="ApplyLastStable_Click" Content="回復最後穩定設定"
                            Visibility="{Binding Overclock.HasLastStable, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ══ 簡易燒機 ══════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" local:Anim.RevealDelay="340">
                <StackPanel>
                    <local:SectionHead Text="簡易燒機（穩定度測試）" HelpKey="oc/簡易燒機（穩定度測試）"/>
                    <TextBlock Text="約 5 分鐘全核心壓力測試，記錄最高溫；若核心溫度超過 100°C 將自動暫停並回退電壓。"
                               FontSize="12.5" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedInkBrush}"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <local:FieldRow Label="階段" Value="{Binding Overclock.Stress.Phase}"/>
                            <local:FieldRow Label="已經過" Value="{Binding Overclock.Stress.ElapsedText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <local:FieldRow Label="最高溫" Value="{Binding Overclock.Stress.MaxTempText}"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="判定" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Overclock.Stress.StabilityText}" HorizontalAlignment="Right" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{Binding Overclock.Stress.StabilitySeverity, Converter={StaticResource SeverityToBrush}}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Height="8" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding Overclock.Stress.ProgressPercent, Mode=OneWay}"
                                 Background="{DynamicResource HairlineBrush}" Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Click="StressStart_Click" Content="開始簡易燒機"
                                IsEnabled="{Binding Overclock.Stress.CanStart}"/>
                        <Button Style="{StaticResource ToolButton}" Margin="10,0,0,0" Click="StressStop_Click" Content="停止"
                                IsEnabled="{Binding Overclock.Stress.IsRunning}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ 全域動作列 ════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" local:Anim.RevealDelay="360">
                <StackPanel>
                    <local:SectionHead Text="套用與還原" HelpKey="oc/套用與還原"/>
                    <TextBlock Text="{Binding Overclock.ActionStatus}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{Binding Overclock.ActionSeverity, Converter={StaticResource SeverityToBrush}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Click="ApplyAll_Click" Content="全部套用"/>
                        <Button Style="{StaticResource ToolButton}" Margin="10,0,0,0" Click="Discard_Click" Content="取消變更"/>
                        <Button Style="{StaticResource ToolButton}" Margin="10,0,0,0" Click="RestoreDefaults_Click" Content="還原預設"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
