<Project Sdk="Microsoft.NET.Sdk">

  <!-- XtuBridge：以原生 .NET Framework 4.8 執行階段承載 Intel XTU SDK。 -->
  <!-- .NET 10 已移除 SDK 建構所需的舊版 WCF（System.ServiceModel 4.0.0.0），故獨立成一支 exe。 -->
  <!-- 本機僅裝有 .NET 10 SDK，透過 Microsoft.NETFramework.ReferenceAssemblies 免安裝開發包即可建置 net48。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>XtuBridge</AssemblyName>
    <RootNamespace>XtuBridge</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 診斷紀錄用途，release 亦保留符號檔以利離線分析（發佈時再視需要刪） -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- JSON 協定：JavaScriptSerializer 屬 .NET Framework 內建（GAC），不增加任何需內嵌的相依檔。 -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
