<Window x:Class="XinSpect.MiniOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XinSpect"
        Title="曦覽 監視器"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding Settings.MiniTopmost, Mode=OneWay}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True">
    <Grid>
        <!-- 半透明底板：只有底板變淡，上層讀值文字維持不透明才讀得清楚 -->
        <Border CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                Opacity="{Binding Settings.MiniOpacity, Mode=OneWay}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- 內容（不透明，可拖曳） -->
        <Border x:Name="DragSurface" CornerRadius="14" Padding="16,13" Background="Transparent"
                MouseLeftButtonDown="Drag">
            <StackPanel Width="196">
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Border Width="6" Height="16" CornerRadius="3" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="曦覽 監視器" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource PrimaryInkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 收起 / 釘選 / 關閉：原本要回主視窗或系統匣才關得掉，這裡就地給出口 -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniIconButton}"
                            Click="Close_Click" Content="✕" ToolTip="關閉監視器"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniIconButton}" Margin="0,0,2,0"
                            Click="Pin_Click" Content="{Binding Settings.MiniTopmost, Converter={StaticResource BoolToPinGlyph}}"
                            ToolTip="切換是否永遠置頂"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniIconButton}" Margin="0,0,2,0"
                            Click="Compact_Click" Content="{Binding Settings.MiniCompact, Converter={StaticResource BoolToCompactGlyph}}"
                            ToolTip="精簡／展開（收起波形）"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniIconButton}" Margin="0,0,2,0"
                            Click="Gear_Click" Content="⚙" ToolTip="顯示項目"/>
                </DockPanel>

                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,9"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 各行可用齒輪選單開關；FPS 三行讀「幀時間監測」的即時量測，沒在量就誠實顯示 — -->
                    <!-- CPU -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowCpu, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Margin="0,1"
                               Foreground="{DynamicResource PrimaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowCpu, Converter={StaticResource BoolToVis}}"
                               Text="{Binding Live.CpuLoad, StringFormat={}{0:0} %, FallbackValue=—, TargetNullValue=—}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                               Foreground="{Binding Live.CpuTempSeverity, Converter={StaticResource SeverityToBrush}}"
                               Visibility="{Binding Settings.MiniShowCpu, Converter={StaticResource BoolToVis}}"
                               Text="{Binding Live.CpuTemp, StringFormat={}{0:0}°C, FallbackValue=—, TargetNullValue=—}"/>

                    <!-- GPU -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowGpu, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Margin="0,1"
                               Foreground="{DynamicResource PrimaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowGpu, Converter={StaticResource BoolToVis}}"
                               Text="{Binding Live.PrimaryGpu.LoadPercent, StringFormat={}{0:0} %, FallbackValue=—, TargetNullValue=—}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                               Foreground="{Binding Live.PrimaryGpu.TempSeverity, Converter={StaticResource SeverityToBrush}}"
                               Visibility="{Binding Settings.MiniShowGpu, Converter={StaticResource BoolToVis}}"
                               Text="{Binding Live.PrimaryGpu.TempC, StringFormat={}{0:0}°C, FallbackValue=—, TargetNullValue=—}"/>

                    <!-- 記憶體 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="記憶體" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowMem, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold" Margin="0,1"
                               Foreground="{DynamicResource PrimaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowMem, Converter={StaticResource BoolToVis}}"
                               Text="{Binding Live.MemLoad, StringFormat={}{0:0} %, FallbackValue=—, TargetNullValue=—}"/>

                    <!-- 頻率 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="頻率" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowClock, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" FontSize="13.5" Margin="0,1"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowClock, Converter={StaticResource BoolToVis}}"
                               Text="{Binding Live.CpuClock, StringFormat={}{0:0} MHz, FallbackValue=—, TargetNullValue=—}"/>

                    <!-- FPS -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="FPS" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowFps, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold" Margin="0,1"
                               Foreground="{DynamicResource PrimaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowFps, Converter={StaticResource BoolToVis}}"
                               Text="{Binding FrameTime.Stats.AvgFps, FallbackValue=—}"/>

                    <!-- 1% Low -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="1% Low" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowLow1, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" FontSize="13.5" Margin="0,1"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowLow1, Converter={StaticResource BoolToVis}}"
                               Text="{Binding FrameTime.Stats.Low1, FallbackValue=—}"/>

                    <!-- 0.1% Low -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="0.1% Low" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowLow01, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" FontSize="13.5" Margin="0,1"
                               Foreground="{DynamicResource SecondaryInkBrush}"
                               Visibility="{Binding Settings.MiniShowLow01, Converter={StaticResource BoolToVis}}"
                               Text="{Binding FrameTime.Stats.Low01, FallbackValue=—}"/>
                </Grid>

                <!-- 示波線：CPU / GPU 使用率即時波形（精簡模式收起） -->
                <StackPanel Visibility="{Binding Settings.MiniCompact, Converter={StaticResource InverseBoolToVis}}">
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,11,0,9"/>
                    <local:Oscilloscope Height="46" MinHeight="0" Caption="CPU 使用率" History="{Binding CpuLoadHist}"/>
                    <local:Oscilloscope Height="46" MinHeight="0" Margin="0,8,0,0" Caption="GPU 使用率" History="{Binding GpuHist}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
