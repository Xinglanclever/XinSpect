<Project Sdk="Microsoft.NET.Sdk">

  <!-- 曦覽 XinSpect 測試。
       目標框架須與本體一致（net10.0-windows + UseWPF）：受測型別散落在同一組件中，
       其中部分檔案相依 WPF 型別（Geometry / Brush），故測試組件亦需 WPF 參考。
       絕大多數為純函式驗證；唯一例外是 UiSmokeTests（真的建構各頁檢視以攔繫結錯誤，
       細節與安全性論證見該檔類別註解）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>XinSpect.Tests</AssemblyName>
    <RootNamespace>XinSpect.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XinSpect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 解碼器的基準檔：從真實硬體傾印出來的原始位元組（見 Fixtures\README.md）。
       合成資料只用來造邊界情況——正確位移一律靠真實位元組驗證，
       否則測試會照著錯誤的實作長出來，把 bug 一起鎖死（1.9.1-B1 的 NVMe 位移就是這樣漏掉的）。 -->
  <ItemGroup>
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
