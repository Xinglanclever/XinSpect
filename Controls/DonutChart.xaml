<UserControl x:Class="XinSpect.DonutChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             Width="160" Height="188">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="132"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <!-- 底環 -->
            <Ellipse Width="118" Height="118" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{DynamicResource HairlineBrush}" StrokeThickness="14"/>
            <!-- 已用弧（動畫掃掠） -->
            <Path x:Name="UsedArc" StrokeThickness="14"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{Binding RingBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DonutChart}}}">
                <Path.Effect>
                    <DropShadowEffect x:Name="ArcGlow" BlurRadius="10" ShadowDepth="0" Opacity="0.5" Color="#3987e5"/>
                </Path.Effect>
            </Path>
            <!-- 中央百分比 + 副標 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CenterLabel" Text="0%" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryInkBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubLabel" FontSize="11" Foreground="{DynamicResource MutedInkBrush}"
                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <TextBlock x:Name="CaptionLabel" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryInkBrush}" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Caption2Label" FontSize="11.5" Foreground="{DynamicResource MutedInkBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
