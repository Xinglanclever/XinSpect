<UserControl x:Class="XinSpect.CoreHeatmap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             x:Name="HeatRoot">
    <UserControl.Resources>
        <local:HeatConverter x:Key="Heat"/>
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding Cores, ElementName=HeatRoot}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Width="62" Height="52" Margin="4" CornerRadius="7"
                        Background="{Binding TempC, Converter={StaticResource Heat}}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" Opacity="0.92"/>
                        <TextBlock Text="{Binding TempText}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0.6" Opacity="0.6" Color="Black"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
