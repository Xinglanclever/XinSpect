<UserControl x:Class="XinSpect.AnalogVoltMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XinSpect"
             Width="234" Height="176">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="132"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="10" Background="{StaticResource PagePlaneBrush}"
                BorderThickness="1" BorderBrush="{StaticResource HairlineBrush}" ClipToBounds="True">
            <Canvas x:Name="Dial" Width="234" Height="132" IsHitTestVisible="False">
                <!-- 刻度弧與危險區、刻度線由程式於載入時繪製，加入此畫布 -->
                <Line x:Name="Needle" X1="117" Y1="118" X2="117" Y2="30"
                      Stroke="{StaticResource CriticalBrush}" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Triangle">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="NeedleRotate" Angle="0" CenterX="117" CenterY="118"/>
                    </Line.RenderTransform>
                    <Line.Effect>
                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.55" Color="#d03b3b"/>
                    </Line.Effect>
                </Line>
                <Ellipse Canvas.Left="107" Canvas.Top="108" Width="20" Height="20"
                         Fill="{StaticResource SecondaryInkBrush}"/>
                <Ellipse Canvas.Left="112" Canvas.Top="113" Width="10" Height="10"
                         Fill="{StaticResource PrimaryInkBrush}"/>
                <TextBlock x:Name="ValueText" Canvas.Left="0" Canvas.Top="92" Width="234"
                           TextAlignment="Center" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryInkBrush}" Text="—"/>
            </Canvas>
        </Border>

        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="12.5" Foreground="{StaticResource SecondaryInkBrush}"
                   Text="{Binding Caption, RelativeSource={RelativeSource AncestorType={x:Type local:AnalogVoltMeter}}}"/>
    </Grid>
</UserControl>
