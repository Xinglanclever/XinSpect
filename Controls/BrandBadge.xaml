<UserControl x:Class="XinSpect.BrandBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="BadgeRoot">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="Emblem" Width="48" Height="48" CornerRadius="12" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect x:Name="EmblemShadow" BlurRadius="10" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Viewbox x:Name="GlyphBox" Stretch="Uniform" Margin="10">
                    <Path x:Name="Glyph" Fill="#FFFFFF" Data="M0,0 L100,0 100,100 0,100 Z"/>
                </Viewbox>
                <!-- 特殊型號的官方 logo 圖檔（Assets/{cpu|gpu}/{id}.png 存在時覆蓋向量字形） -->
                <Image x:Name="LogoImage" Stretch="Uniform" Margin="6" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- 頂部光澤：讓色塊像一枚圖標磚 -->
                <Border CornerRadius="12,12,20,20" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#38FFFFFF"/>
                            <GradientStop Offset="0.5" Color="#0DFFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="12" BorderThickness="1" IsHitTestVisible="False"
                        BorderBrush="#22FFFFFF"/>

                <!-- ═══ 選配疊加層（於程式碼設定色彩／尺寸／位置，預設隱藏）═══ -->
                <!-- 矩形邊框：8086K 青邊 / 9990XE・Everest 炫彩 / Titan 銀邊 / CEO 金邊 -->
                <Border x:Name="FrameOverlay" IsHitTestVisible="False" Visibility="Collapsed"/>
                <!-- 圓形環：撕裂者紅圈 -->
                <Ellipse x:Name="RingOverlay" IsHitTestVisible="False" Visibility="Collapsed"/>
                <!-- 徽章內文字（ES / XE / Everest / 撕裂者 Ryzen）：以 Viewbox 等比縮放填滿。
                     置於紅圈之後 → 置中「Ryzen」繪於圓環之上，紅圈僅於文字上下露出弧線。 -->
                <Viewbox x:Name="TextBox" Stretch="Uniform" Margin="15" Visibility="Collapsed">
                    <TextBlock x:Name="EmblemText" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Viewbox>
                <!-- 左上角橫書縮小字：Xeon 系列的「Xeon」 -->
                <TextBlock x:Name="SideText" Visibility="Collapsed" IsHitTestVisible="False"
                           FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.7" Color="#000000"/></TextBlock.Effect>
                </TextBlock>
                <!-- 左下角小標：8086K 的「8086」 -->
                <TextBlock x:Name="LowerLeftText" Visibility="Collapsed" IsHitTestVisible="False"
                           FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.7" Color="#000000"/></TextBlock.Effect>
                </TextBlock>
                <!-- 右下角小標：TR / P / Titan / CEO / Tesla -->
                <TextBlock x:Name="CornerText" Visibility="Collapsed" IsHitTestVisible="False"
                           FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.7" Color="#000000"/></TextBlock.Effect>
                </TextBlock>
                <!-- 右上角小標：Xeon W/E、8086K 的「40ᵀᴴ」 -->
                <TextBlock x:Name="TopMarkText" Visibility="Collapsed" IsHitTestVisible="False"
                           FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.7" Color="#000000"/></TextBlock.Effect>
                </TextBlock>
                <!-- 右上角級別斜面：Xeon Scalable 銅/銀/金/白金（切去右上角的三角斜面） -->
                <Polygon x:Name="TopColorBevel" Visibility="Collapsed" IsHitTestVisible="False"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Stroke="#55000000" StrokeThickness="0.6"/>
            </Grid>
        </Border>

        <StackPanel x:Name="TextPanel" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryInkBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ModelText" FontSize="12" Margin="0,1,0,0"
                       Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" MaxWidth="360"/>
            <!-- 特殊版本徽記（至尊版 / 週年限定版…），僅特殊型號顯示 -->
            <Border x:Name="TierChip" Margin="0,4,0,0" HorizontalAlignment="Left"
                    CornerRadius="4" Padding="6,1" Visibility="Collapsed">
                <TextBlock x:Name="TierText" FontSize="10.5" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
