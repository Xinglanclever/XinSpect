<UserControl x:Class="XinSpect.HistoryGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="GraphRoot" MinHeight="64">
    <Border CornerRadius="8" Background="{StaticResource PagePlaneBrush}"
            BorderThickness="1" BorderBrush="{StaticResource HairlineBrush}" ClipToBounds="True">
        <Grid>
            <Canvas x:Name="GridLines" IsHitTestVisible="False"/>
            <Canvas x:Name="Plot" IsHitTestVisible="False"/>
            <Grid Margin="9,6,9,0" VerticalAlignment="Top">
                <TextBlock x:Name="CaptionText" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryInkBrush}" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ValueText" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryInkBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
