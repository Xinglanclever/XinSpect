<UserControl x:Class="XinSpect.Oscilloscope"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="96">
    <!-- 儀器面板刻意保持近黑：磷光管的觀感靠「暗底 + 亮跡」，跟著淺色主題變白反而看不出波形。
         底色、描邊、分格線、讀值文字都由 code-behind 從 TraceBrush 推導，換通道色時整組一起換。 -->
    <Border x:Name="Plate" CornerRadius="8" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Canvas x:Name="GridLines" IsHitTestVisible="False"/>
            <Canvas x:Name="Plot" IsHitTestVisible="False"/>
            <Grid Margin="9,6,9,0" VerticalAlignment="Top">
                <TextBlock x:Name="CaptionText" FontSize="11.5" FontWeight="SemiBold"
                           Opacity="0.8" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ValueText" FontSize="12.5" FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
