<UserControl x:Class="XinSpect.TimelineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" ClipToBounds="True" Focusable="True">
    <Grid>
        <!-- 底層：格線與座標標籤；中層：曲線與事件標記；上層：十字準線與讀值 -->
        <Canvas x:Name="Grid_" IsHitTestVisible="False"/>
        <Canvas x:Name="Plot" IsHitTestVisible="False"/>
        <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
