<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <!-- 磁碟效能測試以未緩衝 I/O 搭配磁區對齊的原生緩衝區（指標），需允許 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- app.manifest 的 DPI 設定供 WPF 主體使用；抑制 WinForms 對此的 WFO0003 提醒 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Product metadata -->
    <AssemblyName>XinSpect</AssemblyName>
    <Product>曦覽 XinSpect</Product>
    <AssemblyTitle>曦覽 XinSpect 硬體資訊總覽</AssemblyTitle>
    <Company>Xinglanclever</Company>
    <Version>2.51</Version>
    <!-- FileVersion 只吃數字，表達不了「-B1」；第四段就是拿來標這種同版號的後續建置的 -->
    <FileVersion>2.30.0.0</FileVersion>
    <!-- 內嵌 PDB：發佈維持單一執行檔，CrashLog 記錄的堆疊仍帶行號（portable PDB 預設會另產生 XinSpect.pdb） -->
    <DebugType>embedded</DebugType>
    <Copyright>By：Xinglanclever ・ Claude Opus 5 ・ 2026年9月8日</Copyright>
    <UseAppHost>true</UseAppHost>
    <!-- 發佈輸出只留執行檔：參考組件的 IntelliSense 文件（WebView2 *.xml）不隨 publish 落地 -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <!-- 應用程式圖示（原創「曦覽」曉光儀表標記；由 make_icon.ps1 產生的多尺寸 .ico）-->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <!-- ETW 消費（幀時間／DPC 延遲）：純 managed，零驅動、零注入 -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <PackageReference Include="NAudio" Version="2.*" />
    <!-- WinRing0 的來源：LHM 0.9.6 起已移除 Ring0／WinRing0（0.9.4 的 Ring0 內嵌了 gzip 過的 WinRing0x64）。
         單檔發佈的使用者端沒有 NuGet 快取，所以 0.9.4 必須跟著執行檔走（見檔尾的 EmbedLhm094）。
         PackageDownload 只下載、不加入編譯參考，因此不會與上面 0.9.6 的參考版本衝突。 -->
    <PackageDownload Include="LibreHardwareMonitorLib" Version="[0.9.4]" />
  </ItemGroup>

  <!-- 特殊型號的官方 logo 圖檔（選配）：放入 Assets\{cpu|gpu|disk|board}\{id}.png 即自動採用。
       以 WPF Resource 編入組件，單檔發佈亦可；缺檔時徽章自動退回原創向量圖，不影響建置。
       四個子資料夾要與 DeviceIcons.AssetFolder 一致（DeviceIconsTableTests 會比對，少一個就紅）。 -->
  <ItemGroup>
    <Resource Include="Assets\cpu\*.png" />
    <Resource Include="Assets\gpu\*.png" />
    <Resource Include="Assets\disk\*.png" />
    <Resource Include="Assets\board\*.png" />
    <!-- 視窗圖示（標題列／工作列）；以 Resource 編入，單檔發佈亦可用 pack URI 讀取 -->
    <Resource Include="Assets\ShrineGuaiGuai.jpg" />
    <Resource Include="Assets\app.ico" />
    <!-- 啟程儀式音樂：不嵌入 Resource，因為播完要刪除（一次即焚） -->
    <Content Include="Assets\ceremony.mp3" CopyToOutputDirectory="PreserveNewest" />
    <!-- 關於頁「By：Xinglanclever」旁的動畫 GIF；以 Resource 編入，pack URI 讀取後逐格輪播 -->
    <Resource Include="Assets\hug.gif" />
    <!-- 關於頁 DeepSeek 旁的大肥魚動圖 -->
    <Resource Include="Assets\bigfish.gif" />
  </ItemGroup>

  <!-- WinForms 僅供系統匣（TrayService）使用；移除其全域 using 以免與 WPF 的 System.Windows.* 型別衝突 -->
  <!-- System.IO 同理：新 SDK 的隱含 using 會讓 WPF 的 Shapes.Path 撞上 IO.Path（HistoryGraph 等）；
       全庫慣例本就是明確寫 using System.IO，這裡移除隱含版以維持原語義 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.IO" />
  </ItemGroup>

  <!-- ── 超頻橋接程式（net48）：不納入本體檔案集 ─────────────────────────────────
       Bridge\ 內是承載 Intel XTU SDK 的獨立 net48 專案，使用 net10 沒有的 API
       （System.Web.Script.Serialization、舊版 WCF），其原始碼與 obj 產生的 .cs 若被
       本體的預設 glob 收入，會直接破壞 net10 編譯。故一律自各預設項目類型排除。 -->
  <ItemGroup>
    <Compile Remove="Bridge\**\*.cs" />
    <EmbeddedResource Remove="Bridge\**" />
    <Content Remove="Bridge\**" />
    <None Remove="Bridge\**" />
    <Page Remove="Bridge\**" />
    <Resource Remove="Bridge\**" />
  </ItemGroup>

  <!-- ── 藍色中隊守護進程（BlueSquadronBridge）：不納入本體檔案集 ─────────────────
       BlueSquadron\ 內是獨立的 .NET 10 console app（安全守護進程），使用 WinForms
       （系統匣 NotifyIcon）等本體不引用的 API，其原始碼若被本體收入會造成命名空間衝突。 -->
  <ItemGroup>
    <Compile Remove="BlueSquadron\**\*.cs" />
    <Compile Remove="Installer\**\*.cs" />
    <EmbeddedResource Remove="BlueSquadron\**" />
    <Content Remove="BlueSquadron\**" />
    <None Remove="BlueSquadron\**" />
    <Page Remove="BlueSquadron\**" />
    <Resource Remove="BlueSquadron\**" />
  </ItemGroup>

  <!-- ── XsRegProbe 驅動與驗證器：不納入本體檔案集 ─────────────────────────────
       XsRegProbe\ 內是核心驅動 C 源碼與引用本體的驗證器 console 專案；其 Program.cs
       若被本體的預設 glob 收入會造成重複編譯與型別衝突，故一律自各預設項目類型排除。 -->
  <ItemGroup>
    <Compile Remove="XsRegProbe\**\*.cs" />
    <EmbeddedResource Remove="XsRegProbe\**" />
    <Content Remove="XsRegProbe\**" />
    <None Remove="XsRegProbe\**" />
    <Page Remove="XsRegProbe\**" />
    <Resource Remove="XsRegProbe\**" />
  </ItemGroup>

  <!-- ── 純解碼器程式庫（V7 WP44）：獨立 net10.0 類別庫，供 Stryker mutation testing；
       命名空間維持 XinSpect，本體以 ProjectReference 引用。本體的預設 glob 不收其原始碼。 -->
  <ItemGroup>
    <Compile Remove="XinSpect.Decoders\**\*.cs" />
    <EmbeddedResource Remove="XinSpect.Decoders\**" />
    <Content Remove="XinSpect.Decoders\**" />
    <None Remove="XinSpect.Decoders\**" />
    <Page Remove="XinSpect.Decoders\**" />
    <Resource Remove="XinSpect.Decoders\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="XinSpect.Decoders\XinSpect.Decoders.csproj" />
  </ItemGroup>

  <!-- ── 單元測試專案：不納入本體檔案集 ───────────────────────────────────────
       Tests\ 內是獨立的 xunit 專案（ProjectReference 回指本體）。其 .cs 若被本體的
       預設 glob 收入會造成重複定義與循環相依，故一律自各預設項目類型排除。 -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <EmbeddedResource Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <Resource Remove="Tests\**" />
  </ItemGroup>

  <!-- ── 建置並內嵌 XtuBridge.exe（把工具內建進 App）──────────────────────────────
       本體不編譯 Bridge 原始碼；改在建置時以巢狀 MSBuild 用其自身的 net48 執行階段建置，
       再把產出的 XtuBridge.exe 以邏輯名 XinSpect.bridge.XtuBridge.exe 內嵌為資源。
       執行時 BridgeBootstrap 依此邏輯名取出資源、解壓到 %LOCALAPPDATA%\XinSpect\bridge\，
       以獨立程序啟動之。單檔發佈時資源隨 XinSpect.dll 一同打包，使用者無須另裝任何檔案。
       Restore 與 Build 分兩次呼叫（避免同次呼叫沿用過期評估）；巢狀 MSBuild 僅傳入 Configuration，
       使 Bridge 以自身預設平台（AnyCPU/PlatformTarget=x64）建置，不受本體 win-x64 影響。 -->
  <!-- 藍色中隊內嵌（正式發佈）：把 BlueSquadronBridge 發佈成單檔並內嵌為資源，
       BlueSquadronBootstrap 於執行期解壓（SHA256 驗證＋ACL 鎖定）。Debug 測試不內嵌以保建置速度。 -->
  <Target Name="BuildAndEmbedBlueSquadronBridge" BeforeTargets="PrepareForBuild;BeforeCompile"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <BsProj>$(MSBuildProjectDirectory)\BlueSquadron\BlueSquadronBridge.csproj</BsProj>
      <BsPayloadDir>$(MSBuildProjectDirectory)\BlueSquadron\bin\BridgePayload</BsPayloadDir>
      <BsExe>$(BsPayloadDir)\BlueSquadronBridge.exe</BsExe>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(BsProj)&quot; -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o &quot;$(BsPayloadDir)&quot;" />
    <Error Condition="!Exists('$(BsExe)')" Text="藍色中隊橋接程式發佈後仍找不到產出：$(BsExe)" />
    <ItemGroup>
      <EmbeddedResource Include="$(BsExe)">
        <LogicalName>XinSpect.bridge.BlueSquadronBridge.exe</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="BuildAndEmbedXtuBridge" BeforeTargets="PrepareForBuild;BeforeCompile">
    <PropertyGroup>
      <XtuBridgeProj>$(MSBuildProjectDirectory)\Bridge\XtuBridge.csproj</XtuBridgeProj>
      <XtuBridgeExe>$(MSBuildProjectDirectory)\Bridge\bin\$(Configuration)\net48\XtuBridge.exe</XtuBridgeExe>
    </PropertyGroup>
    <MSBuild Projects="$(XtuBridgeProj)" Targets="Restore" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(XtuBridgeProj)" Targets="Build" Properties="Configuration=$(Configuration)" />
    <Error Condition="!Exists('$(XtuBridgeExe)')" Text="超頻橋接程式建置後仍找不到產出：$(XtuBridgeExe)" />
    <ItemGroup>
      <EmbeddedResource Include="$(XtuBridgeExe)">
        <LogicalName>XinSpect.bridge.XtuBridge.exe</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
      <!-- 一併內嵌其組態檔（指定 .NET 4.8 執行階段），與已驗證可用的執行環境完全一致 -->
      <EmbeddedResource Include="$(XtuBridgeExe).config" Condition="Exists('$(XtuBridgeExe).config')">
        <LogicalName>XinSpect.bridge.XtuBridge.exe.config</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>


  <!-- WinRing0 來源內嵌：LHM 0.9.4 的 Ring0 以內嵌資源帶著 gzip 過的 WinRing0x64.sys，所以把整個
       0.9.4 組件帶上就等於把驅動帶上。先前執行期只讀 NuGet 快取（其中一條路徑還寫死成某個使用者
       名稱），單檔發佈版在使用者端等於找不到驅動——MSR／PCI 設定空間／I/O 埠／MMIO 全數變成讀不到，
       而驅動就緒卡卻宣稱來源是「內嵌的 0.9.4」。內嵌進來源跟著執行檔走；磁碟快取只留作開發機退路。 -->
  <Target Name="EmbedLhm094" BeforeTargets="PrepareForBuild;BeforeCompile">
    <PropertyGroup>
      <Lhm094Dll>$(NuGetPackageRoot)librehardwaremonitorlib/0.9.4/lib/netstandard2.0/LibreHardwareMonitorLib.dll</Lhm094Dll>
    </PropertyGroup>
    <Error Condition="!Exists(&apos;$(Lhm094Dll)&apos;)" Text="找不到 LibreHardwareMonitorLib 0.9.4（WinRing0 來源）：$(Lhm094Dll)" />
    <ItemGroup>
      <EmbeddedResource Include="$(Lhm094Dll)">
        <LogicalName>XinSpect.embedded.LibreHardwareMonitorLib-0.9.4.dll</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
