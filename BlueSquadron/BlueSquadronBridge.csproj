<Project Sdk="Microsoft.NET.Sdk">

  <!-- ⚠ 未編譯——需作者機驗證（dotnet build 命令見 patch-23.md） -->
  <!-- 完整替換檔：BlueSquadron/BlueSquadronBridge.csproj（patch-23，P0-13 配套） -->

  <!-- BlueSquadronBridge：藍色中隊核心安全守護進程。 -->
  <!-- 以獨立 .NET 10 console app 執行，透過 stdin/stdout JSON IPC 與 XinSpect 本體通訊。 -->
  <!-- 可獨立運行（系統匣模式），也可由 XinSpect 以子進程啟動。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>  <!-- 系統匣 NotifyIcon 需要 WinForms -->
    <AssemblyName>BlueSquadronBridge</AssemblyName>
    <RootNamespace>BlueSquadron</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 〔修復 v3.21〕審計 §3.3-2：BaselineStore 的 DPAPI（ProtectedData）在 .NET 上是獨立套件——
         顯式宣告，不依賴傳遞解析的巧合。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.4" />
    <PackageReference Include="System.Management" Version="9.0.4" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Common\IommuProbe.cs" Link="Linked\IommuProbe.cs" />
    <!-- P0-13（patch-23）：以源碼 Link 引入微軟建議驅動封鎖清單解碼器（純解碼、零依賴、
         無 P/Invoke——ByovdBlocklist.cs 只用 System.Xml.Linq 與 LINQ）。
         不用 ProjectReference：Bridge 以單一 exe 發佈（BlueSquadronBootstrap SHA-256 驗證
         解壓＋ACL 鎖定），多一個 XinSpect.Decoders.dll 就多一份要內嵌、要驗雜湊、要 ACL
         的部署面，而這裡只需要解碼器這一個檔。比照 WmiSecurityReader.cs 先例
         （把需要的最小源碼面併進 Bridge 編譯集）與 patch-08 的 IommuProbe Compile Link
         同編兩專案做法。同一實體檔、主專案與 Decoders 庫各自編譯自己的副本，無衝突。 -->
    <Compile Include="..\XinSpect.Decoders\ByovdBlocklist.cs" Link="Linked\ByovdBlocklist.cs" />
  </ItemGroup>

</Project>
