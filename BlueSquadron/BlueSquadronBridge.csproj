<Project Sdk="Microsoft.NET.Sdk">

  <!-- BlueSquadronBridge：藍色中隊核心安全守護進程。 -->
  <!-- 以獨立 .NET 10 console app 執行，透過 stdin/stdout JSON IPC 與 XinSpect 本體通訊。 -->
  <!-- 可獨立運行（系統匣模式），也可由 XinSpect 以子進程啟動。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>  <!-- 系統匣 NotifyIcon 需要 WinForms -->
    <AssemblyName>BlueSquadronBridge</AssemblyName>
    <RootNamespace>BlueSquadron</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.4" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.4" />
  </ItemGroup>

</Project>
