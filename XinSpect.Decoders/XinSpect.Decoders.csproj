<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── 純解碼器程式庫（V7 WP44／A54）：無 WPF、無 P/Invoke、無服務依賴。
       獨立成庫的目的是解鎖 Stryker mutation testing——主專案的巢狀 net48 Bridge
       自訂 Target 會讓 Buildalyzer 建置分析失敗（2026-10-03 實測）。
       命名空間維持 XinSpect（與本體同），呼叫端零改動；成員一律 public（跨組件）。 -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>XinSpect</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 知識包資料檔（第 281 輪）：PCI 廠商／裝置 ID 對照。以 EmbeddedResource 隨組件分發，
         不依賴外部檔案、不出網。資料來源與授權見 Data/README.md 與 THIRD-PARTY-NOTICES.md。 -->
    <EmbeddedResource Include="Data\pci-ids.tsv.gz" LogicalName="XinSpect.Decoders.Data.pci-ids.tsv.gz" />
  </ItemGroup>

</Project>
